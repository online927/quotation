<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.MySettingsView"
             x:DataType="vm:MySettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,12,24,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel>
        <ctl:PageTitle Text="My Settings" Icon="mysettings" />
        <TextBlock Classes="muted" Text="{Binding UserName, StringFormat='Only for you ({0}) — every user can change these.'}" />
      </StackPanel>
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />

      <!-- Round 35: a Delivery box next to Description on the quotation screen -->
      <Border Classes="card" Name="DeliveryTimeCard">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Delivery time on items (this PC)" />
          <ToggleSwitch Name="DeliveryTimeSwitch" IsChecked="{Binding DeliveryTimeOnItems}"
                        OnContent="On: a Delivery box next to Description (Ex-stock, 2–3 weeks …), printed under the item" OffContent="Off" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Without GST (next quotation only)" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="For a company that does not take GST (e.g. SEZ)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="For a company that does not take GST (e.g. SEZ): the next quotation or proforma invoice you make shows 0 % on every item, 'Packing &amp; Forwarding - Without GST' and no SGST/CGST/IGST lines. The switch turns itself off as soon as that document is saved; the document keeps it."><Path Classes="infoicon" /></Border></StackPanel>
          <ToggleSwitch Name="WithoutGstSwitch" IsChecked="{Binding WithoutGstNext}" OnContent="On — next quotation without GST" OffContent="Off" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="PDF layout and file name" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="The look of the PDFs you make: Tally (like the TallyPrime print) or Zoho (company logo, modern design)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="The look of the PDFs you make: Tally (like the TallyPrime print) or Zoho (company logo, modern design). Used for Approve, Save as PDF, Open PDF and Preview. Saved with your login, so it follows you to every PC."><Path Classes="infoicon" /></Border></StackPanel>
          <ComboBox Name="PdfLayoutBox" ItemsSource="{Binding PdfLayoutChoices}" SelectedItem="{Binding PdfLayout}" Width="200" />
          <TextBlock Classes="label" Text="PDF file name" Margin="0,8,0,0" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="The order in the names of your PDF files (Approve, Save as PDF, Open PDF, WhatsApp)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="The order in the names of your PDF files (Approve, Save as PDF, Open PDF, WhatsApp). Saved with your login; files already saved keep their names."><Path Classes="infoicon" /></Border></StackPanel>
          <ComboBox Name="PdfFileOrderBox" ItemsSource="{Binding PdfFileOrderChoices}" SelectedIndex="{Binding PdfFileOrderIndex}" Width="420" />
          <TextBlock Classes="fl" Text="After Save as PDF" Margin="0,6,0,0" />
          <ToggleSwitch Name="OpenPdfAfterSaveSwitch" IsChecked="{Binding OpenPdfAfterSave}"
                        OnContent="Open the PDF (to look at it, print it or e-mail it)" OffContent="Only save it in my PDF folder" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Appearance" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Just for you, and saved with your login, so it follows you to every PC." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Just for you, and saved with your login, so it follows you to every PC. The moon/sun button at the top goes on to the next theme. PDFs are always printed white."><Path Classes="infoicon" /></Border></StackPanel>
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="label" Text="Theme" />
            <ComboBox Grid.Column="1" Name="ThemeBox" ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding ThemeIndex}" Width="200" />
            <TextBlock Grid.Row="1" Classes="label" Text="Text size" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="TextSizeBox" ItemsSource="{Binding TextSizeChoices}" SelectedIndex="{Binding TextSizeIndex}" Width="200" />
            <TextBlock Grid.Row="2" Classes="label" Text="Spacing" />
            <ComboBox Grid.Row="2" Grid.Column="1" Name="SpacingBox" ItemsSource="{Binding SpacingChoices}" SelectedIndex="{Binding SpacingIndex}" Width="200"
                      ToolTip.Tip="Compact fits more on a small laptop screen" />
            <TextBlock Grid.Row="3" Classes="label" Text="Animations" />
            <ToggleSwitch Grid.Row="3" Grid.Column="1" Name="ReduceMotionSwitch" IsChecked="{Binding AnimationsOn}"
                          OnContent="On" OffContent="Off (no animations, no glow)"
                          ToolTip.Tip="For a slow PC, or if you prefer a calm screen: no animations and no glow shadows" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" Name="BackgroundPictureCard">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Background picture (this PC)" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="A picture of your own behind the pages, on this PC only (it is not sent to the server or to other PCs)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="A picture of your own behind the pages, on this PC only (it is not sent to the server or to other PCs). Use a picture you have the right to use."><Path Classes="infoicon" /></Border></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button ctl:ButtonIcon.Kind="image" Name="ChooseBackgroundButton" Content="Choose picture…" Click="OnChooseBackground" />
            <Button ctl:ButtonIcon.Kind="trash" Name="RemoveBackgroundButton" Content="Remove" Command="{Binding RemoveBackgroundPictureCommand}" IsVisible="{Binding HasBackgroundPicture}" />
            <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding BackgroundPictureText}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Save as PDF folders (this PC)" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="&#x27;Save as PDF&#x27; saves the document here without asking (named as chosen above)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="'Save as PDF' saves the document here without asking (named as chosen above). Leave a box empty for the standard folder."><Path Classes="infoicon" /></Border></StackPanel>
          <TextBlock Classes="fl" Text="Quotations" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding PdfFolder}" Watermark="{Binding DefaultPdfFolder}" />
            <Button ctl:ButtonIcon.Kind="folder" Grid.Column="2" Name="BrowseButton" Content="Browse…" Click="OnBrowse" />
          </Grid>
          <TextBlock Classes="fl" Text="Proforma invoices" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding ProformaPdfFolder}" Watermark="{Binding DefaultProformaPdfFolder}" />
            <Button ctl:ButtonIcon.Kind="folder" Grid.Column="2" Name="BrowseProformaButton" Content="Browse…" Click="OnBrowseProforma" />
          </Grid>
          <Button ctl:ButtonIcon.Kind="save" Classes="primary" Content="Save" Command="{Binding SavePdfFolderCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card" Name="WhatsAppCard">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="WhatsApp (this PC)" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Where the WhatsApp button opens the customer's chat." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="WhatsApp app: the WhatsApp program installed on this PC. WhatsApp Web: web.whatsapp.com in your browser (log in once with the QR code on your phone). Either way the PDF is copied: in the chat press Ctrl+V, then Enter."><Path Classes="infoicon" /></Border></StackPanel>
          <Border Classes="pillbar" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton Name="WhatsAppAppRadio" Classes="seg" GroupName="WhatsAppOpensIn" Content="WhatsApp app" IsChecked="{Binding WhatsAppOnApp}" />
              <RadioButton Name="WhatsAppWebRadio" Classes="seg" GroupName="WhatsAppOpensIn" Content="WhatsApp Web" IsChecked="{Binding WhatsAppOnWeb}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card" Name="TextSelectionCard">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Selected text (this PC)" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="How text looks when you select it in a box." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Soft blue, Blue sketch and Yellow highlighter change the letters so they stay easy to read. Theme colour only tints the background in the theme's own colour: the letters keep their own colour."><Path Classes="infoicon" /></Border></StackPanel>
          <Border Classes="pillbar" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton Name="SelectionSoftBlueRadio" Classes="seg" GroupName="TextSelection" Content="Soft blue" IsChecked="{Binding SelectionSoftBlue}" />
              <RadioButton Name="SelectionSolidBlueRadio" Classes="seg" GroupName="TextSelection" Content="Blue sketch" IsChecked="{Binding SelectionSolidBlue}" />
              <RadioButton Name="SelectionMarkerRadio" Classes="seg" GroupName="TextSelection" Content="Yellow highlighter" IsChecked="{Binding SelectionMarker}" />
              <RadioButton Name="SelectionThemeColourRadio" Classes="seg" GroupName="TextSelection" Content="Theme colour" IsChecked="{Binding SelectionThemeColour}" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="label" Text="Looks like" VerticalAlignment="Center" />
            <Border Name="SelectionSample" Background="{Binding SelectionSampleBack}" CornerRadius="3" Padding="3,1" VerticalAlignment="Center">
              <TextBlock Text="Your enquiry dated 02-Nov-2026" Foreground="{Binding SelectionSampleLetters}" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Name="SilentCard">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Silent" />
          <ToggleSwitch Name="SilentSwitch" IsChecked="{Binding Silent}" OnContent="On" OffContent="Off" />
        </StackPanel>
      </Border>

      <Border Classes="card" Name="SharpTextCard">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Sharp text (this PC)" />
          <ToggleSwitch Name="SharpTextSwitch" IsChecked="{Binding SharpText}"
                        OnContent="On: sharper letters and slightly bigger small text" OffContent="Off: the old look" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Connection and version (this PC)" />
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="The Quotation Server this PC uses." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="The Quotation Server this PC uses. To change it, log out and type the address in the server box on the sign-in screen."><Path Classes="infoicon" /></Border></StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="label" Text="Server" />
            <SelectableTextBlock Grid.Column="1" Name="ServerAddressText" Text="{Binding ServerAddress}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Classes="label" Text="Computer" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ComputerName}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Classes="label" Text="Financial year" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FinancialYear}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Classes="label" Text="App version" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static vm:ShellViewModel.AppVersionText}" FontWeight="SemiBold" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
