<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:views="using:Quotation.Mobile.Views"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.QuotationDetailView"
             x:DataType="vm:QuotationDetailViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pagehead" Padding="12,12,18,8">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Name="BackButton" Classes="round" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).BackCommand}">
        <Path Classes="icon" Data="{x:Static m:PhoneIcons.Back}" />
      </Button>
      <StackPanel Grid.Column="1" Margin="10,0">
        <TextBlock Name="NumberText" Classes="h1" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" />
      </StackPanel>
      <Border Grid.Column="2" Name="StatusChip" Classes="chip" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"
              VerticalAlignment="Top" Margin="0,6,0,0">
        <TextBlock Text="{Binding StatusText}" />
      </Border>
    </Grid>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" Margin="18,0" />
    <ScrollViewer>
      <StackPanel Margin="16,6,16,20" Spacing="12">
        <TextBlock Name="DetailError" Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Name="DetailInfo" Classes="info" Text="{Binding InfoMessage}" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="eyebrow" Text="CUSTOMER" />
              <TextBlock Name="CustomerText" FontWeight="Bold" FontSize="15" Text="{Binding CustomerName}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding CustomerLine}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="round" VerticalAlignment="Center" Command="{Binding CallCustomerCommand}" IsVisible="{Binding HasCustomerPhone}">
              <Path Classes="icon" Data="{x:Static m:PhoneIcons.Phone}" Stroke="{DynamicResource AccentBrush}" />
            </Button>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="eyebrow" Text="{Binding ItemsTitle}" Margin="0,0,0,6" />
            <ItemsControl Name="LineList" ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineRow">
                  <Grid ColumnDefinitions="22,*,Auto" Margin="0,5">
                    <TextBlock Classes="muted" Text="{Binding No}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="SemiBold" Margin="10,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="sep" />
            <ItemsControl ItemsSource="{Binding Totals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TotalRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Text="Total" FontWeight="Bold" FontSize="17" />
              <TextBlock Grid.Column="1" Name="GrandTotalText" Text="{Binding GrandTotal}" FontWeight="Bold" FontSize="17" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" Text="{Binding AmountInWords}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Round 41 (Z8 phone): internal notes (only inside the app; never printed or shared) -->
        <Border Name="NotesCard" Classes="card" IsVisible="{Binding NotesOn}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="{Binding NotesTitle}" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="11" Text="🔒 Only inside the app" />
            </Grid>
            <TextBlock Classes="muted" FontSize="13" Text="No notes yet." IsVisible="{Binding HasNoNotes}" />
            <ItemsControl Name="NoteList" ItemsSource="{Binding Notes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteRow">
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Who}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,8,Auto,8,Auto">
              <TextBox Name="NoteBox" Text="{Binding NewNoteText}" Watermark="Write a note…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" />
              <Button Grid.Column="2" Name="NoteMicButton" Classes="round" Command="{Binding SpeakNoteCommand}" VerticalAlignment="Bottom"
                      Classes.on="{Binding IsListeningNote}">
                <Path Classes="icon" Data="{x:Static m:PhoneIcons.Mic}" Stroke="{DynamicResource AccentBrush}" />
              </Button>
              <Button Grid.Column="4" Name="AddNoteButton" Classes="primary" Content="Add" Command="{Binding AddNoteCommand}" VerticalAlignment="Bottom"
                      IsEnabled="{Binding !IsBusy}" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" Text="Listening…" IsVisible="{Binding IsListeningNote}" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,10,*">
          <Button Name="PreviewButton" HorizontalAlignment="Stretch" Command="{Binding PreviewCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{x:Static m:PhoneIcons.File}" />
              <TextBlock Text="Preview" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Name="WhatsAppButton" Classes="whatsapp" HorizontalAlignment="Stretch" Command="{Binding WhatsAppCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{x:Static m:PhoneIcons.Chat}" />
              <TextBlock Text="WhatsApp" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <Button Name="ShareButton" HorizontalAlignment="Stretch" Command="{Binding ShareCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{x:Static m:PhoneIcons.Share}" />
            <TextBlock Text="Share (Gmail, Drive …)" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="ApproveButton" Classes="primary" HorizontalAlignment="Stretch" Command="{Binding ApproveCommand}" IsVisible="{Binding CanApprove}"
                IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{x:Static m:PhoneIcons.Check}" />
            <TextBlock Text="Approve" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
