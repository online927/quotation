<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pagehead" Padding="18,14,18,8">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="h1" Text="Customers" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="round" Command="{Binding MoreCommand}"><TextBlock Text="{Binding Initial}" FontWeight="Bold" /></Button>
    </Grid>
    </Border>
    <TextBox DockPanel.Dock="Top" Name="SearchBox" Text="{Binding Search}" Watermark="Name, GSTIN, city, phone…" Margin="16,0,16,8">
      <TextBox.InnerLeftContent>
        <Path Classes="icon" Data="{x:Static m:PhoneIcons.Search}" Stroke="{DynamicResource MutedBrush}" Margin="14,0,0,0" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" Margin="18,0" />
    <Panel>
      <ScrollViewer>
        <StackPanel Margin="16,4,16,20" Spacing="10">
          <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ItemsControl Name="CustomerList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:CustomerSummaryDto">
                <Button Classes="cardbtn" Command="{Binding $parent[ItemsControl].((vm:CustomersViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="12">
                      <Run Text="{Binding StateName, Mode=OneWay}" />
                      <Run Text="  " />
                      <Run Text="{Binding Gstin, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding NothingTyped}">
        <Path Data="{x:Static m:PhoneIcons.Users}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeLineCap="Round" Width="40" Height="40"
              Stretch="Uniform" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Type to find a customer" HorizontalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="muted" Text="Nothing found" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
    </Panel>
  </DockPanel>
</UserControl>
