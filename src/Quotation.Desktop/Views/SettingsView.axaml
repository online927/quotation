<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,12,4" />
    </Style>
    <Style Selector="Grid.form > TextBox, Grid.form > NumericUpDown, Grid.form > ComboBox, Grid.form > CheckBox">
      <Setter Property="Margin" Value="0,3" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="24,12,24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Classes="h1" Text="Settings" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Reload" Command="{Binding LoadCommand}" />
        <Button Classes="primary" Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" HotKey="Ctrl+S" IsEnabled="{Binding IsAdmin}" />
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="muted" Text="Only administrators can change settings." IsVisible="{Binding IsReadOnly}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Foreground="{StaticResource OkBrush}" Text="{Binding InfoMessage}" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <TabControl IsEnabled="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TabItem Header="Company">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="200,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Company name" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.Company.CompanyName}" />
            <TextBlock Grid.Row="1" Text="Address (one line per row)" VerticalAlignment="Top" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AddressLines}" AcceptsReturn="True" Height="70" />
            <TextBlock Grid.Row="2" Text="Mobile" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Company.Mobile}" />
            <TextBlock Grid.Row="3" Text="Phone" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Company.Phone}" />
            <TextBlock Grid.Row="4" Text="GSTIN/UIN" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Company.Gstin}" />
            <TextBlock Grid.Row="5" Text="State name / code" />
            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,8,90">
              <TextBox Text="{Binding Settings.Company.StateName}" />
              <TextBox Grid.Column="2" Text="{Binding Settings.Company.StateCode}" />
            </Grid>
            <TextBlock Grid.Row="6" Text="E-mail" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.Company.Email}" />
            <TextBlock Grid.Row="7" Text="Company's PAN" />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.Company.Pan}" />
            <TextBlock Grid.Row="8" Text="MSME number" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.Company.MsmeNumber}" />
            <TextBlock Grid.Row="9" Text="IEC" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.Company.Iec}" />
            <TextBlock Grid.Row="10" Text="Bank: account holder" />
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.Company.BankAccountHolder}" />
            <TextBlock Grid.Row="11" Text="Bank name" />
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Settings.Company.BankName}" />
            <TextBlock Grid.Row="12" Text="Account number" />
            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Settings.Company.BankAccountNumber}" />
            <TextBlock Grid.Row="13" Text="Branch &amp; IFSC" />
            <Grid Grid.Row="13" Grid.Column="1" ColumnDefinitions="*,8,160">
              <TextBox Text="{Binding Settings.Company.BankBranch}" Watermark="Branch" />
              <TextBox Grid.Column="2" Text="{Binding Settings.Company.BankIfsc}" Watermark="IFSC" />
            </Grid>
            <TextBlock Grid.Row="14" Text="Logo file (on server)" />
            <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Settings.Company.LogoPath}" Watermark="C:\ProgramData\TSQuotation\logo.png (optional)" />
            <TextBlock Grid.Row="15" Text="Authorised signatory label" />
            <TextBox Grid.Row="15" Grid.Column="1" Text="{Binding Settings.Company.AuthorisedSignatoryLabel}" />
            <TextBlock Grid.Row="16" Text="Default prepared by" />
            <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding Settings.Company.DefaultPreparedBy}" />
            <TextBlock Grid.Row="17" Text="Default verified by" />
            <TextBox Grid.Row="17" Grid.Column="1" Text="{Binding Settings.Company.DefaultVerifiedBy}" />
            <TextBlock Grid.Row="18" Text="Quotation validity (days)" />
            <NumericUpDown Grid.Row="18" Grid.Column="1" Value="{Binding Settings.Company.QuotationValidityDays}" Minimum="0" Maximum="365" FormatString="0" Width="140" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="19" Text="Validity text" />
            <TextBox Grid.Row="19" Grid.Column="1" Text="{Binding Settings.Company.ValidityText}" />
            <TextBlock Grid.Row="20" Text="Declaration" VerticalAlignment="Top" />
            <TextBox Grid.Row="20" Grid.Column="1" Text="{Binding Settings.Company.Declaration}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
            <TextBlock Grid.Row="21" Text="Terms &amp; conditions (one per line)" VerticalAlignment="Top" />
            <TextBox Grid.Row="21" Grid.Column="1" Text="{Binding Terms}" AcceptsReturn="True" Height="90" />
            <TextBlock Grid.Row="22" Text="Default payment terms" />
            <TextBox Grid.Row="22" Grid.Column="1" Text="{Binding Settings.Company.DefaultPaymentTerms}" />
            <TextBlock Grid.Row="23" Text="Footer text" />
            <TextBox Grid.Row="23" Grid.Column="1" Text="{Binding Settings.Company.FooterText}" />
            <TextBlock Grid.Row="24" Text="Jurisdiction" />
            <TextBox Grid.Row="24" Grid.Column="1" Text="{Binding Settings.Company.Jurisdiction}" Watermark="SUBJECT TO BANGALORE JURISDICTION" />
            <TextBlock Grid.Row="25" Text="Proforma declaration" VerticalAlignment="Top" />
            <TextBox Grid.Row="25" Grid.Column="1" Text="{Binding Settings.Company.ProformaDeclaration}" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
            <TextBlock Grid.Row="26" Text="Proforma footer text" />
            <TextBox Grid.Row="26" Grid.Column="1" Text="{Binding Settings.Company.ProformaFooterText}" />
            <Border Grid.Row="27" Grid.ColumnSpan="2" Classes="card" Margin="0,12,0,0" IsVisible="{Binding IsAdmin}">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Company seal" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="The seal image is printed over 'for T.SAIFUDDIN &amp; CO. / Authorised Signatory' when someone ticks 'Seal' next to Save as PDF and enters the seal PIN. A PNG with a transparent background looks best." />
                <Grid ColumnDefinitions="Auto,16,*">
                  <Border Width="180" Height="110" CornerRadius="10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Background="White">
                    <Panel>
                      <Image Source="{Binding SealImage}" Stretch="Uniform" Margin="6" />
                      <TextBlock Text="No seal image" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSealImage}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="UploadSealButton" Content="Choose image…" Click="OnChooseSeal" />
                      <Button Content="Remove" Command="{Binding RemoveSealCommand}" IsVisible="{Binding HasSealImage}" />
                      <Button Content="Preview on a page" Command="{Binding PreviewSealCommand}" IsVisible="{Binding HasSealImage}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="label" Text="Width (pt)" />
                      <NumericUpDown Value="{Binding SealWidth}" Minimum="30" Maximum="280" Increment="10" FormatString="0" Width="110" />
                      <TextBlock Classes="label" Text="Move right" Margin="8,0,0,0" />
                      <NumericUpDown Value="{Binding SealOffsetX}" Minimum="-200" Maximum="200" Increment="5" FormatString="0" Width="110" />
                      <TextBlock Classes="label" Text="Move down" Margin="8,0,0,0" />
                      <NumericUpDown Value="{Binding SealOffsetY}" Minimum="-200" Maximum="200" Increment="5" FormatString="0" Width="110" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="label" Text="New seal PIN (4 digits)" />
                      <TextBox Text="{Binding NewSealPin}" PasswordChar="●" MaxLength="4" Width="90" Watermark="••••" />
                      <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding SealPinState}" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Size, position and PIN take effect when you press Save (top right)." />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Quotation">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Quotation number pattern" />
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding Settings.Quotation.NumberPattern}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="Preview" Command="{Binding RefreshExampleCommand}" />
            </Grid>
            <TextBlock Grid.Row="1" Text="Example" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExampleNumber}" FontWeight="SemiBold" Foreground="Black" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap"
                       Text="Tokens: {FY}=2526, {FY_LABEL}=2025-26, {FYS2}/{FYE2}=25/26, {FYS4}/{FYE4}=2025/2026, {SEQ} or {SEQ:4} (zero-padded)." />
            <TextBlock Grid.Row="3" Text="First number of a new financial year" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.Quotation.DefaultStartSequence}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="4" Text="Financial year start month" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Settings.Quotation.FinancialYearStartMonth}" Minimum="1" Maximum="12" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="5" Text="GST presentation" />
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding TaxPresentations}" SelectedItem="{Binding Settings.Quotation.TaxPresentation}" Width="200" />
            <TextBlock Grid.Row="6" Text="Round off total to rupee" />
            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Settings.Quotation.RoundOffTotal}" />
            <TextBlock Grid.Row="7" Text="Default packing &amp; forwarding (₹)" />
            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Settings.Quotation.DefaultPackingForwardingAmount}" Minimum="0" FormatString="0.00" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="8" Text="…or default P&amp;F % of subtotal" />
            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding Settings.Quotation.DefaultPackingForwardingPercent}" Minimum="0" Maximum="100" FormatString="0.00" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="9" Text="Refresh rates when duplicating" />
            <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding Settings.Quotation.RefreshRatesOnDuplicate}" />
            <TextBlock Grid.Row="10" Text="Allow generation with stale Tally data" />
            <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding Settings.Quotation.AllowStaleDataOverride}" />
            <TextBlock Grid.Row="11" Text="Tally data stale after (hours)" />
            <NumericUpDown Grid.Row="11" Grid.Column="1" Value="{Binding Settings.Quotation.StaleDataHours}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="12" Text="Require HSN/SAC on every line" />
            <CheckBox Grid.Row="12" Grid.Column="1" IsChecked="{Binding Settings.Quotation.RequireHsn}" />
            <TextBlock Grid.Row="16" Text="Users can edit for (days)" />
            <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding Settings.Quotation.UserEditDays}" Minimum="0" Maximum="365" FormatString="0" Width="120" />
              <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="after a quotation is first saved; administrators can always edit." />
            </StackPanel>
            <TextBlock Grid.Row="17" Text="Title Case while typing" />
            <CheckBox Grid.Row="17" Grid.Column="1" IsChecked="{Binding Settings.Quotation.TitleCase}"
                      Content="Capital first letter of each word in the quotation's text boxes (like Tally)" />
            <TextBlock Grid.Row="18" Text="Company seal" />
            <CheckBox Grid.Row="18" Grid.Column="1" IsChecked="{Binding Settings.Quotation.AllUsersCanSeal}"
                      Content="All users can use the seal (with the seal PIN); otherwise administrators only" />
            <TextBlock Grid.Row="13" Text="Proforma invoice number pattern" />
            <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Settings.Quotation.ProformaNumberPattern}" Watermark="TSPI{FY}-{SEQ}" />
            <TextBlock Grid.Row="14" Text="First proforma number of a new year" />
            <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding Settings.Quotation.ProformaDefaultStartSequence}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <Border Grid.Row="15" Grid.ColumnSpan="2" Classes="card" Margin="0,12,0,0" IsVisible="{Binding IsAdmin}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="Next quotation number (active financial year)" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="To continue your existing Tally quotation series, enter the number after the last Tally quotation (e.g. last was TSQ2526-3247 → enter 3248). Numbers already used cannot be issued again." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Text="{Binding Series.FinancialYear, StringFormat='FY {0}:', FallbackValue=''}" />
                  <NumericUpDown Value="{Binding NewNextSequence}" Minimum="1" FormatString="0" Width="140" />
                  <Button Content="Set next number" Command="{Binding SetNextNumberCommand}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Series.NextNumberPreview, StringFormat='Next: {0}', FallbackValue=''}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Classes="h2" Text="Next proforma invoice number" Margin="0,10,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Proforma invoices have their own series. To continue from Tally, enter the number after the last proforma (e.g. last was TSPI2526-12 → enter 13)." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Text="{Binding ProformaSeries.FinancialYear, StringFormat='FY {0}:', FallbackValue=''}" />
                  <NumericUpDown Value="{Binding NewNextProformaSequence}" Minimum="1" FormatString="0" Width="140" />
                  <Button Content="Set next number" Command="{Binding SetNextProformaNumberCommand}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding ProformaSeries.NextNumberPreview, StringFormat='Next: {0}', FallbackValue=''}" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tally">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="TallyPrime XML/HTTP address" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.Tally.Url}" Watermark="http://192.168.1.10:9000" />
            <TextBlock Grid.Row="1" Text="Company name (blank = loaded company)" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Tally.CompanyName}" />
            <TextBlock Grid.Row="2" Text="Customer ledger groups (one per line)" VerticalAlignment="Top" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerGroups}" AcceptsReturn="True" Height="60" />
            <TextBlock Grid.Row="3" Text="Selling rate source" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding RateSources}" SelectedItem="{Binding Settings.Tally.RateSource}" Width="200" />
            <TextBlock Grid.Row="4" Text="Price level (if rate source = PriceLevel)" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Tally.PriceLevel}" />
            <TextBlock Grid.Row="5" Text="Incremental sync every (minutes)" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Settings.Tally.IncrementalSyncMinutes}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="6" Text="Nightly full sync time (HH:mm)" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.Tally.NightlyFullSyncTime}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="7" Text="Request timeout (seconds)" />
            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Settings.Tally.TimeoutSeconds}" Minimum="5" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="8" Text="Connection check every (seconds)" />
            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding Settings.Tally.ConnectionCheckSeconds}" Minimum="10" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="9" Text="Active FY override (start year, blank = detect)" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding FyOverride}" Width="160" HorizontalAlignment="Left" Watermark="e.g. 2025" />
            <TextBlock Grid.Row="10" Text="No selling price in Tally: use last rate" VerticalAlignment="Top" />
            <StackPanel Grid.Row="10" Grid.Column="1">
              <CheckBox IsChecked="{Binding Settings.Tally.UseLastRate}" Content="Fill the rate the item was last quoted/sold at (any customer)" />
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="Read from Tally's Sales and Quotation vouchers (read-only) and from quotations approved in this app. Takes effect at the next sync." />
            </StackPanel>
            <TextBlock Grid.Row="11" Text="Voucher types for last rate (one per line)" VerticalAlignment="Top" />
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding LastRateVoucherTypes}" AcceptsReturn="True" Height="60"
                     Watermark="Blank = all Sales and Quotation types (e.g. Sales, TS Quotation)" />
            <TextBlock Grid.Row="12" Text="Look back for last rate (months)" />
            <NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding Settings.Tally.LastRateMonths}" Minimum="1" Maximum="120" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="13" Text="'Do not use' marks in item description" VerticalAlignment="Top" />
            <StackPanel Grid.Row="13" Grid.Column="1">
              <TextBox Text="{Binding HiddenMarkers}" AcceptsReturn="True" Height="50" Watermark="DNU" />
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="One per line. Items whose Tally description is this word (or starts with it, e.g. 'DNU - use 187-901') are not offered when making quotations." />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Claude AI">
        <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Enable AI assistant" />
          <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.Ai.Enabled}" />
          <TextBlock Grid.Row="1" Text="Model" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Ai.Model}" />
          <TextBlock Grid.Row="2" Text="API key" />
          <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
            <TextBox Text="{Binding NewApiKey}" PasswordChar="●" Watermark="Enter a new key to replace the stored one" />
            <TextBlock FontSize="11" Text="A key is stored (encrypted on the server)." IsVisible="{Binding Settings.Ai.ApiKeyConfigured, FallbackValue=False}" Foreground="{StaticResource OkBrush}" />
          </StackPanel>
          <TextBlock Grid.Row="3" Text="Max product candidates sent to AI" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.Ai.MaxCandidates}" Minimum="3" Maximum="25" FormatString="0" Width="160" HorizontalAlignment="Left" />
        </Grid>
      </TabItem>

      <TabItem Header="Gmail">
        <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Enable Gmail ingestion" />
          <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.Gmail.Enabled}" />
          <TextBlock Grid.Row="1" Text="Gmail search query" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Gmail.Query}" />
          <TextBlock Grid.Row="2" Text="Poll every (minutes)" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Settings.Gmail.PollMinutes}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="3" Text="OAuth client JSON (Desktop app)" VerticalAlignment="Top" />
          <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
            <TextBox Text="{Binding NewGmailClientJson}" AcceptsReturn="True" Height="70" Watermark="Paste client_secret_….json contents to replace the stored one" />
            <TextBlock FontSize="11" Text="OAuth client is stored (encrypted on the server)." IsVisible="{Binding Settings.Gmail.ClientSecretConfigured, FallbackValue=False}" Foreground="{StaticResource OkBrush}" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="Connected account" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Gmail.ConnectedAccount, FallbackValue='Not connected', TargetNullValue='Not connected'}" />
        </Grid>
      </TabItem>

      <TabItem Header="Users" IsVisible="{Binding IsAdmin}">
        <StackPanel Margin="4,8" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding Users}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:UserDto">
                <Grid ColumnDefinitions="160,220,80,90,*" Margin="0,2">
                  <TextBlock Text="{Binding Username}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Role}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding IsActive, StringFormat='Active: {0}'}" VerticalAlignment="Center" />
                  <Button Grid.Column="4" HorizontalAlignment="Left" Content="Edit"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).EditUserCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card" IsVisible="{Binding IsEditingUser}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="{Binding EditingUser.Username, StringFormat='Edit user {0}', FallbackValue=''}" />
              <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="label" Text="Login name (printed as 'By:' on PDFs)" Margin="0,4,12,4" />
                <TextBox Grid.Column="1" Text="{Binding EditUsername}" />
                <TextBlock Grid.Row="1" Classes="label" Text="Display name (Prepared by)" Margin="0,4,12,4" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditDisplayName}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,4">
                  <CheckBox Content="Administrator" IsChecked="{Binding EditIsAdmin}" />
                  <CheckBox Content="Active (can log in)" IsChecked="{Binding EditIsActive}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="Old quotations and the history keep the name used at the time. You cannot remove your own administrator role or deactivate yourself, and one active administrator must remain." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Save user" Command="{Binding SaveUserCommand}" />
                <Button Content="Close" Command="{Binding CancelEditUserCommand}" />
              </StackPanel>
              <TextBlock Classes="h2" Text="Reset password" Margin="0,8,0,0" />
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                         Text="Give the user a temporary password: they must choose a new one at their next login, and any PC still logged in as them is logged out." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="220" Text="{Binding ResetPassword}" PasswordChar="●" Watermark="Temporary password (min. 6)" />
                <Button Content="Reset password" Command="{Binding ResetUserPasswordCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="h2" Text="Add user" />
          <Grid ColumnDefinitions="160,8,220,8,160,8,Auto,8,Auto">
            <TextBox Text="{Binding NewUsername}" Watermark="Username" />
            <TextBox Grid.Column="2" Text="{Binding NewDisplayName}" Watermark="Display name" />
            <TextBox Grid.Column="4" Text="{Binding NewUserPassword}" PasswordChar="●" Watermark="Initial password" />
            <CheckBox Grid.Column="6" Content="Admin" IsChecked="{Binding NewUserIsAdmin}" />
            <Button Grid.Column="8" Content="Add user" Command="{Binding AddUserCommand}" />
          </Grid>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
