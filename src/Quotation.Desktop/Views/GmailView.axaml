<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.GmailView"
             x:DataType="vm:GmailViewModel">
  <DockPanel Margin="24,12,24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ctl:PageTitle Text="Gmail Connection" Icon="gmail" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button HotKey="F5" Command="{Binding LoadCommand}" ToolTip.Tip="Refresh (F5)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M20,11 A8,8 0 1 0 17.7,16.6 M20,4 L20,11 L13,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <Button ctl:ButtonIcon.Kind="mailcheck" Content="Check now" Command="{Binding PollCommand}" />
        <Button ctl:ButtonIcon.Kind="sparkle" Classes="primary" Content="Open AI Inbox" Command="{Binding OpenInboxCommand}" />
      </StackPanel>
    </Grid>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock FontWeight="Bold" FontSize="15" Text="Gmail" VerticalAlignment="Center" />
          <Border Name="GmailChip" Classes="chip" Classes.ok="{Binding IsConnected}" Classes.bad="{Binding !IsConnected}">
            <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding ConnectionText}" /></StackPanel>
          </Border>
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding Status.Query, StringFormat='Monitored Gmail search: {0}', FallbackValue=''}" />
        <TextBlock FontSize="12" Text="{Binding LastPollText, StringFormat='Last checked: {0}'}" />
        <TextBlock FontSize="12" Text="{Binding CountsText}" />
        <TextBlock Classes="error" Text="{Binding Status.LastError, FallbackValue=''}" IsVisible="{Binding Status.LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
        <TextBlock Foreground="{DynamicResource AccentBrush}" Text="{Binding InfoMessage}" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
        <ctl:ErrorBanner Text="{Binding ErrorMessage}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding IsAdmin}">
          <Button ctl:ButtonIcon.Kind="link" Classes="primary" Content="Connect Gmail (Google sign-in)" Command="{Binding ConnectCommand}" />
          <Button ctl:ButtonIcon.Kind="unlink" Content="Disconnect" Command="{Binding DisconnectCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock FontSize="12" Text="Google sign-in: Gmail read-only, Google Drive only for the backup copies; your password is never seen." VerticalAlignment="Center" />
          <Border Classes="info" ToolTip.Tip="Sign-in happens on Google's page; this application never sees your Gmail password. Gmail is read-only; Google Drive is used only for the files the app puts there (Google Drive backup, Settings → Backup &amp; updates). Connected before the Google Drive backup? Connect again once so Google asks to allow Google Drive. The token is stored encrypted on the Quotation Server. Enable polling and set the search query in Settings → Gmail.">
            <Path Classes="infoicon" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Classes="tablehead">
      <Grid ColumnDefinitions="130,220,*,110,*">
        <TextBlock FontWeight="SemiBold" Text="Received" />
        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="From" />
        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Subject" />
        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Status" />
        <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Result" />
      </Grid>
    </Border>
    <Panel>
    <ListBox Classes="table" ItemsSource="{Binding Messages}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EmailRow">
          <Grid ColumnDefinitions="130,220,*,110,*">
            <TextBlock Text="{Binding Received}" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding From}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Subject}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="{Binding Result}" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <!-- Nothing yet: a message instead of a big empty box -->
    <StackPanel Name="GmailEmpty" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Messages.Count}">
      <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
        <Path Data="M3,5 L21,5 L21,19 L3,19 Z M3.5,6.5 L12,13 L20.5,6.5" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
              StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="No e-mails yet" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
    </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
