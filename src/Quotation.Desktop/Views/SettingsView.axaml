<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TabControl.sidetabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="0,4,18,0" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem">
      <Setter Property="MinWidth" Value="190" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Round 39 (RD-5) / Round 40 (RD-5b): a coloured symbol beside each section name; names in the normal text colour -->
    <Style Selector="TabControl.sidetabs > TabItem">
      <Setter Property="HeaderTemplate">
        <DataTemplate x:DataType="x:String">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:StrokeIcon Kind="{Binding Converter={x:Static ctl:SettingsTabIcon.Instance}}" Width="16" Height="16"
                            Foreground="{Binding Converter={x:Static ctl:SettingsTabColor.Instance}}" />
            <TextBlock Classes="tabname" Text="{Binding}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem TextBlock.tabname">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem:selected TextBlock.tabname">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="0 1 6 0 #22000000" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
    </Style>
    <Style Selector="TabControl.sidetabs > TabItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <!-- Users page: small coloured tags (Administrator / Standard, Active / Inactive, seal state) -->
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.tag.role"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
    <Style Selector="Border.tag.role TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
    <Style Selector="Border.tag.status TextBlock"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}" /></Style>
    <Style Selector="Border.tag.status.off TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="Border.tag.seal"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" /></Style>
    <Style Selector="Border.tag.seal TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></Style>
    <Style Selector="ListBox.people ListBoxItem"><Setter Property="Padding" Value="8,6" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="TextBlock.sealstate"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}" /></Style>
    <Style Selector="TextBlock.notready">
      <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    </Style>
    <!-- Round 39: more room between Settings rows (boxes no longer touch the row below) -->
    <Style Selector="Grid.form > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,8,12,8" />
    </Style>
    <Style Selector="Grid.form > TextBox, Grid.form > NumericUpDown, Grid.form > ComboBox, Grid.form > ToggleSwitch, Grid.form > StackPanel, Grid.form > Grid">
      <Setter Property="Margin" Value="0,8" />
    </Style>
  </UserControl.Styles>
  <Panel>
  <DockPanel Margin="24,12,24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ctl:PageTitle Text="Settings" Icon="settings" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button ctl:ButtonIcon.Kind="save" Classes="primary" Content="Save (Ctrl+S)" Command="{Binding SaveCommand}" HotKey="Ctrl+S" IsEnabled="{Binding IsAdmin}" />
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="muted" Text="Only administrators can change settings." IsVisible="{Binding IsReadOnly}" />
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />
    </StackPanel>

    <!-- Sections as a list on the left (U9) -->
    <TabControl Classes="sidetabs" TabStripPlacement="Left" IsEnabled="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TabItem Header="Company">
        <ScrollViewer>
          <!-- Company settings in small cards: labels above the boxes, two or three boxes side by side, nothing cut off -->
          <StackPanel Spacing="12" Margin="4,8" MaxWidth="920" HorizontalAlignment="Left">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Company" />
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Company name" /><TextBox Text="{Binding Settings.Company.CompanyName}" /></StackPanel>
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Address (one line per row)" /><TextBox Text="{Binding AddressLines}" AcceptsReturn="True" Height="70" /></StackPanel>
                <Grid ColumnDefinitions="*,12,*,12,90"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="GSTIN/UIN" /><TextBox Text="{Binding Settings.Company.Gstin}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="State name" /><TextBox Text="{Binding Settings.Company.StateName}" /></StackPanel><StackPanel Classes="fld" Grid.Column="4"><TextBlock Classes="flabel" Text="State code" /><TextBox Text="{Binding Settings.Company.StateCode}" /></StackPanel></Grid>
                <Grid ColumnDefinitions="*,12,*,12,*"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Company's PAN" /><TextBox Text="{Binding Settings.Company.Pan}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="MSME number" /><TextBox Text="{Binding Settings.Company.MsmeNumber}" /></StackPanel><StackPanel Classes="fld" Grid.Column="4"><TextBlock Classes="flabel" Text="IEC" /><TextBox Text="{Binding Settings.Company.Iec}" /></StackPanel></Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Contact" />
                <Grid ColumnDefinitions="*,12,*,12,*"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Mobile" /><TextBox Text="{Binding Settings.Company.Mobile}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="Phone" /><TextBox Text="{Binding Settings.Company.Phone}" /></StackPanel><StackPanel Classes="fld" Grid.Column="4"><TextBlock Classes="flabel" Text="E-mail" /><TextBox Text="{Binding Settings.Company.Email}" /></StackPanel></Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Bank" />
                <Grid ColumnDefinitions="*,12,*"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Account holder" /><TextBox Text="{Binding Settings.Company.BankAccountHolder}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="Bank name" /><TextBox Text="{Binding Settings.Company.BankName}" /></StackPanel></Grid>
                <Grid ColumnDefinitions="*,12,*,12,160"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Account number" /><TextBox Text="{Binding Settings.Company.BankAccountNumber}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="Branch" /><TextBox Text="{Binding Settings.Company.BankBranch}" /></StackPanel><StackPanel Classes="fld" Grid.Column="4"><TextBlock Classes="flabel" Text="IFSC" /><TextBox Text="{Binding Settings.Company.BankIfsc}" /></StackPanel></Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Printing" />
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Logo file (on server)" /><TextBox Text="{Binding Settings.Company.LogoPath}" Watermark="C:\ProgramData\TSQuotation\logo.png (optional)" /></StackPanel>
                <Grid ColumnDefinitions="*,12,*,12,*"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Authorised signatory label" /><TextBox Text="{Binding Settings.Company.AuthorisedSignatoryLabel}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="Default prepared by" /><TextBox Text="{Binding Settings.Company.DefaultPreparedBy}" /></StackPanel><StackPanel Classes="fld" Grid.Column="4"><TextBlock Classes="flabel" Text="Default verified by" /><TextBox Text="{Binding Settings.Company.DefaultVerifiedBy}" /></StackPanel></Grid>
                <Grid ColumnDefinitions="170,12,*"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Quotation validity (days)" /><NumericUpDown Value="{Binding Settings.Company.QuotationValidityDays}" Minimum="0" Maximum="365" FormatString="0" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="Validity text" /><TextBox Text="{Binding Settings.Company.ValidityText}" /></StackPanel></Grid>
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Declaration" /><TextBox Text="{Binding Settings.Company.Declaration}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" /></StackPanel>
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Terms &amp; conditions (one per line)" /><TextBox Text="{Binding Terms}" AcceptsReturn="True" Height="90" /></StackPanel>
                <Grid ColumnDefinitions="*,12,*,12,*"><StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Default payment terms" /><TextBox Text="{Binding Settings.Company.DefaultPaymentTerms}" /></StackPanel><StackPanel Classes="fld" Grid.Column="2"><TextBlock Classes="flabel" Text="Footer text" /><TextBox Text="{Binding Settings.Company.FooterText}" /></StackPanel><StackPanel Classes="fld" Grid.Column="4"><TextBlock Classes="flabel" Text="Jurisdiction" /><TextBox Text="{Binding Settings.Company.Jurisdiction}" Watermark="SUBJECT TO BANGALORE JURISDICTION" /></StackPanel></Grid>
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Proforma declaration" /><TextBox Text="{Binding Settings.Company.ProformaDeclaration}" AcceptsReturn="True" TextWrapping="Wrap" Height="44" /></StackPanel>
                <StackPanel Classes="fld"><TextBlock Classes="flabel" Text="Proforma footer text" /><TextBox Text="{Binding Settings.Company.ProformaFooterText}" /></StackPanel>
              </StackPanel>
            </Border>
            <!-- Pay by UPI QR code on quotations (administrators) -->
            <Border Classes="card" IsVisible="{Binding IsAdmin}">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Pay by UPI QR code (quotations)" />
                <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="A QR code on quotations (not proforma invoices)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="A QR code on quotations (not proforma invoices): in the Tally layout in the right half of 'Terms of Delivery', in the Zoho layout at the bottom right. Only 'Pay by UPI' and the UPI ID are printed. Scanning it opens the customer's UPI app with your UPI ID, company name, the quotation total and the note below filled in."><Path Classes="infoicon" /></Border></StackPanel>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="UPI ID" VerticalAlignment="Center" />
                  <TextBox Name="UpiIdBox" Grid.Column="1" Text="{Binding Settings.Company.UpiId}" Watermark="e.g. yourcompany@okhdfcbank" Width="300" HorizontalAlignment="Left" />
                  <TextBlock Grid.Row="1" Text="QR on quotations" VerticalAlignment="Center" />
                  <ToggleSwitch Name="UpiQrSwitch" Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.Company.UpiQrOnQuotations}"
                                OnContent="On (when a UPI ID is set)" OffContent="Off" />
                  <TextBlock Grid.Row="2" Text="Payment note" VerticalAlignment="Top" Margin="0,5,0,0" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <Border Classes="pillbar">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <RadioButton Name="UpiNoteQuotationRadio" Classes="seg" GroupName="UpiNote" Content="Quotation number" IsChecked="{Binding UpiNoteQuotation}" />
                      <RadioButton Name="UpiNoteOrderRadio" Classes="seg" GroupName="UpiNote" Content="Order number" IsChecked="{Binding UpiNoteOrder}" />
                      <RadioButton Name="UpiNoteBothRadio" Classes="seg" GroupName="UpiNote" Content="Both" IsChecked="{Binding UpiNoteBoth}" />
                    </StackPanel>
                    </Border>
                    <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="e.g. TSQ2627-142 PO/4471." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="e.g. TSQ2627-142 PO/4471. The order number is the quotation's 'Buyer's Ref./Order No.'; when it is empty, the quotation number is used. The customer can still change the note before paying."><Path Classes="infoicon" /></Border></StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Text="Check with your phone" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button ctl:ButtonIcon.Kind="qr" Name="TestQrButton" Classes="primary" Content="Test QR (₹1)" Command="{Binding ShowTestQrCommand}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" Text="Uses what is typed above, before Save." />
                  </StackPanel>
                </Grid>
                <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap"
                           Text="Press Save (top right), then Preview or Open PDF on a quotation to see it." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Quotation">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Quotation number pattern" />
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding Settings.Quotation.NumberPattern}" />
              <Button ctl:ButtonIcon.Kind="eye" Grid.Column="1" Margin="6,0,0,0" Content="Preview" Command="{Binding RefreshExampleCommand}" />
            </Grid>
            <TextBlock Grid.Row="1" Text="Example" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExampleNumber}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap"
                       Text="Tokens: {FY}=2526, {FY_LABEL}=2025-26, {FYS2}/{FYE2}=25/26, {FYS4}/{FYE4}=2025/2026, {SEQ} or {SEQ:4} (zero-padded)." />
            <TextBlock Grid.Row="3" Text="First number of a new financial year" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.Quotation.DefaultStartSequence}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="4" Text="Financial year start month" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Settings.Quotation.FinancialYearStartMonth}" Minimum="1" Maximum="12" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="6" Text="Round off total to rupee" />
            <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding Settings.Quotation.RoundOffTotal}" OnContent="On" OffContent="Off" />
            <TextBlock Grid.Row="10" Text="Allow generation with stale Tally data" />
            <ToggleSwitch Grid.Row="10" Grid.Column="1" IsChecked="{Binding Settings.Quotation.AllowStaleDataOverride}" OnContent="On" OffContent="Off" />
            <TextBlock Grid.Row="11" Text="Tally data stale after (hours)" />
            <NumericUpDown Grid.Row="11" Grid.Column="1" Value="{Binding Settings.Quotation.StaleDataHours}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="12" Text="Require HSN/SAC on every line" />
            <ToggleSwitch Grid.Row="12" Grid.Column="1" IsChecked="{Binding Settings.Quotation.RequireHsn}" OnContent="On" OffContent="Off" />
            <TextBlock Grid.Row="16" Text="Users can edit for (days)" />
            <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding Settings.Quotation.UserEditDays}" Minimum="0" Maximum="365" FormatString="0" Width="120" />
              <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" Text="after a quotation is first saved; administrators can always edit." />
            </StackPanel>
            <TextBlock Grid.Row="13" Text="Proforma invoice number pattern" />
            <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Settings.Quotation.ProformaNumberPattern}" Watermark="TSPI{FY}-{SEQ}" />
            <TextBlock Grid.Row="14" Text="First proforma number of a new year" />
            <NumericUpDown Grid.Row="14" Grid.Column="1" Value="{Binding Settings.Quotation.ProformaDefaultStartSequence}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <Border Grid.Row="15" Grid.ColumnSpan="2" Classes="card" Margin="0,12,0,0" IsVisible="{Binding IsAdmin}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="Next quotation number (active financial year)" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="To continue your existing Tally quotation series, enter the number after the last Tally quotation (e.g. last was TSQ2526-3247 → enter 3248). Numbers already used cannot be issued again." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Text="{Binding Series.FinancialYear, StringFormat='FY {0}:', FallbackValue=''}" />
                  <NumericUpDown Value="{Binding NewNextSequence}" Minimum="1" FormatString="0" Width="140" />
                  <Button ctl:ButtonIcon.Kind="hash" Content="Set next number" Command="{Binding SetNextNumberCommand}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Series.NextNumberPreview, StringFormat='Next: {0}', FallbackValue=''}" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Classes="h2" Text="Next proforma invoice number" Margin="0,10,0,0" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Proforma invoices have their own series. To continue from Tally, enter the number after the last proforma (e.g. last was TSPI2526-12 → enter 13)." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Text="{Binding ProformaSeries.FinancialYear, StringFormat='FY {0}:', FallbackValue=''}" />
                  <NumericUpDown Value="{Binding NewNextProformaSequence}" Minimum="1" FormatString="0" Width="140" />
                  <Button ctl:ButtonIcon.Kind="hash" Content="Set next number" Command="{Binding SetNextProformaNumberCommand}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding ProformaSeries.NextNumberPreview, StringFormat='Next: {0}', FallbackValue=''}" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Round 35: the PDF choices have their own tab -->
      <TabItem Header="PDF">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="PDF layout" VerticalAlignment="Top" Margin="0,8,12,4" />
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,8">
              <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="Default for users who have not chosen one in My Settings" />
              <ComboBox ItemsSource="{Binding PdfLayoutChoices}" SelectedItem="{Binding Settings.Quotation.DefaultPdfLayout}" Width="200" />
              <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="Zoho layout: heading" Margin="0,6,0,0" />
              <TextBox Text="{Binding Settings.Quotation.ModernHeading}" Watermark="Quotation/Proforma" Width="300" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Part No. column" />
            <!-- Round 39: the words first, then each switch -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="28" Margin="0,8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="muted" Text="On quotations" VerticalAlignment="Center" />
                <ToggleSwitch Name="PartNoQuotationsSwitch" IsChecked="{Binding Settings.Quotation.PartNumberOnQuotations}" OnContent="" OffContent="" MinWidth="0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="muted" Text="On proforma invoices" VerticalAlignment="Center" />
                <ToggleSwitch Name="PartNoProformaSwitch" IsChecked="{Binding Settings.Quotation.PartNumberOnProforma}" OnContent="" OffContent="" MinWidth="0" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Heading on quotation PDF" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8">
              <TextBox Text="{Binding Settings.Quotation.QuotationHeading}" Watermark="QUOTATION" Width="300" />
              <Button ctl:ButtonIcon.Kind="eye" Content="Preview PDF" Command="{Binding PreviewPrintCommand}" IsEnabled="{Binding IsAdmin}" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="Heading on proforma invoice PDF" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,8">
              <TextBox Text="{Binding Settings.Quotation.ProformaHeading}" Watermark="PROFORMA INVOICE" Width="300" />
              <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" Text="Printed exactly as typed; empty = the standard heading." />
            </StackPanel>
            <!-- Round 37: the note on a USD quotation's PDF -->
            <TextBlock Grid.Row="5" Text="USD note on the PDF" />
            <ComboBox Grid.Row="5" Grid.Column="1" Name="UsdPdfNoteBox" ItemsSource="{Binding UsdPdfNoteChoices}" SelectedIndex="{Binding UsdPdfNoteIndex}" Width="460" Margin="0,8" />
            <!-- Round 38 (PL-1): product web links from an Excel; a clickable "View product" line on the PDF -->
            <TextBlock Grid.Row="6" Text="Product links" VerticalAlignment="Top" Margin="0,8,0,0" />
            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="6" Margin="0,8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Name="LoadProductLinksButton" ctl:ButtonIcon.Kind="upload" Content="Load product links (Excel)…" Click="OnLoadProductLinks" IsEnabled="{Binding IsAdmin}"
                        ToolTip.Tip="Column A = product code (Part No.), column B = web link. Loading again adds and replaces links. Tally is not changed." />
              </StackPanel>
              <TextBlock Name="ProductLinksResultText" Text="{Binding ProductLinksResult}" TextWrapping="Wrap" MaxWidth="620" Classes="muted"
                         IsVisible="{Binding ProductLinksResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Round 35: the On / Off switches have their own tab -->
      <TabItem Header="Features" IsVisible="{Binding IsAdmin}">
        <ScrollViewer>
          <StackPanel Margin="4,8" MaxWidth="900" HorizontalAlignment="Left">
                <!-- Administrator switches (Round 35: their own tab) -->
                <Border Classes="card" IsVisible="{Binding IsAdmin}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Proforma invoices" />
                    <ToggleSwitch Name="ProformaSwitch" IsChecked="{Binding Settings.Quotation.ProformaEnabled}"
                                  OnContent="On" OffContent="Off" />
                    <TextBlock Classes="h2" Text="Users and others' quotations" Margin="0,8,0,0" />
                    <ToggleSwitch Name="OwnOnlySwitch" IsChecked="{Binding Settings.Quotation.UsersChangeOnlyTheirOwn}"
                                  OnContent="On: users see everyone's quotations but change, approve, cancel, duplicate and print only their own"
                                  OffContent="Off: users can work on each other's quotations" />
                    <TextBlock Classes="h2" Text="Won / Lost / Follow-up" Margin="0,8,0,0" />
                    <ToggleSwitch Name="TrackOutcomesSwitch" IsChecked="{Binding Settings.Quotation.TrackOutcomes}"
                                  OnContent="On: approved quotations get Open / Won / Lost and a follow-up date" OffContent="Off" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.Quotation.TrackOutcomes}">
                      <TextBlock VerticalAlignment="Center" Text="Follow up after (days from approval)" />
                      <NumericUpDown Value="{Binding Settings.Quotation.FollowUpDays}" Minimum="0" Maximum="90" FormatString="0" Width="90" />
                    </StackPanel>
                    <TextBlock Classes="h2" Text="WhatsApp button" Margin="0,8,0,0" />
                    <ToggleSwitch Name="WhatsAppSwitch" IsChecked="{Binding Settings.Quotation.WhatsAppButton}"
                                  OnContent="On" OffContent="Off" />
                    <StackPanel Spacing="4" IsVisible="{Binding Settings.Quotation.WhatsAppButton}">
                      <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Message typed into WhatsApp ({number} = the number, {customer} = the customer)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Message typed into WhatsApp ({number} = the number, {customer} = the customer). WhatsApp Desktop must be installed on the PC."><Path Classes="infoicon" /></Border></StackPanel>
                      <TextBox Text="{Binding Settings.Quotation.WhatsAppMessage}" />
                      <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"><TextBlock Text="Follow-up message (WhatsApp button in the To Follow Up list)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Follow-up message (WhatsApp button in the To Follow Up list, when Won / Lost is on; {date} = the quotation date):"><Path Classes="infoicon" /></Border></StackPanel>
                      <TextBox Name="WhatsAppFollowUpBox" Text="{Binding Settings.Quotation.WhatsAppFollowUpMessage}" />
                    </StackPanel>
                    <TextBlock Classes="h2" Text="Greet" Margin="0,8,0,0" />
                    <ToggleSwitch Name="GreetingsSwitch" IsChecked="{Binding Settings.Quotation.Greetings}" OnContent="On" OffContent="Off" />
                    <TextBlock Classes="h2" Text="Stars" Margin="0,8,0,0" />
                    <ToggleSwitch Name="StarsSwitch" IsChecked="{Binding Settings.Quotation.Stars}"
                                  OnContent="On: everyone can star items and customers; starred ones come first in their searches" OffContent="Off" />
                    <TextBlock Classes="h2" Text="Fest" Margin="0,8,0,0" />
                    <ToggleSwitch Name="FestivalLooksSwitch" IsChecked="{Binding Settings.Quotation.FestivalLooks}" OnContent="On" OffContent="Off" />
                    <TextBlock Classes="h2" Text="XO" Margin="0,8,0,0" />
                    <ToggleSwitch Name="XoGameSwitch" IsChecked="{Binding Settings.Quotation.XoGame}" OnContent="On" OffContent="Off" />
                    <!-- Round 39 (Z8): internal notes on quotations (off at first) -->
                    <TextBlock Classes="h2" Text="Notes" Margin="0,8,0,0" />
                    <ToggleSwitch Name="InternalNotesSwitch" IsChecked="{Binding Settings.Quotation.InternalNotes}" OnContent="On" OffContent="Off" />
                    <TextBlock Classes="h2" Text="Seal PIN" Margin="0,8,0,0" />
                    <ToggleSwitch Name="SealPinSwitch" IsChecked="{Binding Settings.Quotation.SealPin}" OnContent="On" OffContent="Off" />
                    <TextBlock Classes="h2" Text="Copy from Tally invoice" Margin="0,8,0,0" />
                    <ToggleSwitch Name="CopyInvoiceSwitch" IsChecked="{Binding Settings.Quotation.CopyFromTallyInvoice}" OnContent="On" OffContent="Off" />
                    <TextBlock Classes="h2" Text="Evening summary" Margin="0,8,0,0" />
                    <ToggleSwitch Name="EveningSummarySwitch" IsChecked="{Binding Settings.Quotation.EveningSummary}" OnContent="On" OffContent="Off" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.Quotation.EveningSummary}">
                      <TextBlock Text="At" VerticalAlignment="Center" />
                      <TextBox Name="EveningSummaryTimeBox" Text="{Binding Settings.Quotation.EveningSummaryTime}" Watermark="19:00" Width="80" />
                      <TextBlock Text="E-mail to" VerticalAlignment="Center" Margin="10,0,0,0" />
                      <TextBox Name="EveningSummaryEmailBox" Text="{Binding Settings.Quotation.EveningSummaryEmail}" Watermark="owner@example.com" Width="260" />
                      <Border Classes="info" VerticalAlignment="Center" ToolTip.Tip="At this time the administrator's screen shows the day's summary with a WhatsApp button. With an e-mail address it is also e-mailed through the Gmail connection (connect Gmail again once so Google allows sending)."><Path Classes="infoicon" /></Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Backups and client updates (administrators) -->
      <TabItem Header="Backup &amp; updates" IsVisible="{Binding IsAdmin}">
        <ScrollViewer>
          <StackPanel Margin="4,8" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Backups" />
                <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="The database is backed up on the server PC (C:\ProgramData\TSQuotation\backups, kept 30 days)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="The database is backed up on the server PC (C:\ProgramData\TSQuotation\backups, kept 30 days). Set a second folder so a copy is also kept somewhere else: a USB drive (E:\TSQ-Backups), another PC's shared folder (\\PC2\Backups) or a OneDrive / Google Drive folder that syncs to the cloud. The folder is as seen from the server PC."><Path Classes="infoicon" /></Border></StackPanel>
                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Text="Back up every (hours)" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Value="{Binding Settings.Backup.EveryHours}" Minimum="1" Maximum="24" FormatString="0" Width="120" HorizontalAlignment="Left" />
                  <TextBlock Grid.Row="1" Text="Second backup folder" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Name="BackupCopyFolderBox" Text="{Binding Settings.Backup.CopyFolder}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card" Name="DriveCard" IsVisible="{Binding Drive, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Google Drive backup" />
                <StackPanel Classes="help" Orientation="Horizontal" Spacing="6"><TextBlock Text="A copy of every backup and every approved PDF also goes to the office Google Drive." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Uses the Google account of the Gmail connection (connect it again once, so Google asks to allow Google Drive). The copies go to the folder named below in that Google Drive: 'Database backups', and 'Approved PDFs' with a folder per month. New copies go every 15 minutes. A new folder name: new copies go to the new folder, the old folder stays."><Path Classes="infoicon" /></Border></StackPanel>
                <Grid ColumnDefinitions="160,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock Text="Google account" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="chip ok" IsVisible="{Binding DriveConnected}"><TextBlock Text="● Connected" /></Border>
                    <Border Classes="chip bad" IsVisible="{Binding DriveNotConnected}"><TextBlock Text="Not connected" /></Border>
                    <TextBlock Name="DriveAccountText" Text="{Binding DriveAccountText}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="Copy" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="18">
                    <ToggleSwitch Name="DriveBackupsBox" IsChecked="{Binding Settings.Backup.DriveBackups}" OnContent="Database backups" OffContent="Database backups" />
                    <ToggleSwitch Name="DrivePdfsBox" IsChecked="{Binding Settings.Backup.DrivePdfs}" OnContent="Approved PDFs (a folder per month)" OffContent="Approved PDFs (a folder per month)" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="Folder name" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Name="DriveFolderBox" Text="{Binding Settings.Backup.DriveFolder}" Watermark="TS Quotations" MaxWidth="320" HorizontalAlignment="Left" Width="320" />
                  <TextBlock Grid.Row="3" Text="Last copy" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Name="DriveLastCopy" Text="{Binding DriveLastCopyText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Row="3" Grid.Column="2" Name="DriveBackupNowButton" Classes="primary" ctl:ButtonIcon.Kind="upload" Content="Back up now"
                          Command="{Binding DriveBackupNowCommand}" IsEnabled="{Binding DriveConnected}" />
                </Grid>
                <TextBlock Classes="error" Name="DriveErrorText" Text="{Binding DriveError}" IsVisible="{Binding HasDriveError}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Client updates" />
                <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="The server setup brings the matching client." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="The server setup brings the matching client. When a PC opens the app with an older version it offers 'Update now' (downloaded from this server, not the internet)."><Path Classes="infoicon" /></Border></StackPanel>
                <ToggleSwitch Name="ClientsMustUpdateSwitch" IsChecked="{Binding Settings.Backup.ClientsMustUpdate}"
                              OnContent="Clients must update (no 'Later')" OffContent="Clients may update later" />
              </StackPanel>
            </Border>
            <TextBlock FontSize="12" Classes="muted" Text="Export everything / Restore from a backup file: Diagnostics." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Party Details">
        <ScrollViewer>
          <StackPanel Margin="4,8" MaxWidth="900" HorizontalAlignment="Left" Spacing="8">
            <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="How Buyer (Bill to) and Consignee (Ship to) are printed on every PDF, like Tally&#x27;s print …" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="How Buyer (Bill to) and Consignee (Ship to) are printed on every PDF, like Tally's print configuration &#x2018;Party Details&#x2019;. PDFs already made change only when they are regenerated."><Path Classes="infoicon" /></Border></StackPanel>
            <Grid Classes="form" ColumnDefinitions="320,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Show Contact (phone)" />
              <ToggleSwitch Grid.Row="0" Grid.Column="1" Name="ShowContactBox" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowContactDetails}" OnContent="On" OffContent="Off" />
              <TextBlock Grid.Row="1" Text="     Show contact person's name" />
              <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowContactPerson}"
                        IsEnabled="{Binding Settings.Quotation.PartyPrint.ShowContactDetails}" OnContent="On" OffContent="Off" />
              <TextBlock Grid.Row="2" Text="Show E-mail" />
              <ToggleSwitch Grid.Row="2" Grid.Column="1" Name="ShowEmailBox" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowEmail}" OnContent="On" OffContent="Off" />
              <TextBlock Grid.Row="3" Text="Show Name and Address from Party master" />
              <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.NameAndAddressFromMaster}"
                        OnContent="Tally ledger's name and address, not what was typed on the quotation" OffContent="Tally ledger's name and address, not what was typed on the quotation" />
              <TextBlock Grid.Row="4" Text="Show Address in a continuous line" />
              <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.AddressInContinuousLine}" OnContent="One line, separated by commas" OffContent="One line, separated by commas" />
              <TextBlock Grid.Row="5" Text="Display name for Parties" />
              <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding PartyDisplayNames}" SelectedIndex="{Binding PartyDisplayNameIndex}" Width="200" />
              <TextBlock Grid.Row="6" Text="Show Buyer's Tax Registration No. / GSTIN" />
              <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowGstin}" OnContent="On" OffContent="Off" />
              <TextBlock Grid.Row="7" Text="Show PAN / Income Tax No." />
              <ToggleSwitch Grid.Row="7" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowPan}" OnContent="On" OffContent="Off" />
              <TextBlock Grid.Row="8" Text="Show State Name &amp; State Code" />
              <ToggleSwitch Grid.Row="8" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowStateNameAndCode}" OnContent="On" OffContent="Off" />
              <TextBlock Grid.Row="9" Text="Show Consignee details" />
              <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding ConsigneeChoices}" SelectedIndex="{Binding ConsigneeChoiceIndex}" Width="260" />
              <TextBlock Grid.Row="10" Text="Show PIN code" />
              <ToggleSwitch Grid.Row="10" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.ShowPinCode}" OnContent="At the end of the address: Bangalore - 562111" OffContent="At the end of the address: Bangalore - 562111" />
              <TextBlock Grid.Row="11" Text="Address width" />
              <ToggleSwitch Grid.Row="11" Grid.Column="1" IsChecked="{Binding Settings.Quotation.PartyPrint.AddressHalfWidth}"
                        OnContent="Half the width of the box (the address wraps; name, GSTIN, state and contact use the full width)" OffContent="Half the width of the box (the address wraps; name, GSTIN, state and contact use the full width)" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button ctl:ButtonIcon.Kind="eye" Content="Preview PDF" Command="{Binding PreviewPrintCommand}" IsEnabled="{Binding IsAdmin}" />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="Latest quotation with these options (also before Save)" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Tally">
        <ScrollViewer>
          <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="TallyPrime XML/HTTP address" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.Tally.Url}" Watermark="http://192.168.1.10:9000" />
            <TextBlock Grid.Row="1" Text="Company name (blank = loaded company)" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Tally.CompanyName}" />
            <TextBlock Grid.Row="2" Text="Customer ledger groups (one per line)" VerticalAlignment="Top" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomerGroups}" AcceptsReturn="True" Height="60" />
            <TextBlock Grid.Row="3" Text="Selling rate source" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding RateSources}" SelectedItem="{Binding Settings.Tally.RateSource}" Width="200" />
            <TextBlock Grid.Row="4" Text="Price level (if rate source = PriceLevel)" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Tally.PriceLevel}" />
            <TextBlock Grid.Row="5" Text="Incremental sync every (minutes)" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Settings.Tally.IncrementalSyncMinutes}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="6" Text="Nightly full sync time (HH:mm)" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.Tally.NightlyFullSyncTime}" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="7" Text="Request timeout (seconds)" />
            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding Settings.Tally.TimeoutSeconds}" Minimum="5" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="8" Text="Connection check every (seconds)" />
            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding Settings.Tally.ConnectionCheckSeconds}" Minimum="10" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="9" Text="Active FY override (start year, blank = detect)" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding FyOverride}" Width="160" HorizontalAlignment="Left" Watermark="e.g. 2025" />
            <TextBlock Grid.Row="10" Text="No selling price in Tally: use last rate" VerticalAlignment="Top" />
            <StackPanel Grid.Row="10" Grid.Column="1">
              <ToggleSwitch IsChecked="{Binding Settings.Tally.UseLastRate}" OnContent="Fill the rate the item was last quoted at in this app (any customer)" OffContent="Fill the rate the item was last quoted at in this app (any customer)" />
              <ToggleSwitch IsChecked="{Binding Settings.Tally.ReadLastRatesFromTally}" IsEnabled="{Binding Settings.Tally.UseLastRate}"
                        OnContent="Also read last rates from Tally's Sales and Quotation vouchers (heavier syncs)" OffContent="Also read last rates from Tally's Sales and Quotation vouchers (heavier syncs)" />
              <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Off (recommended): only quotations approved in this app are remembered and Tally is not asked for vouchers." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Off (recommended): only quotations approved in this app are remembered and Tally is not asked for vouchers. Takes effect at the next sync."><Path Classes="infoicon" /></Border></StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="11" Text="Voucher types for last rate (one per line)" VerticalAlignment="Top" />
            <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding LastRateVoucherTypes}" AcceptsReturn="True" Height="60"
                     Watermark="Blank = all Sales and Quotation types (e.g. Sales, Quotation)" />
            <TextBlock Grid.Row="12" Text="Look back for last rate (months)" />
            <NumericUpDown Grid.Row="12" Grid.Column="1" Value="{Binding Settings.Tally.LastRateMonths}" Minimum="1" Maximum="120" FormatString="0" Width="160" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="13" Text="'Do not use' marks in item description" VerticalAlignment="Top" />
            <StackPanel Grid.Row="13" Grid.Column="1">
              <TextBox Text="{Binding HiddenMarkers}" AcceptsReturn="True" Height="50" Watermark="DNU" />
              <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="One per line. Items whose Tally description is this word (or starts with it, e.g. &#x27;DNU - use …" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="One per line. Items whose Tally description is this word (or starts with it, e.g. 'DNU - use 187-901') are not offered when making quotations."><Path Classes="infoicon" /></Border></StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Claude AI">
        <ScrollViewer>
        <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Enable AI assistant" />
          <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.Ai.Enabled}" OnContent="On" OffContent="Off" />
          <TextBlock Grid.Row="1" Text="Model" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Ai.Model}" />
          <TextBlock Grid.Row="2" Text="API key" />
          <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
            <TextBox Text="{Binding NewApiKey}" PasswordChar="●" Watermark="Enter a new key to replace the stored one" />
            <TextBlock FontSize="{DynamicResource FontSmall}" Text="A key is stored (encrypted on the server)." IsVisible="{Binding Settings.Ai.ApiKeyConfigured, FallbackValue=False}" Foreground="{DynamicResource OkBrush}" />
          </StackPanel>
          <TextBlock Grid.Row="3" Text="Max product candidates sent to AI" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Settings.Ai.MaxCandidates}" Minimum="3" Maximum="25" FormatString="0" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="4" Text="What we sell" />
          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBox Name="WhatWeSellBox" Text="{Binding Settings.Ai.WhatWeSell}" Watermark="e.g. tools and instruments" Width="360" />
            <Border Classes="info" VerticalAlignment="Center" ToolTip.Tip="Claude reads enquiry photos for the company named in Settings → Company; these words tell it what you sell."><Path Classes="infoicon" /></Border>
          </StackPanel>
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Gmail">
        <ScrollViewer>
        <Grid Classes="form" ColumnDefinitions="260,*" Margin="4,8" MaxWidth="900" HorizontalAlignment="Left" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Text="Enable Gmail ingestion" />
          <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.Gmail.Enabled}" OnContent="On" OffContent="Off" />
          <TextBlock Grid.Row="1" Text="Gmail search query" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Gmail.Query}" />
          <TextBlock Grid.Row="2" Text="Poll every (minutes)" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Settings.Gmail.PollMinutes}" Minimum="1" FormatString="0" Width="160" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="3" Text="OAuth client JSON (Desktop app)" VerticalAlignment="Top" />
          <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
            <TextBox Text="{Binding NewGmailClientJson}" AcceptsReturn="True" Height="70" Watermark="Paste client_secret_….json contents to replace the stored one" />
            <TextBlock FontSize="{DynamicResource FontSmall}" Text="OAuth client is stored (encrypted on the server)." IsVisible="{Binding Settings.Gmail.ClientSecretConfigured, FallbackValue=False}" Foreground="{DynamicResource OkBrush}" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="Connected account" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Settings.Gmail.ConnectedAccount, FallbackValue='Not connected', TargetNullValue='Not connected'}" />
        </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Users" IsVisible="{Binding IsAdmin}">
        <ScrollViewer>
        <!-- Layout B: the people on the left, the chosen person (or a new one) on the right -->
        <Grid ColumnDefinitions="290,16,*" Margin="4,8" MaxWidth="1100" HorizontalAlignment="Stretch">
          <Border Classes="card" Padding="12" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h2" Text="Users" VerticalAlignment="Center" />
                <Button ctl:ButtonIcon.Kind="plus" Grid.Column="1" Name="StartAddUserButton" Classes="primary" Content="Add" Command="{Binding StartAddUserCommand}" />
              </Grid>
              <TextBox Name="UserSearchBox" Text="{Binding UserFilter}" Watermark="Search users" />
              <ListBox Name="UserList" Classes="people" ItemsSource="{Binding FilteredUsers}" SelectedItem="{Binding SelectedUser}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="c:UserDto">
                    <Grid ColumnDefinitions="Auto,10,*,Auto" Margin="0,2">
                      <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="{Binding Converter={x:Static vm:SettingsViewModel.Initials}}" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Username}" Classes="muted" FontSize="{DynamicResource FontSmall}" />
                      </StackPanel>
                      <Panel Grid.Column="3" VerticalAlignment="Center">
                        <Border Classes="tag role" IsVisible="{Binding Converter={x:Static vm:SettingsViewModel.IsAdminUser}}"><TextBlock Text="Administrator" /></Border>
                        <Border Classes="tag off" IsVisible="{Binding Converter={x:Static vm:SettingsViewModel.IsInactive}}"><TextBlock Text="Inactive" /></Border>
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap"
                         Text="One administrator; everyone else is a Standard user who makes quotations." />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="card" Padding="18" VerticalAlignment="Top" MinHeight="300">
            <Panel>
              <TextBlock Classes="muted" Text="Choose a person on the left, or + Add for a new user." IsVisible="{Binding ShowUserHint}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

              <!-- New user -->
              <StackPanel Name="AddUserForm" Spacing="12" IsVisible="{Binding IsAddingUser}">
                <TextBlock Classes="h2" Text="New user" />
                <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" MaxWidth="560">
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="Login name" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="printed as 'By:' on PDFs" /></StackPanel>
                  <TextBox Grid.Column="1" Name="NewUsernameBox" Text="{Binding NewUsername}" Watermark="e.g. ravi"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddUserCommand}" /></TextBox.KeyBindings></TextBox>
                  <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Display name" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="'Prepared by'" /></StackPanel>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewDisplayName}" Watermark="e.g. Ravi Kumar"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddUserCommand}" /></TextBox.KeyBindings></TextBox>
                  <StackPanel Grid.Row="2" VerticalAlignment="Center"><TextBlock Text="First password" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="at least 4 characters" /></StackPanel>
                  <TextBox Grid.Row="2" Grid.Column="1" Name="NewUserPasswordBox" Text="{Binding NewUserPassword}" PasswordChar="●"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddUserCommand}" /></TextBox.KeyBindings></TextBox>
                </Grid>
                <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="New users are Standard users: they make quotations and do not change Settings." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="New users are Standard users: they make quotations and do not change Settings. They choose their own password at their first sign-in."><Path Classes="infoicon" /></Border></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button ctl:ButtonIcon.Kind="userplus" Name="AddUserButton" Classes="primary" Content="Add user" Command="{Binding AddUserCommand}" />
                  <Button ctl:ButtonIcon.Kind="x" Content="Cancel" Command="{Binding CancelEditUserCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- The chosen person -->
              <StackPanel Name="UserDetails" Spacing="12" IsVisible="{Binding IsEditingUser}">
                <Grid ColumnDefinitions="Auto,12,*,Auto">
                  <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding EditingUser, Converter={x:Static vm:SettingsViewModel.Initials}}" FontWeight="Bold" FontSize="16"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding EditingUser.DisplayName, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Classes="tag role"><TextBlock Text="{Binding EditingUser.RoleName, FallbackValue=''}" /></Border>
                      <Border Classes="tag status" Classes.off="{Binding EditingUser, Converter={x:Static vm:SettingsViewModel.IsInactive}}"><TextBlock Text="{Binding EditingUser, Converter={x:Static vm:SettingsViewModel.StatusText}}" /></Border>
                      <Border Classes="tag seal" IsVisible="{Binding EditingUserCanHaveSeal}"><TextBlock Text="{Binding EditingUser, Converter={x:Static vm:SettingsViewModel.SealTag}}" /></Border>
                    </StackPanel>
                  </StackPanel>
                  <Button ctl:ButtonIcon.Kind="save" Grid.Column="3" Name="SaveUserButton" Classes="primary" Content="Save user" Command="{Binding SaveUserCommand}" VerticalAlignment="Center" />
                </Grid>
                <TabControl Name="UserTabs" Classes="usertabs pills">
                  <TabItem Header="Account">
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                      <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" MaxWidth="560">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Login name" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="printed as 'By:' on PDFs" /></StackPanel>
                        <TextBox Grid.Column="1" Name="EditUsernameBox" Text="{Binding EditUsername}"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SaveUserCommand}" /></TextBox.KeyBindings></TextBox>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="Display name" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="'Prepared by'" /></StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="EditDisplayNameBox" Text="{Binding EditDisplayName}"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SaveUserCommand}" /></TextBox.KeyBindings></TextBox>
                        <TextBlock Grid.Row="2" Text="Can sign in" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Row="2" Grid.Column="1" Name="EditActiveSwitch" IsChecked="{Binding EditIsActive}" OnContent="Active" OffContent="Inactive" />
                      </Grid>
                      <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                                 Text="Old quotations and the history keep the name used at the time. The administrator cannot be made inactive." />
                      <Button Name="DeleteUserButton" ctl:ButtonIcon.Kind="trash" Classes="danger" Content="Delete user" HorizontalAlignment="Left"
                              Command="{Binding DeleteUserCommand}" IsVisible="{Binding CanDeleteEditingUser}" />
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Seal" Name="UserSealTab" IsVisible="{Binding EditingUserCanHaveSeal}">
      <StackPanel Name="UserSealSection" Spacing="10" Margin="0,12,0,0">
                      <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="This user&#x27;s own seal: a picture (PNG with a transparent background looks best) and a 4-digit PIN." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="This user's own seal: a picture (PNG with a transparent background looks best) and a 4-digit PIN. With both set, they get the Seal switch next to Save as PDF and seal with their PIN. Five wrong PINs block the seal for 15 minutes."><Path Classes="infoicon" /></Border></StackPanel>
                      <Grid ColumnDefinitions="Auto,16,*">
                        <Border Width="170" Height="104" CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Background="White">
                          <Panel>
                            <Image Source="{Binding UserSealImage}" Stretch="Uniform" Margin="6" />
                            <TextBlock Text="No seal picture" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasUserSealImage}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="8">
                          <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button ctl:ButtonIcon.Kind="image" Name="UploadUserSealButton" Content="Choose picture…" Click="OnChooseUserSeal" />
                          </WrapPanel>
                          <TextBlock Text="New seal PIN (4 digits, saved with Save user)" FontSize="12" />
                          <TextBox Name="UserSealPinBox" Text="{Binding NewUserSealPin}" PasswordChar="●" MaxLength="4" Width="110" HorizontalAlignment="Left" Watermark="••••"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SaveUserCommand}" /></TextBox.KeyBindings></TextBox>
                        </StackPanel>
                      </Grid>
                      <TextBlock Name="UserSealStateLine" FontWeight="SemiBold" FontSize="12" Text="{Binding UserSealState}" TextWrapping="Wrap"
                                 Classes="sealstate" Classes.notready="{Binding !UserSealReady}" />
                      <TextBlock Classes="h2" FontSize="13" Text="Size and place on the PDF (the same for every user's seal)" Margin="0,6,0,0" TextWrapping="Wrap" />
                      <!-- Round 40 (SL-1): the Tally and Zoho layouts each keep their own size and place -->
                      <Border Classes="pillbar" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <RadioButton Name="SealTallyRadio" Classes="seg" GroupName="SealLayout" Content="Tally" IsChecked="{Binding SealForTally}" />
                          <RadioButton Name="SealZohoRadio" Classes="seg" GroupName="SealLayout" Content="Zoho" IsChecked="{Binding SealForZoho}" />
                        </StackPanel>
                      </Border>
                      <WrapPanel ItemSpacing="14" LineSpacing="8">
                        <StackPanel Spacing="3"><TextBlock FontSize="12" Text="Width (pt)" />
                          <NumericUpDown Name="SealWidthBox" Value="{Binding SealWidth}" Minimum="30" Maximum="280" Increment="10" FormatString="0" Width="120" /></StackPanel>
                        <StackPanel Spacing="3"><TextBlock FontSize="12" Text="Move right" />
                          <NumericUpDown Value="{Binding SealOffsetX}" Minimum="-450" Maximum="450" Increment="5" FormatString="0" Width="120" /></StackPanel>
                        <StackPanel Spacing="3"><TextBlock FontSize="12" Text="Move up" />
                          <NumericUpDown Value="{Binding SealMoveUp}" Minimum="-450" Maximum="450" Increment="5" FormatString="0" Width="120" /></StackPanel>
                        <Button ctl:ButtonIcon.Kind="eye" Content="{Binding SealPreviewText}" Command="{Binding PreviewUserSealCommand}" IsVisible="{Binding HasUserSealImage}"
                                VerticalAlignment="Bottom" />
                      </WrapPanel>
                      <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Points (72 = 1 inch); a minus number moves it left / down." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Points (72 = 1 inch); a minus number moves it left / down. 'Preview on a … page' shows these numbers straight away; Save user keeps them."><Path Classes="infoicon" /></Border></StackPanel>
                      <Button ctl:ButtonIcon.Kind="trash" Content="Remove seal" Classes="danger" Command="{Binding RemoveUserSealCommand}" IsVisible="{Binding UserHasAnySeal}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Password" Name="UserPasswordTab">
                    <StackPanel Spacing="10" Margin="0,12,0,0" MaxWidth="640" HorizontalAlignment="Left">
                      <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Give the user a temporary password." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Give the user a temporary password: they must choose a new one at their next sign-in, and any PC still signed in as them is signed out."><Path Classes="infoicon" /></Border></StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="240" Text="{Binding ResetPassword}" PasswordChar="●" Watermark="Temporary password (min. 4)" />
                        <Button ctl:ButtonIcon.Kind="key" Content="Reset password" Command="{Binding ResetUserPasswordCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>

  <!-- Test QR (₹1): scan it with your phone before switching the QR on -->
  <Border Name="TestQrOverlay" Background="#40000000" IsVisible="{Binding IsTestQrOpen}">
    <Border Classes="card" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18"
            Background="{DynamicResource PopupBrush}" BoxShadow="0 18 50 0 #40000000">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Test QR" FontSize="17" FontWeight="SemiBold" />
          <Button Grid.Column="1" Classes="link" Content="✕" FontSize="15" Command="{Binding CloseTestQrCommand}" />
        </Grid>
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}">
          <Run Text="Scan it with your phone's UPI app. It should show the name and amount below. " />
          <Run Text="Don't pay" FontWeight="Bold" Foreground="{DynamicResource BadBrush}" />
          <Run Text=" (or pay ₹1 to be sure the money reaches the right account)." />
        </TextBlock>
        <Grid ColumnDefinitions="Auto,*">
          <Border Background="White" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <Image Name="TestQrImage" Source="{Binding TestQrImage}" Width="190" Height="190" RenderOptions.BitmapInterpolationMode="None" />
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="Paying to" />
            <TextBlock Text="{Binding TestQrPayee}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="UPI ID" />
            <TextBlock Text="{Binding TestQrUpiId}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="Amount" />
            <TextBlock Text="₹ 1.00" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="Note" />
            <TextBlock Text="{x:Static vm:SettingsViewModel.TestQrNote}" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="8" Padding="10,8">
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                     Text="If your phone shows a different name, the UPI ID is wrong: correct it before switching the QR on." />
        </Border>
        <Button ctl:ButtonIcon.Kind="x" Name="TestQrCloseButton" Content="Close" HorizontalAlignment="Right" Command="{Binding CloseTestQrCommand}" />
      </StackPanel>
    </Border>
  </Border>
  </Panel>
</UserControl>
