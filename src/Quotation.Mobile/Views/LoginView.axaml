<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,28,24,24" Spacing="12">
      <!-- Who we are -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Classes="badge"><TextBlock Name="CompanyInitials" Text="{Binding CompanyInitials}" /></Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Quotations" FontWeight="Bold" FontSize="15" />
          <TextBlock Classes="muted" Text="{Binding CompanyName}" IsVisible="{Binding CompanyName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="{Binding Greeting}" FontSize="30" FontWeight="SemiBold" Margin="0,48,0,0" />
      <TextBlock Classes="muted" Text="Sign in to see your quotations" Margin="0,0,0,14" />

      <TextBox Name="UserBox" Text="{Binding Username}" Watermark="Username">
        <TextBox.InnerLeftContent>
          <Path Classes="icon" Data="{x:Static m:PhoneIcons.User}" Stroke="{DynamicResource MutedBrush}" Margin="14,0,0,0" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" Watermark="Password"
               RevealPassword="{Binding #ShowPassword.IsChecked}">
        <TextBox.InnerLeftContent>
          <Path Classes="icon" Data="{x:Static m:PhoneIcons.Lock}" Stroke="{DynamicResource MutedBrush}" Margin="14,0,0,0" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <ToggleButton Name="ShowPassword" Background="Transparent" BorderThickness="0" Padding="6" Focusable="False">
            <Path Data="M2,12 C2,12 5.5,5 12,5 C18.5,5 22,12 22,12 C22,12 18.5,19 12,19 C5.5,19 2,12 2,12 Z M12,9 A3,3 0 1 0 12.01,9 Z"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" />
          </ToggleButton>
        </TextBox.InnerRightContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock Name="LoginError" Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button Name="SignInButton" Classes="primary" HorizontalAlignment="Stretch" Content="Sign in" Margin="0,6,0,0"
              Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />

      <!-- The server: shown the first time (or when it cannot be reached); otherwise one tap on the chip -->
      <StackPanel Name="ServerPanel" Spacing="8" Margin="0,22,0,0" IsVisible="{Binding ShowServer}">
        <TextBlock Classes="h2" Text="Quotation Server" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="The name or address of the office PC with the Quotation Server, e.g. TSSERVER or 192.168.1.20" />
        <TextBox Name="ServerBox" Text="{Binding ServerAddress}" Watermark="TSSERVER or 192.168.1.20">
          <TextBox.InnerLeftContent>
            <Path Classes="icon" Data="{x:Static m:PhoneIcons.Server}" Stroke="{DynamicResource MutedBrush}" Margin="14,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Name="TestServerButton" HorizontalAlignment="Stretch" Command="{Binding TestServerCommand}" IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{x:Static m:PhoneIcons.Wifi}" />
            <TextBlock Text="Test the connection" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Name="ServerStatus" Text="{Binding ServerStatus}" TextWrapping="Wrap"
                   Classes.info="{Binding ServerOk}" Classes.error="{Binding !ServerOk}"
                   IsVisible="{Binding ServerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <Button Name="ServerChip" Classes="link" HorizontalAlignment="Center" Margin="0,26,0,0" Command="{Binding ToggleServerCommand}">
        <Border Classes="chip ok" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Data="{x:Static m:PhoneIcons.Wifi}" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineCap="Round"
                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ServerText}" />
          </StackPanel>
        </Border>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
