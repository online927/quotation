<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             x:Class="Quotation.Desktop.Views.QuotationEditorView"
             x:DataType="vm:QuotationEditorViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding ApproveCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenPdfCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,4,0,1" />
    </Style>
    <Style Selector="TextBlock.th">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.td">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="ShowButtonSpinner" Value="False" />
    </Style>
    <Style Selector="Border.row.editing">
      <Setter Property="Background" Value="{StaticResource EditingRowBrush}" />
    </Style>
    <Style Selector="Border.card TextBlock.h2">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="20,12,20,12">
    <!-- Title bar -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Classes="h1" Text="{Binding Title}" VerticalAlignment="Center" />
      <Border Grid.Column="1" Classes="pill" Classes.ok="{Binding IsFinal}" Classes.pending="{Binding IsPendingReview}" Classes.bad="{Binding IsCancelled}"
              Margin="12,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" />
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Classes="pill" Background="{StaticResource WarnSoftBrush}" IsVisible="{Binding WithoutGst}"
                ToolTip.Tip="0 % GST on all items and on packing &amp; forwarding, no tax lines (My Settings → Without GST)">
          <TextBlock Text="WITHOUT GST" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource WarnBrush}" />
        </Border>
        <TextBlock Text="{Binding Source, StringFormat='Source: {0}'}" Classes="muted" VerticalAlignment="Center" FontSize="11" />
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock Classes="fl" Text="{Binding NumberLabel}" VerticalAlignment="Center" Margin="0" />
        <TextBlock Text="{Binding NumberText}" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
        <TextBlock Classes="fl" Text="Dated" VerticalAlignment="Center" Margin="0" />
        <CalendarDatePicker Name="DateBox" SelectedDate="{Binding Date}" CustomDateFormatString="dd-MMM-yyyy" SelectedDateFormat="Custom" Width="140" />
      </StackPanel>
    </Grid>

    <!-- Action bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <Border Classes="notice" IsVisible="{Binding IsLocked}">
          <TextBlock Text="{Binding LockText}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="notice" IsVisible="{Binding DoNotUseWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding DoNotUseWarning}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="notice" IsVisible="{Binding NeedsStaleOverride}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding StaleMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Margin="8,0" Content="Approve anyway (logged)" Command="{Binding ApproveAnywayCommand}" />
            <Button Grid.Column="2" Content="Cancel" Command="{Binding DismissStaleCommand}" />
          </Grid>
        </Border>
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ItemsControl ItemsSource="{Binding ValidationMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding StringFormat='• {0}'}" Foreground="{StaticResource BadBrush}" FontSize="12" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Foreground="{StaticResource WarnBrush}" Text="{Binding DataWarning}" IsVisible="{Binding DataWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
        <TextBlock Foreground="{StaticResource BadBrush}" Text="{Binding PdfError}" IsVisible="{Binding PdfError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
        <TextBlock Foreground="{StaticResource OkBrush}" Text="{Binding InfoMessage}" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding LastPdfPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding LastPdfPath, StringFormat='PDF: {0}'}" />
          <Button Classes="link" FontSize="11" Content="Open folder" Command="{Binding OpenPdfFolderCommand}" />
        </StackPanel>
        <WrapPanel>
          <Button Classes="save" Margin="0,0,6,0" Content="Save Draft (Ctrl+S)" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditable}" />
          <Button Margin="0,0,6,0" Content="Preview (F11)" Command="{Binding PreviewCommand}" HotKey="F11" />
          <Button Classes="primary" Margin="0,0,6,0" Content="Approve &amp; Generate PDF (Ctrl+Enter)" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanApprove}" />
          <Button Name="SaveAsPdfButton" Classes="save" Margin="0,0,6,0" Content="Save as PDF" Command="{Binding SaveAsPdfCommand}" IsEnabled="{Binding CanSaveAsPdf}"
                  ToolTip.Tip="Approves a draft first, then saves 'Number Customer.pdf' in your PDF folder (My Settings)" />
          <CheckBox Name="SealBox" Margin="0,0,10,0" Content="Seal" IsChecked="{Binding SealPdf}" IsVisible="{Binding CanSeal}"
                    IsEnabled="{Binding SealAvailable}" ToolTip.Tip="{Binding SealHint}" ToolTip.ShowOnDisabled="True" />
          <Button Margin="0,0,6,0" Content="Open PDF (Ctrl+P)" Command="{Binding OpenPdfCommand}" IsVisible="{Binding HasPdf}" />
          <Button Margin="0,0,6,0" Content="Regenerate PDF" Command="{Binding RegeneratePdfCommand}" IsVisible="{Binding IsFinal}" />
          <Button Margin="0,0,6,0" Content="Duplicate (Ctrl+D)" Command="{Binding DuplicateCommand}" IsEnabled="{Binding Id, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Button Margin="0,0,6,0" Content="New" Command="{Binding NewQuotationCommand}" />
          <Button Classes="proforma" Margin="0,0,6,0" Content="Convert to Proforma Invoice" Command="{Binding ConvertToProformaCommand}" IsVisible="{Binding CanConvertToProforma}" />
          <Button Classes="danger" Margin="0,0,6,0" Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"
                  ToolTip.Tip="Administrator: move to the Deleted list (can be restored for 30 days)" />
          <Button Classes="danger" Margin="0,0,6,0" Content="{Binding DocLabel, StringFormat='Cancel {0}'}" Command="{Binding CancelQuotationCommand}" IsEnabled="{Binding IsEditable}" />
          <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Text="Unsaved changes" IsVisible="{Binding IsDirty}" Foreground="{StaticResource WarnBrush}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Spacing="10" IsEnabled="{Binding IsEditable}">
        <!-- Parties and references -->
        <Grid ColumnDefinitions="*,12,*,12,*">
          <Border Classes="card" Padding="14">
            <StackPanel>
              <Border Classes="headbar blue"><TextBlock Classes="h2" Text="Buyer (Bill to)" /></Border>
              <TextBlock Classes="fl" Text="Customer (Tally ledger)" />
              <ctl:SearchPicker Name="CustomerBox" Text="{Binding CustomerSearchText}" Search="{Binding CustomerPopulator}"
                                MaxDropDownHeight="360" MinDropDownWidth="380" Watermark="Type customer name, GSTIN or phone…"
                                NoMatchText="No matching customer in the Tally ledgers">
                <ctl:SearchPicker.ItemTemplate>
                  <DataTemplate x:DataType="c:CustomerSearchHitDto">
                    <StackPanel>
                      <TextBlock Text="{Binding Customer.Name}" FontWeight="SemiBold" />
                      <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding Customer.StateName, Mode=OneWay}" />
                        <Run Text="  " />
                        <Run Text="{Binding Customer.Gstin, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ctl:SearchPicker.ItemTemplate>
              </ctl:SearchPicker>
              <WrapPanel IsVisible="{Binding HasRecentCustomers}" Margin="0,3,0,0">
                <TextBlock Classes="fl" Text="Recent:" Margin="0,0,4,0" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding RecentCustomers}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="c:RecentItemDto">
                      <Button Content="{Binding Name}" Classes="small" Margin="0,0,4,4"
                              Command="{Binding $parent[UserControl].((vm:QuotationEditorViewModel)DataContext).PickRecentCustomerCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
              <TextBlock Classes="fl" Text="Name" />
              <TextBox Text="{Binding BuyerName}" ctl:TitleCase.Enabled="True" />
              <TextBlock Classes="fl" Text="Address" />
              <TextBox Text="{Binding BuyerAddress}" ctl:TitleCase.Enabled="True" AcceptsReturn="True" TextWrapping="Wrap" Height="62" />
              <Grid ColumnDefinitions="*,6,*">
                <StackPanel>
                  <TextBlock Classes="fl" Text="GSTIN/UIN (from Tally)" />
                  <TextBox Text="{Binding BuyerGstin}" IsReadOnly="True" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="fl" Text="State / Code (from Tally)" />
                  <TextBox IsReadOnly="True" Text="{Binding BuyerStateDisplay, Mode=OneWay}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,6,*">
                <StackPanel>
                  <TextBlock Classes="fl" Text="Contact" />
                  <TextBox Text="{Binding BuyerContact}" ctl:TitleCase.Enabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="fl" Text="Phone" />
                  <TextBox Text="{Binding BuyerPhone}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="fl" Text="E-mail" />
              <TextBox Text="{Binding BuyerEmail}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="card" Padding="14">
            <StackPanel>
              <Border Classes="headbar teal"><TextBlock Classes="h2" Text="Consignee (Ship to)" /></Border>
              <TextBlock Classes="fl" Text="Ship to" />
              <ComboBox ItemsSource="{Binding ShipToOptions}" SelectedItem="{Binding SelectedShipTo}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShipToOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel IsVisible="{Binding !ConsigneeSameAsBuyer}">
                <TextBlock Classes="fl" Text="Name" />
                <TextBox Text="{Binding ConsigneeName}" ctl:TitleCase.Enabled="True" />
                <TextBlock Classes="fl" Text="Address" />
                <TextBox Text="{Binding ConsigneeAddress}" ctl:TitleCase.Enabled="True" AcceptsReturn="True" TextWrapping="Wrap" Height="62" />
                <Grid ColumnDefinitions="*,6,*,6,50">
                  <StackPanel>
                    <TextBlock Classes="fl" Text="GSTIN" />
                    <TextBox Text="{Binding ConsigneeGstin}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="fl" Text="State" />
                    <TextBox Text="{Binding ConsigneeState}" ctl:TitleCase.Enabled="True" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Classes="fl" Text="Code" />
                    <TextBox Text="{Binding ConsigneeStateCode}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
              <TextBlock Classes="muted" FontSize="11" Margin="0,6,0,0" Text="Consignee is the same as the buyer." IsVisible="{Binding ConsigneeSameAsBuyer}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="4" Classes="card" Padding="14">
            <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <Border Classes="headbar purple" Grid.ColumnSpan="3"><TextBlock Classes="h2" Text="References" /></Border>
              <StackPanel Grid.Row="1">
                <TextBlock Classes="fl" Text="Buyer's Ref./Order No." />
                <TextBox Name="BuyersRefBox" Text="{Binding BuyersReference}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Classes="fl" Text="Ref. dated" />
                <CalendarDatePicker SelectedDate="{Binding BuyersReferenceDate}" CustomDateFormatString="dd-MMM-yyyy" SelectedDateFormat="Custom" HorizontalAlignment="Stretch" />
              </StackPanel>
              <StackPanel Grid.Row="2">
                <TextBlock Classes="fl" Text="Dispatched through" />
                <TextBox Text="{Binding DispatchedThrough}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Classes="fl" Text="Destination" />
                <TextBox Text="{Binding Destination}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
                <TextBlock Classes="fl" Text="Mode/Terms of payment" />
                <TextBox Text="{Binding PaymentTerms}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                <TextBlock Classes="fl" Text="Other references" />
                <TextBox Text="{Binding OtherReferences}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                <TextBlock Classes="fl" Text="Terms of delivery" />
                <TextBox Text="{Binding TermsOfDelivery}" ctl:TitleCase.Enabled="True" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
              </StackPanel>
              <!-- Proforma invoice only -->
              <StackPanel Grid.Row="6" Grid.ColumnSpan="3" IsVisible="{Binding IsProforma}">
                <TextBlock Classes="fl" Text="Delivery Note" />
                <TextBox Name="DeliveryNoteBox" Text="{Binding DeliveryNote}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="7" IsVisible="{Binding IsProforma}">
                <TextBlock Classes="fl" Text="Dispatch Doc No." />
                <TextBox Text="{Binding DispatchDocNo}" ctl:TitleCase.Enabled="True" />
              </StackPanel>
              <StackPanel Grid.Row="7" Grid.Column="2" IsVisible="{Binding IsProforma}">
                <TextBlock Classes="fl" Text="Delivery Note Date" />
                <CalendarDatePicker SelectedDate="{Binding DeliveryNoteDate}" CustomDateFormatString="dd-MMM-yyyy" SelectedDateFormat="Custom" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- Items -->
        <Border Classes="card" Padding="0">
          <StackPanel>
            <Border Background="{StaticResource SubtleFillBrush}" CornerRadius="14,14,0,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="12,9">
              <Grid ColumnDefinitions="36,*,80,50,70,70,90,44,54,100,110">
                <TextBlock Classes="th" Text="Sl" />
                <TextBlock Classes="th" Grid.Column="1" Text="Description of Goods" />
                <TextBlock Classes="th" Grid.Column="2" Text="HSN/SAC" />
                <TextBlock Classes="th" Grid.Column="3" Text="GST" />
                <TextBlock Classes="th" Grid.Column="4" Text="Due on" />
                <TextBlock Classes="th" Grid.Column="5" Text="Quantity" HorizontalAlignment="Right" />
                <TextBlock Classes="th" Grid.Column="6" Text="Rate" HorizontalAlignment="Right" />
                <TextBlock Classes="th" Grid.Column="7" Text="per" Margin="6,0,0,0" />
                <TextBlock Classes="th" Grid.Column="8" Text="Disc. %" HorizontalAlignment="Right" />
                <TextBlock Classes="th" Grid.Column="9" Text="Amount" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuotationLineViewModel">
                  <Border Classes="row" Classes.editing="{Binding IsEditing}" BorderBrush="#F0F0F3" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="36,*,80,50,70,70,90,44,54,100,110">
                      <TextBlock Classes="td" Text="{Binding LineNo}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Classes="td" Text="{Binding ItemName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="td" Text="{Binding Description}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                      </StackPanel>
                      <TextBlock Classes="td" Grid.Column="2" Text="{Binding Hsn}" />
                      <TextBlock Classes="td" Grid.Column="3" Text="{Binding GstText}" />
                      <TextBlock Classes="td" Grid.Column="4" Text="{Binding DueOn}" />
                      <TextBlock Classes="td" Grid.Column="5" Text="{Binding QuantityText}" HorizontalAlignment="Right" />
                      <StackPanel Grid.Column="6">
                        <TextBlock Classes="td" Text="{Binding RateText}" HorizontalAlignment="Right" />
                        <TextBlock FontSize="10" Foreground="{StaticResource WarnBrush}" Text="{Binding TallyRateHint}" HorizontalAlignment="Right" IsVisible="{Binding RateOverridden}" />
                      </StackPanel>
                      <TextBlock Classes="td" Grid.Column="7" Text="{Binding Unit}" Margin="6,0,0,0" />
                      <TextBlock Classes="td" Grid.Column="8" Text="{Binding DiscountText}" HorizontalAlignment="Right" />
                      <TextBlock Classes="td" Grid.Column="9" Text="{Binding AmountText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                      <StackPanel Grid.Column="10" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                        <Button Content="Edit" Classes="small"
                                Command="{Binding $parent[UserControl].((vm:QuotationEditorViewModel)DataContext).EditLineCommand}" CommandParameter="{Binding}" />
                        <Button Content="↑" Classes="small"
                                Command="{Binding $parent[UserControl].((vm:QuotationEditorViewModel)DataContext).MoveLineUpCommand}" CommandParameter="{Binding}" />
                        <Button Content="✕" Classes="small"
                                Command="{Binding $parent[UserControl].((vm:QuotationEditorViewModel)DataContext).RemoveLineCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Line entry -->
            <Border Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14" Padding="12,10">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,8,90,8,110,8,80,8,90,8,Auto">
                  <StackPanel>
                    <TextBlock Classes="fl" Text="Product (name, part no., alias, brand) — ↑/↓ to choose, Enter to select" />
                    <ctl:SearchPicker Name="ProductBox" Text="{Binding ProductSearchText}" Search="{Binding ProductPopulator}"
                                      SearchDelay="0:0:0.1" MaxDropDownHeight="420" MinDropDownWidth="600"
                                      Watermark="e.g. universal bevel, 10mm, 187-901" NoMatchText="No matching product in Tally">
                      <ctl:SearchPicker.ItemTemplate>
                        <DataTemplate x:DataType="c:ProductSearchHitDto">
                          <Grid ColumnDefinitions="*,60,90" MinWidth="560">
                            <StackPanel>
                              <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" />
                              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding Product.Brand, Mode=OneWay}" />
                                <Run Text="  HSN " />
                                <Run Text="{Binding Product.Hsn, Mode=OneWay}" />
                                <Run Text="  GST " />
                                <Run Text="{Binding Product.GstRate, StringFormat='{}{0:0.##}%', Mode=OneWay}" />
                              </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Product.Unit}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Product.Rate, StringFormat='{}{0:N2}', TargetNullValue='no rate'}" HorizontalAlignment="Right" />
                              <TextBlock Text="last rate" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                                         IsVisible="{Binding Product.RateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ctl:SearchPicker.ItemTemplate>
                    </ctl:SearchPicker>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Classes="fl" Text="Quantity" />
                    <NumericUpDown Name="QtyBox" Value="{Binding EntryQuantity}" Minimum="0" FormatString="0.###" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Classes="fl" Text="Rate" />
                    <NumericUpDown Name="RateBox" Value="{Binding EntryRate}" Minimum="0" FormatString="0.00" />
                  </StackPanel>
                  <StackPanel Grid.Column="6">
                    <TextBlock Classes="fl" Text="Disc. %" />
                    <NumericUpDown Name="DiscountBox" Value="{Binding EntryDiscount}" Minimum="0" Maximum="99.99" FormatString="0.##" />
                  </StackPanel>
                  <StackPanel Grid.Column="8">
                    <TextBlock Classes="fl" Text="Due on" />
                    <TextBox Name="DueOnBox" Text="{Binding EntryDueOn}" ctl:TitleCase.Enabled="True" />
                  </StackPanel>
                  <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4">
                    <Button Classes="primary" Content="{Binding EntryButtonText}" Command="{Binding CommitEntryCommand}" />
                    <Button Content="Clear" Command="{Binding CancelEntryCommand}" />
                  </StackPanel>
                </Grid>
                <WrapPanel IsVisible="{Binding HasRecentProducts}">
                  <TextBlock Classes="fl" Text="Recent products:" Margin="0,0,4,0" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding RecentProducts}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="c:RecentItemDto">
                        <Button Content="{Binding Name}" Classes="small" Margin="0,0,4,4" MaxWidth="320"
                                Command="{Binding $parent[UserControl].((vm:QuotationEditorViewModel)DataContext).PickRecentProductCommand}" CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </WrapPanel>
                <Grid ColumnDefinitions="*,12,Auto">
                  <StackPanel>
                    <TextBlock Classes="fl" Text="Description lines (brand, model, MOQ …) printed under the item — Shift+Enter = new line · Enter = add the line" />
                    <TextBox Name="DescriptionBox" Text="{Binding EntryDescription}" ctl:TitleCase.Enabled="True" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Bottom" IsVisible="{Binding EntryProduct, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                      <Run Text="From Tally — HSN " />
                      <Run Text="{Binding EntryProduct.Hsn, FallbackValue='', Mode=OneWay}" />
                      <Run Text=", GST " />
                      <Run Text="{Binding EntryProduct.GstRate, StringFormat='{}{0:0.##}%', FallbackValue='', TargetNullValue='not set', Mode=OneWay}" />
                      <Run Text=", Unit " />
                      <Run Text="{Binding EntryProduct.Unit, FallbackValue='', Mode=OneWay}" />
                      <Run Text=", Rate " />
                      <Run Text="{Binding EntryProduct.Rate, StringFormat='{}{0:N2}', FallbackValue='', TargetNullValue='not set — enter a rate', Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Text="{Binding EntryRateNoteText}"
                               IsVisible="{Binding EntryRateNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Footer: terms and totals -->
        <Grid ColumnDefinitions="*,12,360">
          <Border Classes="card" Padding="14">
            <StackPanel>
              <TextBlock Classes="fl" Text="Remarks (printed on quotation)" />
              <TextBox Text="{Binding Remarks}" ctl:TitleCase.Enabled="True" AcceptsReturn="True" TextWrapping="Wrap" Height="44" />
              <TextBlock Classes="fl" Text="Terms &amp; conditions (one per line)" />
              <TextBox Text="{Binding TermsAndConditions}" ctl:TitleCase.Enabled="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
              <Grid ColumnDefinitions="*,6,*">
                <StackPanel>
                  <TextBlock Classes="fl" Text="Prepared by" />
                  <TextBox Text="{Binding PreparedBy}" ctl:TitleCase.Enabled="True" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="fl" Text="Verified by" />
                  <TextBox Text="{Binding VerifiedBy}" ctl:TitleCase.Enabled="True" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Padding="14" Grid.Row="0">
            <StackPanel>
            <Border Classes="headbar green"><TextBlock Classes="h2" Text="Totals" /></Border>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="Subtotal" />
              <TextBlock Grid.Column="1" Text="{Binding SubtotalText}" HorizontalAlignment="Right" />
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4">
                <TextBlock Text="{Binding PackingLabel}" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding PackingForwarding}" Minimum="0" FormatString="0.00" Width="90" />
                <TextBlock Text="or %" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding PackingForwardingPercent}" Minimum="0" Maximum="100" FormatString="0.##" Width="60" />
              </StackPanel>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackingText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TaxText}" FontSize="12" IsVisible="{Binding ShowsTaxes}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" Text="Round off" IsVisible="{Binding RoundOffText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RoundOffText}" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="4" Text="Total quantity" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalQuantityText}" HorizontalAlignment="Right" />
              <Border Grid.Row="5" Grid.ColumnSpan="2" Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,6" />
              <TextBlock Grid.Row="6" Text="Total" FontWeight="Bold" FontSize="16" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GrandTotalText}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" />
              <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding AmountInWords}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </Grid>
            </StackPanel>
          </Border>
        </Grid>
        <Expander Header="History / audit trail" IsVisible="{Binding Id, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <Button Content="Load history" Command="{Binding LoadAuditTrailCommand}" />
            <ItemsControl ItemsSource="{Binding AuditTrail}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
