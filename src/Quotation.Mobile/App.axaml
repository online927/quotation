          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CheckBoxBorderBrushUnchecked">#B9C1CE</SolidColorBrush>
          <SolidColorBrush x:Key="ToolTipBackground">#1F2937</SolidColorBrush>
          <SolidColorBrush x:Key="ToolTipBorderBrush">#1F2937</SolidColorBrush>
          <SolidColorBrush x:Key="ToolTipForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollBarPanningThumbBackground">#591D3557</SolidColorBrush>
          <SolidColorBrush x:Key="InfoIconBrush">#0071E3</SolidColorBrush>
          <SolidColorBrush x:Key="TopBarTextBrush">#1D1D1F</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeBrush">#0071E3</SolidColorBrush>
          <SolidColorBrush x:Key="BadgeTextBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HeadingBrush">#1D1D1F</SolidColorBrush>
          <SolidColorBrush x:Key="TopBarMutedBrush">#6E6E73</SolidColorBrush>
          <SolidColorBrush x:Key="TopBarFieldBrush">#EDEDF0</SolidColorBrush>
      </ResourceDictionary>
