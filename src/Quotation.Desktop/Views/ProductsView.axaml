<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">
  <Grid Margin="20" ColumnDefinitions="3*,12,2*" RowDefinitions="Auto,Auto,*">
    <TextBlock Classes="h1" Text="Products" Grid.ColumnSpan="3" Margin="0,0,0,10" />
    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
      <TextBox Name="SearchBox" Text="{Binding Query}" Watermark="Search name, part no., alias, brand, HSN… (e.g. 'universal bevel', '10mm', '187-901')" />
      <TextBlock Classes="muted" FontSize="11" Text="{Binding ResultInfo}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <ListBox Grid.Row="2" Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="c:ProductSearchHitDto">
          <Grid ColumnDefinitions="*,70,90" Margin="0,1">
            <StackPanel>
              <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Product.Brand, Mode=OneWay}" />
                <Run Text="  HSN " />
                <Run Text="{Binding Product.Hsn, Mode=OneWay}" />
                <Run Text="  GST " />
                <Run Text="{Binding Product.GstRate, StringFormat='{}{0:0.##}%', Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Product.Unit}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{Binding Product.Rate, StringFormat='{}{0:N2}', TargetNullValue='no rate'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Classes="card" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ScrollViewer>
        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="{Binding Detail.Name, FallbackValue=''}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Classes="label" Text="Part number" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.PartNumber, FallbackValue=''}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Brand" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Brand, FallbackValue=''}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Stock group" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail.StockGroup, FallbackValue=''}" />
          <TextBlock Grid.Row="4" Classes="label" Text="Unit" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.Unit, FallbackValue=''}" />
          <TextBlock Grid.Row="5" Classes="label" Text="HSN/SAC" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail.Hsn, FallbackValue=''}" />
          <TextBlock Grid.Row="6" Classes="label" Text="GST" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Detail.GstRate, StringFormat='{}{0:0.##}%', FallbackValue='', TargetNullValue='not set in Tally'}" />
          <TextBlock Grid.Row="7" Classes="label" Text="GST source" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Detail.GstSource, FallbackValue=''}" />
          <TextBlock Grid.Row="8" Classes="label" Text="Rate" />
          <TextBlock Grid.Row="8" Grid.Column="1" FontWeight="Bold" Text="{Binding Detail.Rate, StringFormat='₹ {0:N2}', FallbackValue='', TargetNullValue='No selling price in Tally'}" />
          <TextBlock Grid.Row="9" Classes="label" Text="Rate source" />
          <TextBlock Grid.Row="9" Grid.Column="1" TextWrapping="Wrap">
            <Run Text="{Binding Detail.RateSource, FallbackValue='', Mode=OneWay}" />
            <Run Text="{Binding Detail.RateDate, StringFormat=' (from {0:dd-MMM-yyyy})', FallbackValue='', Mode=OneWay}" />
          </TextBlock>
          <TextBlock Grid.Row="10" Classes="label" Text="Aliases" VerticalAlignment="Top" />
          <ItemsControl Grid.Row="10" Grid.Column="1" ItemsSource="{Binding Detail.Aliases, FallbackValue={x:Null}}" />
          <TextBlock Grid.Row="11" Classes="label" Text="Description" VerticalAlignment="Top" />
          <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Detail.Description, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="12" Classes="label" Text="Synced" />
          <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Detail.LastSyncedUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm} UTC', FallbackValue=''}" />
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
