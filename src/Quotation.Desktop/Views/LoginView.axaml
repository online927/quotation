<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid Background="{StaticResource PageBrush}">
    <Border Classes="card" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,32" CornerRadius="20"
            BoxShadow="0 8 30 0 #14000000">
      <StackPanel Spacing="10">
        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
          <TextBlock Text="TS" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Classes="h1" Text="Sign in to Quotations" HorizontalAlignment="Center" Margin="0,6,0,0" />
        <TextBlock Classes="muted" Text="T.SAIFUDDIN &amp; CO. · Quotation Server" HorizontalAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Classes="label" Text="Server address" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Name="ServerBox" Text="{Binding ServerUrl}" Watermark="http://server-pc:5080" />
          <Button Grid.Column="1" Margin="6,0,0,0" Content="Test" Command="{Binding TestServerCommand}" />
        </Grid>
        <TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource OkBrush}" FontSize="12"
                   IsVisible="{Binding ServerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="label" Text="Username" />
        <TextBox Name="UserBox" Text="{Binding Username}" />
        <TextBlock Classes="label" Text="Password" />
        <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="●">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="18,9" Margin="0,8,0,0"
                Content="Sign in" Command="{Binding LoginCommand}" IsDefault="True" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
