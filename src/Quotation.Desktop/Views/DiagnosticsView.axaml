<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <DockPanel Margin="24,12,24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ctl:PageTitle Text="Diagnostics" Icon="diagnostics" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button ctl:ButtonIcon.Kind="db" Content="Backup database now" Command="{Binding BackupCommand}" />
        <Button ctl:ButtonIcon.Kind="export" Name="ExportButton" Content="Export everything" Command="{Binding ExportCommand}"
                ToolTip.Tip="One file (.tsq) with the database, PDFs, seal and logo, saved in Documents. Use it to move the server to another PC." />
        <Button ctl:ButtonIcon.Kind="upload" Name="RestoreButton" Content="Restore from backup file…" Click="OnRestoreClick"
                ToolTip.Tip="Replace the server's data with a .tsq export or a .db backup (the current data is backed up first)." />
        <Button HotKey="F5" Command="{Binding LoadCommand}" ToolTip.Tip="Refresh (F5)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M20,11 A8,8 0 1 0 17.7,16.6 M20,4 L20,11 L13,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <ctl:ErrorBanner DockPanel.Dock="Top" Text="{Binding ErrorMessage}" />
    <TabControl Classes="pills">
      <TabItem Header="System">
        <Border Classes="card" Margin="0,8" VerticalAlignment="Top">
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Server version" />
            <TextBlock Grid.Column="1" Text="{Binding Info.ServerVersion, FallbackValue=''}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Server runtime / OS" />
            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap">
              <Run Text="{Binding Info.Runtime, FallbackValue='', Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Info.OperatingSystem, FallbackValue='', Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Info.MachineName, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="2" Classes="label" Text="This PC" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClientInfo}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="label" Text="Data directory" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Info.DataDirectory, FallbackValue=''}" />
            <TextBlock Grid.Row="4" Classes="label" Text="Database size" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DatabaseSize}" />
            <TextBlock Grid.Row="5" Classes="label" Text="Products / customers" />
            <TextBlock Grid.Row="5" Grid.Column="1">
              <Run Text="{Binding Info.Products, FallbackValue='', Mode=OneWay}" />
              <Run Text=" / " />
              <Run Text="{Binding Info.Customers, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="6" Classes="label" Text="Quotations / PDFs" />
            <TextBlock Grid.Row="6" Grid.Column="1">
              <Run Text="{Binding Info.Quotations, FallbackValue='', Mode=OneWay}" />
              <Run Text=" / " />
              <Run Text="{Binding Info.PdfFiles, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="7" Classes="label" Text="Tally" />
            <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap">
              <Run Text="{Binding Info.Status.TallyConnected, StringFormat='Connected: {0}', FallbackValue='', Mode=OneWay}" />
              <Run Text="  " />
              <Run Text="{Binding Info.Status.TallyError, FallbackValue='', Mode=OneWay}" Foreground="{DynamicResource BadBrush}" />
            </TextBlock>
            <TextBlock Grid.Row="8" Classes="label" Text="Gmail / Claude AI" />
            <TextBlock Grid.Row="8" Grid.Column="1">
              <Run Text="{Binding Info.Status.GmailConnected, StringFormat='Gmail connected: {0}', FallbackValue='', Mode=OneWay}" />
              <Run Text="   " />
              <Run Text="{Binding Info.Status.AiConfigured, StringFormat='AI configured: {0}', FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="9" Classes="label" Text="Log files" VerticalAlignment="Top" />
            <ItemsControl Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Info.LogFiles, FallbackValue={x:Null}}" />
          </Grid>
        </Border>
      </TabItem>
      <TabItem Header="Who did what">
        <DockPanel Margin="0,8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
            <CalendarDatePicker Name="ActivityDayBox" SelectedDate="{Binding ActivityDay}" CustomDateFormatString="dd-MMM-yyyy" SelectedDateFormat="Custom" Width="150" />
            <ComboBox Name="ActivityUserBox" ItemsSource="{Binding ActivityUsers}" SelectedItem="{Binding ActivityUser}" MinWidth="160" />
            <ToggleSwitch Name="ActivityImportantSwitch" IsChecked="{Binding ActivityImportantOnly}" OnContent="Approvals and cancels only"
                          OffContent="Approvals and cancels only" VerticalAlignment="Center" Margin="6,0" />
            <Button Name="SummaryButton" ctl:ButtonIcon.Kind="history" Content="Summary" Command="{Binding ShowSummaryCommand}"
                    ToolTip.Tip="The day's summary: quotations and value, per user, won / lost, drafts, follow-ups" />
          </StackPanel>
          <Border DockPanel.Dock="Top" Classes="card" Name="SummaryCard" Margin="0,0,0,8" IsVisible="{Binding HasSummary}" HorizontalAlignment="Left" MinWidth="420">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Name="SummaryTextBlock" Text="{Binding SummaryText}" TextWrapping="Wrap" LineHeight="22" />
              <Button Grid.Column="1" Name="SummaryWhatsAppButton" Classes="primary" ctl:ButtonIcon.Kind="open" Content="WhatsApp" VerticalAlignment="Top"
                      Command="{Binding SummaryToWhatsAppCommand}" />
            </Grid>
          </Border>
          <Border DockPanel.Dock="Top" Classes="tablehead">
            <Grid ColumnDefinitions="80,140,*">
              <TextBlock Text="Time" />
              <TextBlock Grid.Column="1" Text="User" />
              <TextBlock Grid.Column="2" Text="What" />
            </Grid>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="muted" Name="NoActivityText" Text="Nothing on this day." IsVisible="{Binding NoActivity}" Margin="12,14" />
          <ListBox Classes="table" Name="ActivityList" ItemsSource="{Binding Activity}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityRow">
                <Grid ColumnDefinitions="80,140,*">
                  <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding User}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip" Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsBad}" Classes.warn="{Binding IsWarn}"><TextBlock Text="{Binding Chip}" /></Border>
                    <TextBlock Text="{Binding What}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="PDFs of a month">
        <Border Classes="card" Margin="0,8" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="560">
          <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="PDFs of a month" />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="Month" VerticalAlignment="Center" />
              <ComboBox Name="ZipMonthBox" ItemsSource="{Binding Months}" SelectedItem="{Binding ZipMonth}" MinWidth="190" />
              <CheckBox Name="ZipQuotationsBox" IsChecked="{Binding ZipQuotations}" Content="Quotations" VerticalAlignment="Center" />
              <CheckBox Name="ZipProformaBox" IsChecked="{Binding ZipProforma}" Content="Proforma invoices" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="DownloadZipButton" Classes="primary" ctl:ButtonIcon.Kind="download" Content="Download ZIP" Command="{Binding DownloadMonthZipCommand}" />
              <Border Classes="info" VerticalAlignment="Center" ToolTip.Tip="The approved PDFs of that month in one ZIP file, saved in Documents (e.g. Quotations-2026-11.zip with 'TSQ2627-101 Sonepar India.pdf' …)."><Path Classes="infoicon" /></Border>
            </StackPanel>
            <TextBlock Name="ZipInfoText" Foreground="{DynamicResource OkBrush}" Text="{Binding InfoMessage}" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="Audit log">
        <DockPanel Margin="0,8">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,6">
            <TextBox Text="{Binding AuditFilter}" Watermark="Filter by action, user or details" />
            <Button ctl:ButtonIcon.Kind="check" Grid.Column="2" Content="Apply" Command="{Binding LoadAuditCommand}" />
          </Grid>
          <ListBox ItemsSource="{Binding Audit}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="c:AuditEntryDto">
                <Grid ColumnDefinitions="150,170,110,120,*">
                  <TextBlock Text="{Binding AtUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm:ss}'}" FontSize="{DynamicResource FontSmall}" />
                  <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding User}" FontSize="{DynamicResource FontSmall}" />
                  <TextBlock Grid.Column="3" Text="{Binding Machine}" FontSize="{DynamicResource FontSmall}" />
                  <TextBlock Grid.Column="4" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap">
                    <Run Text="{Binding EntityType, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding EntityId, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding Details, Mode=OneWay}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Slow requests">
        <DockPanel Margin="0,8">
          <StackPanel DockPanel.Dock="Top" Classes="help" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6"><TextBlock Text="Requests that took longer than 1 second (last 500)." TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Requests that took longer than 1 second (last 500). Total = on the user's PC, from click to answer; Server = the server's own time. Total slow but Server quick means the network or finding the server PC; Server slow means the server PC was busy."><Path Classes="infoicon" /></Border></StackPanel>
          <Border DockPanel.Dock="Top" Classes="tablehead">
            <Grid ColumnDefinitions="120,170,150,70,70,150,*">
              <TextBlock Text="When" />
              <TextBlock Grid.Column="1" Text="PC / User" />
              <TextBlock Grid.Column="2" Text="What" />
              <TextBlock Grid.Column="3" Text="Total" />
              <TextBlock Grid.Column="4" Text="Server" />
              <TextBlock Grid.Column="5" Text="Server busy with" />
              <TextBlock Grid.Column="6" Text="Likely cause" />
            </Grid>
          </Border>
          <ListBox Classes="table" ItemsSource="{Binding SlowRequests}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SlowRequestRow">
                <Grid ColumnDefinitions="120,170,150,70,70,150,*">
                  <TextBlock Text="{Binding When}" FontSize="{DynamicResource FontSmall}" />
                  <TextBlock Grid.Column="1" Text="{Binding Who}" FontSize="{DynamicResource FontSmall}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding What}" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding Total}" FontSize="{DynamicResource FontSmall}" />
                  <TextBlock Grid.Column="4" Text="{Binding Server}" FontSize="{DynamicResource FontSmall}" />
                  <TextBlock Grid.Column="5" Text="{Binding Busy}" FontSize="{DynamicResource FontSmall}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="6" Text="{Binding Cause}" FontSize="{DynamicResource FontSmall}" Foreground="{DynamicResource WarnBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Server log">
        <TextBox Margin="0,8" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="{DynamicResource FontSmall}" TextWrapping="NoWrap" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
