    </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
    </Application.Resources>

  <Application.Styles>
    <FluentTheme >
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0071E3" RegionColor="#F5F5F7" BaseHigh="#1D1D1F" ErrorText="#D70015" />
        <ColorPaletteResources x:Key="Dark" Accent="#0A84FF" RegionColor="#1C1C1E" BaseHigh="#F2F2F7" ErrorText="#FF453A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Quotation.Mobile/PhoneStyles.axaml" />
  </Application.Styles>
</Application>
