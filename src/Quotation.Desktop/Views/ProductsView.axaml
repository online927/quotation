<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">
  <UserControl.Styles>
    <!-- Round 39 (RD-6): space round each shown row (hidden rows take no room) -->
    <Style Selector="Grid.details > TextBlock, Grid.details > Panel, Grid.details > ItemsControl">
      <Setter Property="Margin" Value="0,4.5" />
    </Style>
  </UserControl.Styles>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </UserControl.KeyBindings>
  <Grid Margin="24,12,24,20" ColumnDefinitions="3*,12,2*" RowDefinitions="Auto,Auto,*">
    <ctl:PageTitle Text="Products" Icon="products" Grid.ColumnSpan="3" Margin="0,0,0,10" />
    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,12,Auto">
        <TextBox Name="SearchBox" Text="{Binding Query}" Watermark="Search name, part no., alias, brand, HSN… (e.g. 'universal bevel', '10mm', '187-901')" />
        <ToggleSwitch Grid.Column="2" Name="ShowDnuSwitch" OnContent="Show DNU items" OffContent="Show DNU items" IsChecked="{Binding ShowHidden}"
                  ToolTip.Tip="Items whose Tally description is DNU (do not use) are never offered in quotations" />
      </Grid>
      <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="{Binding ResultInfo}" />
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />
    </StackPanel>
    <ListBox Grid.Row="2" Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="c:ProductSearchHitDto">
          <Grid ColumnDefinitions="*,70,90" Margin="0,1">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="pill" Background="{DynamicResource WarnSoftBrush}" Padding="6,0" IsVisible="{Binding Product.Hidden}">
                  <TextBlock Text="DNU" FontSize="{DynamicResource FontTiny}" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}" />
                </Border>
                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border Classes="pill" Background="{DynamicResource AccentSoftBrush}" Padding="6,0" VerticalAlignment="Center" IsVisible="{Binding Match.UsedFuzzy}"
                                        ToolTip.Tip="A close match for a spelling mistake">
                                  <TextBlock Text="close match" FontSize="{DynamicResource FontTiny}" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
              </StackPanel>
              <TextBlock FontSize="{DynamicResource FontSmall}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Product.Brand, Mode=OneWay}" />
                <Run Text="  HSN " />
                <Run Text="{Binding Product.Hsn, Mode=OneWay}" />
                <Run Text="  GST " />
                <Run Text="{Binding Product.GstRate, StringFormat='{}{0:0.##}%', Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Product.Unit}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{Binding Product.Rate, StringFormat='{}{0:N2}', TargetNullValue='no rate'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Classes="card" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ScrollViewer>
        <Grid Classes="details" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="0" ColumnSpacing="12">
          <TextBlock Grid.ColumnSpan="2" Classes="h2" Text="{Binding Detail.Name, FallbackValue=''}" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Classes="label" Text="Part number" IsVisible="{Binding HasPartNumber}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.PartNumber, FallbackValue=''}" IsVisible="{Binding HasPartNumber}" />
          <TextBlock Grid.Row="2" Classes="label" Text="Brand" IsVisible="{Binding HasBrand}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Detail.Brand, FallbackValue=''}" IsVisible="{Binding HasBrand}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Stock group" />
          <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="SemiBold" Text="{Binding Detail.StockGroup, FallbackValue=''}" />
          <TextBlock Grid.Row="4" Classes="label" Text="Unit" />
          <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="{Binding Detail.Unit, FallbackValue=''}" />
          <TextBlock Grid.Row="5" Classes="label" Text="HSN/SAC" />
          <TextBlock Grid.Row="5" Grid.Column="1" FontWeight="SemiBold" Text="{Binding Detail.Hsn, FallbackValue=''}" />
          <TextBlock Grid.Row="6" Classes="label" Text="GST" />
          <TextBlock Grid.Row="6" Grid.Column="1" FontWeight="SemiBold" Text="{Binding GstText}" />
          <TextBlock Grid.Row="8" Classes="label" Text="Rate" />
          <Panel Grid.Row="8" Grid.Column="1">
            <TextBlock FontWeight="Bold" Text="{Binding RateText}" IsVisible="{Binding HasRate}" />
            <Border Name="NoRateChip" Classes="chip warn" HorizontalAlignment="Left" IsVisible="{Binding NoRate}">
              <TextBlock Text="No selling price in Tally" FontSize="{DynamicResource FontSmall}" />
            </Border>
          </Panel>
          <TextBlock Grid.Row="9" Classes="label" Text="Rate source" IsVisible="{Binding HasRateSource}" />
          <TextBlock Grid.Row="9" Grid.Column="1" TextWrapping="Wrap" Text="{Binding RateSourceText}" IsVisible="{Binding HasRateSource}" />
          <TextBlock Grid.Row="10" Classes="label" Text="Aliases" VerticalAlignment="Top" IsVisible="{Binding HasAliases}" />
          <ItemsControl Grid.Row="10" Grid.Column="1" ItemsSource="{Binding Detail.Aliases, FallbackValue={x:Null}}" IsVisible="{Binding HasAliases}" />
          <TextBlock Grid.Row="11" Classes="label" Text="Description" VerticalAlignment="Top" IsVisible="{Binding HasDescription}" />
          <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Detail.Description, FallbackValue=''}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
          <TextBlock Grid.Row="12" Classes="label" Text="Synced" />
          <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SyncedText}" />
          <!-- Round 36: the item's PDF datasheet -->
          <TextBlock Grid.Row="13" Classes="label" Text="Datasheet" VerticalAlignment="Top" Margin="0,10,0,0" />
          <StackPanel Grid.Row="13" Grid.Column="1" Spacing="8" Margin="0,10,0,0" Name="DatasheetPanel">
            <Border Background="{DynamicResource SubtleFillBrush}" CornerRadius="10" Padding="12,10" IsVisible="{Binding HasDatasheet}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Name="DatasheetName" Text="{Binding Datasheet.FileName, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding DatasheetInfo}" FontSize="{DynamicResource FontSmall}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Name="OpenDatasheetButton" ctl:ButtonIcon.Kind="open" Content="Open" Command="{Binding OpenDatasheetCommand}" />
                  <Button Name="ReplaceDatasheetButton" ctl:ButtonIcon.Kind="upload" Content="Replace" Click="OnUploadDatasheet" IsVisible="{Binding IsAdmin}" />
                  <Button Name="RemoveDatasheetButton" ctl:ButtonIcon.Kind="trash" Content="Remove" Command="{Binding RemoveDatasheetCommand}" IsVisible="{Binding IsAdmin}" />
                </StackPanel>
              </Grid>
            </Border>
            <ToggleSwitch Name="DatasheetOnPdfBox" OnContent="Add to the quotation PDF when this item is quoted" OffContent="Add to the quotation PDF when this item is quoted" IsChecked="{Binding DatasheetOnPdf}"
                      IsVisible="{Binding HasDatasheet}" IsEnabled="{Binding IsAdmin}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NoDatasheet}">
              <TextBlock Classes="muted" Text="None" VerticalAlignment="Center" />
              <Button Name="UploadDatasheetButton" ctl:ButtonIcon.Kind="upload" Content="Add datasheet (PDF)…" Click="OnUploadDatasheet" IsVisible="{Binding CanUploadDatasheet}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
