<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.MySettingsView"
             x:DataType="vm:MySettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,12,24,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
      <StackPanel>
        <ctl:PageTitle Text="My Settings" Icon="mysettings" />
        <TextBlock Classes="muted" Text="{Binding UserName, StringFormat='Only for you ({0}) — every user can change these.'}" />
      </StackPanel>
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Without GST (next quotation only)" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Classes="muted"
                     Text="For a company that does not take GST (e.g. SEZ): the next quotation or proforma invoice you make shows 0 % on every item, 'Packing &amp; Forwarding - Without GST' and no SGST/CGST/IGST lines. The switch turns itself off as soon as that document is saved; the document keeps it." />
          <ToggleSwitch Name="WithoutGstSwitch" IsChecked="{Binding WithoutGstNext}" OnContent="On — next quotation without GST" OffContent="Off" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="PDF layout and file name" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Classes="muted"
                     Text="The look of the PDFs you make: Tally (like the TallyPrime print) or Zoho (company logo, modern design). Used for Approve, Save as PDF, Open PDF and Preview. Saved with your login, so it follows you to every PC." />
          <ComboBox Name="PdfLayoutBox" ItemsSource="{Binding PdfLayoutChoices}" SelectedItem="{Binding PdfLayout}" Width="200" />
          <TextBlock Classes="label" Text="PDF file name" Margin="0,8,0,0" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="The order in the names of your PDF files (Approve, Save as PDF, Open PDF, WhatsApp). Saved with your login; files already saved keep their names." />
          <ComboBox Name="PdfFileOrderBox" ItemsSource="{Binding PdfFileOrderChoices}" SelectedIndex="{Binding PdfFileOrderIndex}" Width="420" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Appearance" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Classes="muted"
                     Text="Just for you, and saved with your login, so it follows you to every PC. The moon/sun button at the top switches between Default Light and Dark. PDFs are always printed white." />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="label" Text="Theme" />
            <ComboBox Grid.Column="1" Name="ThemeBox" ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding ThemeIndex}" Width="200" />
            <TextBlock Grid.Row="1" Classes="label" Text="Text size" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="TextSizeBox" ItemsSource="{Binding TextSizeChoices}" SelectedIndex="{Binding TextSizeIndex}" Width="200" />
            <TextBlock Grid.Row="2" Classes="label" Text="Spacing" />
            <ComboBox Grid.Row="2" Grid.Column="1" Name="SpacingBox" ItemsSource="{Binding SpacingChoices}" SelectedIndex="{Binding SpacingIndex}" Width="200"
                      ToolTip.Tip="Compact fits more on a small laptop screen" />
            <TextBlock Grid.Row="3" Classes="label" Text="Animations" />
            <ToggleSwitch Grid.Row="3" Grid.Column="1" Name="ReduceMotionSwitch" IsChecked="{Binding ReduceMotion}"
                          OnContent="Reduce animations (no animations, no glow)" OffContent="On"
                          ToolTip.Tip="For a slow PC, or if you prefer a calm screen: no animations and no glow shadows" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Save as PDF folders (this PC)" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Classes="muted"
                     Text="'Save as PDF' saves the document here without asking (named as chosen above). Leave a box empty for the standard folder." />
          <TextBlock Classes="fl" Text="Quotations" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding PdfFolder}" Watermark="{Binding DefaultPdfFolder}" />
            <Button Grid.Column="2" Name="BrowseButton" Content="Browse…" Click="OnBrowse" />
          </Grid>
          <TextBlock Classes="fl" Text="Proforma invoices" />
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBox Text="{Binding ProformaPdfFolder}" Watermark="{Binding DefaultProformaPdfFolder}" />
            <Button Grid.Column="2" Name="BrowseProformaButton" Content="Browse…" Click="OnBrowseProforma" />
          </Grid>
          <Button Classes="primary" Content="Save" Command="{Binding SavePdfFolderCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Connection and version (this PC)" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Classes="muted"
                     Text="The Quotation Server this PC uses. To change it, log out and type the address in the server box on the sign-in screen." />
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="label" Text="Server" />
            <SelectableTextBlock Grid.Column="1" Name="ServerAddressText" Text="{Binding ServerAddress}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Classes="label" Text="Computer" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ComputerName}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Classes="label" Text="Financial year" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FinancialYear}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Classes="label" Text="App version" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static vm:ShellViewModel.AppVersionText}" FontWeight="SemiBold" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
