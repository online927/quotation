<!--
  The look of the quotation screen (cards, item table, button bar), shared by the quotation editor and the Formater page so
  both follow every theme the same way.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.fl">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
      <Setter Property="Margin" Value="0,4,0,1" />
    </Style>
    <!-- Headings of the item table (Sl, Description of Goods …): bold, in the normal text colour -->
    <Style Selector="TextBlock.th">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.td">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="ShowButtonSpinner" Value="False" />
    </Style>
    <!-- Item lines: the whole line reacts to the mouse (faint highlight, Edit and remove appear) -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.alt">
      <Setter Property="Background" Value="{DynamicResource ZebraBrush}" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
    </Style>
    <Style Selector="Border.row.dragging">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,2" />
    </Style>
    <!-- Round 39 (DG-1): the drag dots show only on the row under the mouse (soft accent chip) and on the row being dragged
         (solid accent chip, white dots); the space stays so the Sl numbers do not move. -->
    <Style Selector="Border.grip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeNorthSouth" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.grip Path">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.row:pointerover Border.grip">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.row.dragging Border.grip">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.row.dragging Border.grip Path">
      <Setter Property="Fill" Value="White" />
    </Style>
    <!-- Edit and remove appear when the mouse is on the line (and on the line being edited) -->
    <Style Selector="StackPanel.lineactions">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.row:pointerover StackPanel.lineactions, Border.row.editing StackPanel.lineactions, StackPanel.lineactions:focus-within">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Round 39 (KL-1): the line picked with the arrow keys -->
    <Style Selector="Border.row.highlight">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.row.editing">
      <Setter Property="Background" Value="{DynamicResource EditingRowBrush}" />
    </Style>
    <Style Selector="Border.card TextBlock.h2">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Icons inside buttons take the button's text colour -->
    <!-- Not enough room on the button line: only the icon (the name is in the tooltip) -->
    <Style Selector="Button.iconly TextBlock.lbl">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Path.bi">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.9" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Section icons (Items, Remarks) -->
    <Style Selector="Path.si">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Action bar: taller buttons (colours unchanged) -->
    <!-- The floating card under the quotation -->
    <Style Selector="Border.dock">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,8,0,6" />
      <Setter Property="BoxShadow" Value="0 6 24 0 #1A000000" />
    </Style>
    <Style Selector="Button.bar.primary, Button.bar.save">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="18,7" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Icon buttons: the icon beside the name on one line, no box until the mouse is on it -->
    <Style Selector="Button.bar.tile">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.bar.tile /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.bar.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
    </Style>
    <Style Selector="Button.bar.tile Path.bi">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bar.tile TextBlock.lbl">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bar">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="Border.pill.status">
      <Setter Property="Padding" Value="13,4" />
    </Style>
    <!-- Buyer box: a GSTIN that looks mistyped gets a red ring and a red note -->
    <Style Selector="TextBox.bad /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.gstinbad">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Consignee: "GST by" the buyer's state or the ship-to state, two rows with a dot -->
    <Style Selector="RadioButton.gstby">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="row" Background="Transparent" CornerRadius="8" Padding="9,6" Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <Border Name="dot" Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" Margin="0,0,8,0"
                      VerticalAlignment="Center" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource MutedBrush}" />
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="RadioButton.gstby:checked">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.gstby:checked /template/ Border#row">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="RadioButton.gstby:checked /template/ Border#dot">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="4" />
    </Style>
    <Style Selector="RadioButton.gstby:pointerover:not(:checked) /template/ Border#row">
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
    </Style>
    <Style Selector="RadioButton.gstby:focus-visible /template/ Border#row">
      <Setter Property="BoxShadow" Value="{DynamicResource FocusRingInset}" />
    </Style>
    <Style Selector="RadioButton.gstby Run.gsttax">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.gstby:checked Run.gsttax">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Pasted list: a rate that came from the Excel rows -->
    <Style Selector="NumericUpDown.fromexcel TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PillOkBrush}" />
    </Style>
    <!-- Quotation page heading (simple): the number in a light ticket in the theme's colour, the status chip, the date pill -->
    <Style Selector="Border.ticket">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Path.ticketicon">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.ticketnumber">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.statuschip, Border.datepill">
      <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #22000000" />
    </Style>
    <Style Selector="Border.statuschip">
      <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.datepill">
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Border.statuschip Ellipse">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.statuschip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.statuschip.ok Ellipse"><Setter Property="Fill" Value="{DynamicResource GreenBrush}" /></Style>
    <Style Selector="Border.statuschip.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}" /></Style>
    <Style Selector="Border.statuschip.pending Ellipse"><Setter Property="Fill" Value="{DynamicResource OrangeBrush}" /></Style>
    <Style Selector="Border.statuschip.pending TextBlock"><Setter Property="Foreground" Value="{DynamicResource OrangeBrush}" /></Style>
    <Style Selector="Border.statuschip.bad Ellipse"><Setter Property="Fill" Value="{DynamicResource BadBrush}" /></Style>
    <Style Selector="Border.statuschip.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource BadBrush}" /></Style>
    <Style Selector="Path.dateicon">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- The administrator's date box sits in the pill without a box of its own -->
    <Style Selector="Border.datepill CalendarDatePicker">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Tally theme (here, after the styles above, so these win): square boxes without shadows -->
    <Style Selector=".tally Border.ticket">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector=".tally Border.statuschip, .tally Border.datepill">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
</Styles>
