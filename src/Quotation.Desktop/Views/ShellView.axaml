<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:svc="using:Quotation.Desktop.Services"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             x:Class="Quotation.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.xo.win"><Setter Property="Background" Value="#3322A447" /></Style>
    <Style Selector="Button.xo.win /template/ ContentPresenter"><Setter Property="Background" Value="#3322A447" /></Style>
    <!-- Rows of the number list under the top search box -->
    <Style Selector="Button.numbermatch">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.numbermatch /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.numbermatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.numbermatch.hi /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.numbermatch Border.badge">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    </Style>
    <Style Selector="Button.numbermatch Border.badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.numbermatch.hi Border.badge">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.numbermatch.hi Border.badge TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
    </Style>
    <Style Selector="Border.key TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <DockPanel>
      <!-- Top bar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,9">
        <Grid ColumnDefinitions="246,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource BadgeBrush}">
              <TextBlock Name="CompanyBadge" Text="{Binding CompanyInitials}" Foreground="{DynamicResource BadgeTextBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Quotations" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TopBarTextBrush}" />
              <TextBlock Text="{Binding Status.TallyCompany, FallbackValue=''}" FontSize="{DynamicResource FontSmall}" Foreground="{DynamicResource TopBarMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
            </StackPanel>
          </StackPanel>
          <TextBox Grid.Column="1" Name="GlobalSearchBox" Text="{Binding GlobalSearch}" MaxWidth="520" HorizontalAlignment="Stretch" Margin="16,0"
                   CornerRadius="999" Padding="16,6" Background="{DynamicResource TopBarFieldBrush}" Foreground="{DynamicResource TopBarTextBrush}" BorderThickness="0"
                   Watermark="Search quotations"
                   ToolTip.Tip="Search quotations by number, customer, GSTIN, product, reference or date (Ctrl+F)">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <!-- Typing a quotation number: its quotation(s) below the box; Enter opens the highlighted one -->
          <Popup Name="NumberPopup" PlacementTarget="{Binding #GlobalSearchBox}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                 IsOpen="{Binding ShowNumberMatches, Mode=OneWay}" IsLightDismissEnabled="False"
                 Width="{Binding #GlobalSearchBox.Bounds.Width}">
            <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8" BoxShadow="0 10 30 0 #33000000">
              <StackPanel Spacing="2">
                <TextBlock Text="OPEN" Classes="muted" FontSize="{DynamicResource FontSmall}" Margin="10,2,0,4" />
                <ItemsControl Name="NumberMatchList" ItemsSource="{Binding NumberMatches}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumberMatchViewModel">
                      <Button Classes="numbermatch" Classes.hi="{Binding IsHighlighted}" Focusable="False" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Padding="10,8"
                              Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenNumberMatchCommand}" CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="badge" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding YearNote}" Classes="muted" FontSize="{DynamicResource FontSmall}" IsVisible="{Binding HasYearNote}" VerticalAlignment="Center" />
                              <Border Classes="pill status" Classes.ok="{Binding IsFinal}" Classes.pending="{Binding IsPending}" Classes.bad="{Binding IsCancelled}"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontTiny}" FontWeight="SemiBold" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="key" IsVisible="{Binding IsHighlighted}" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Enter" FontSize="{DynamicResource FontSmall}" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,4" />
                <Button Name="SearchAllButton" Classes="numbermatch" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="10,8" Command="{Binding SearchAllCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Data="M11,4 A7,7 0 1 1 10.99,4 Z M20,20 L16,16" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                          StrokeLineCap="Round" Width="16" Height="16" Stretch="Uniform" Margin="2,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SearchAllText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="customer, GSTIN, part no. …" Classes="muted" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
          </Popup>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- Status: a round button with signal bars (3 green = connected, 2 orange = a warning, 1 red = not connected); the
                 words and details when pointing at it or clicking -->
            <Button Name="StatusChip" Classes="round onbar" ToolTip.Tip="{Binding HealthDetails}">
              <StackPanel Name="SignalBars" Classes="signal" Classes.ok="{Binding HealthOk}" Classes.warn="{Binding HealthWarn}"
                          Classes.bad="{Binding HealthBad}" Orientation="Horizontal" Spacing="2" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Classes="b1" Height="5" />
                <Border Classes="b2" Height="9" />
                <Border Classes="b3" Height="13" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="6" Margin="4,2" MaxWidth="340">
                    <TextBlock Name="StatusLabel" Text="{Binding HealthLabel}" FontWeight="Bold" FontSize="14" />
                    <TextBlock Name="StatusDetails" Text="{Binding HealthDetails}" FontSize="12.5" LineHeight="21" TextWrapping="Wrap" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- Light / dark mode for this user -->
            <Button Name="ThemeButton" Classes="round onbar" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTip}">
              <Path Data="{Binding ThemeIcon}" Stroke="{DynamicResource TopBarTextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"
                    StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
            <!-- One round icon with the user's initial (pointing at it shows the name): change my password, my settings, log out -->
            <Button Name="UserMenuButton" Classes="round onbar" ToolTip.Tip="{Binding UserTip}">
              <TextBlock Name="UserInitialsText" Text="{Binding UserInitials}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TopBarTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Name="UserMenuHeader" Classes="menuhead" IsHitTestVisible="False" Focusable="False">
                    <MenuItem.Header>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
                          <TextBlock Text="{Binding UserInitials}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding UserDisplay}" FontWeight="Bold" />
                          <Border Classes="chip"><TextBlock Text="{Binding UserRole}" FontSize="{DynamicResource FontSmall}" /></Border>
                        </StackPanel>
                      </StackPanel>
                    </MenuItem.Header>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Change my password" Command="{Binding ChangeMyPasswordCommand}">
                    <MenuItem.Icon><Path Classes="menuicon" Data="M7.5,11 A3.5,3.5 0 1 0 7.51,11 Z M10,12.5 L19,3.5 M16,6.5 L19,9.5 M13.5,9 L15.5,11" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="My Settings" Command="{Binding NavigateCommand}" CommandParameter="mysettings">
                    <MenuItem.Icon><Path Classes="menuicon" Data="M12,4 A4,4 0 1 0 12.01,4 Z M4,21 C5,17 8.5,15 12,15 C15.5,15 19,17 20,21" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Classes="danger" Header="Log out" Command="{Binding LogoutCommand}">
                    <MenuItem.Icon><Path Classes="menuicon bad" Data="M15,4 L18,4 A2,2 0 0 1 20,6 L20,18 A2,2 0 0 1 18,20 L15,20 M10,8 L6,12 L10,16 M6,12 L16,12" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- Log out: a small round light-red button (it still asks first) -->
            <Button Name="LogoutButton" Classes="round logout" Command="{Binding LogoutCommand}" ToolTip.Tip="Log out">
              <Path Data="M15,4 L18,4 A2,2 0 0 1 20,6 L20,18 A2,2 0 0 1 18,20 L15,20 M10,8 L6,12 L10,16 M6,12 L16,12" Stroke="{DynamicResource BadBrush}"
                    StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Warning strip: only while something is wrong (server unreachable, Tally disconnected, old data, Tally busy) -->
      <Border DockPanel.Dock="Top" Name="WarningStrip" Classes="warnstrip" Padding="20,6" BorderThickness="0,0,0,1"
              Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}"
              IsVisible="{Binding VisibleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Data="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,17 L12,17.5" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Text="{Binding VisibleWarning}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Name="CloseWarningButton" Classes="link" Padding="6,2" Margin="12,0,0,0" Command="{Binding CloseWarningCommand}"
                  ToolTip.Tip="Close (the dot at the top stays red or orange until it is fixed)">
            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineCap="Round"
                  Width="11" Height="11" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Name="Sidebar" Classes="sidebar" Classes.collapsed="{Binding SidebarCollapsed}" DockPanel.Dock="Left" ZIndex="10"
              Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
        <Panel>
        <!-- Pines at the foot of the menu (Parchment and Forest & Gold themes only) -->
        <Path Name="SidebarArt" Classes="sideart" Data="{x:Static ctl:ThemeArt.SidebarPines}" Fill="{DynamicResource SidebarArtBrush}"
              Stretch="Fill" Height="110" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <Path Classes="sideart" Data="{x:Static ctl:ThemeArt.SidebarCity}" Fill="{DynamicResource SidebarCityBrush}"
              Stretch="Fill" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <!-- Ocean, Midnight Stars: their small scene at the foot of the menu -->
        <Path Name="SideScene" Classes="sideart" Data="{DynamicResource SideArt}" Fill="{DynamicResource SideArtBrush}"
              Stretch="Fill" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <DockPanel>
        <Button Name="SidebarToggle" DockPanel.Dock="Bottom" Classes="nav" Command="{Binding ToggleSidebarCommand}" Margin="10,4,10,10"
                ToolTip.Tip="{Binding SidebarToggleTip}">
          <Panel>
            <Grid Classes="navgrid" ColumnDefinitions="32,*">
              <Path Classes="icon" Data="{Binding SidebarToggleIcon}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding SidebarToggleText}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Classes="navmini">
              <Path Classes="icon" Data="{Binding SidebarToggleIcon}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </Button>
        <ScrollViewer Name="NavScroller" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel>
                  <Panel IsVisible="{Binding HasSection}">
                    <TextBlock Classes="sidehead plain" Text="{Binding Section}" Margin="12,14,0,4" />
                    <TextBlock Classes="sidehead caps" Text="{Binding SectionCaps}" Margin="12,12,0,3" />
                    <Border Classes="sidegap" Height="12" />
                  </Panel>
                  <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).NavigateCommand}"
                          CommandParameter="{Binding Key}" ToolTip.Tip="{Binding Title}">
                    <Panel>
                    <StackPanel Classes="navmini">
                      <Path Classes="icon" Data="{Binding Icon}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform"
                            StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Grid Classes="navgrid" ColumnDefinitions="32,*,Auto" Width="216" HorizontalAlignment="Left">
                      <Path Classes="icon" Data="{Binding Icon}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform"
                            StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Classes="navtitle" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <!-- Tally theme: the letter that opens the page from the Dashboard, in red -->
                      <TextBlock Grid.Column="1" Classes="navhot" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="{Binding TitleBefore, Mode=OneWay}" /><Run Text="{Binding TitleHot, Mode=OneWay}" Foreground="{DynamicResource NavHotKeyBrush}" FontWeight="Bold" /><Run Text="{Binding TitleAfter, Mode=OneWay}" />
                      </TextBlock>
                    </Grid>
                    </Panel>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>

      <!-- The page area: your own background picture (My Settings, this PC), or the theme's drawn scenery -->
      <Panel>
        <Image Name="BackgroundPicture" Source="{Binding BackgroundPicture}" Stretch="UniformToFill" IsVisible="{Binding HasBackgroundPicture}"
               IsHitTestVisible="False" />
        <Border Background="{DynamicResource PictureScrimBrush}" IsVisible="{Binding HasBackgroundPicture}" IsHitTestVisible="False" />
        <Path Name="HeroRays" Data="{x:Static ctl:ThemeArt.LightRays}" Fill="{DynamicResource RaysBrush}" Stretch="Fill"
              IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False" />
        <Panel Name="HeroCity" Height="230" VerticalAlignment="Bottom" IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False">
          <Path Data="{x:Static ctl:ThemeArt.CityFar}" Fill="{DynamicResource CityFarBrush}" Stretch="Fill" />
          <Path Data="{x:Static ctl:ThemeArt.CityNear}" Fill="{DynamicResource CityNearBrush}" Stretch="Fill" Height="150" VerticalAlignment="Bottom" />
        </Panel>
        <!-- Ocean, Midnight Stars: sky, sun / moon, and two layers at the foot -->
        <Panel Name="ThemeScene" IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False">
          <Path Data="{DynamicResource SkyArt}" Fill="{DynamicResource SkyArtBrush}" Stretch="Fill" Height="600" VerticalAlignment="Top" />
          <Path Data="{DynamicResource SunArt}" Fill="{DynamicResource SunArtBrush}" Stretch="Uniform" Width="120" Height="120"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,170,0" />
          <Panel Height="200" VerticalAlignment="Bottom">
            <Path Data="{DynamicResource FarArt}" Fill="{DynamicResource FarArtBrush}" Stretch="Fill" />
            <Path Data="{DynamicResource NearArt}" Fill="{DynamicResource NearArtBrush}" Stretch="Fill" />
          </Panel>
        </Panel>
        <Panel Name="PageArt" Height="200" VerticalAlignment="Bottom" IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False">
          <Path Data="{x:Static ctl:ThemeArt.FarMountains}" Fill="{DynamicResource PageArtFarBrush}" Stretch="Fill" />
          <Path Data="{x:Static ctl:ThemeArt.PineRidge}" Fill="{DynamicResource PageArtNearBrush}" Stretch="Fill" />
        </Panel>
        <DockPanel>
          <!-- Back / Forward and where you are -->
          <Border DockPanel.Dock="Top" Classes="crumbbar" Padding="20,10,20,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Name="BackButton" Classes="round" Content="‹" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{Binding BackToolTip}" />
              <Button Name="ForwardButton" Classes="round" Content="›" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                      ToolTip.Tip="{Binding ForwardToolTip}" />
              <Button Name="HomeButton" Classes="link" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Dashboard"
                      Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                <Path Data="M3,11 L12,3 L21,11 M5,9.5 L5,20 L10,20 L10,14 L14,14 L14,20 L19,20 L19,9.5" Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
              </Button>
              <TextBlock Text="›" Classes="muted" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" Margin="2,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:Crumb">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding IsCurrent}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Tally theme: the keys of the app on the right (click one, or press it); grey keys do nothing on this page -->
          <Border DockPanel.Dock="Right" Name="KeyBarPanel" Classes="keybar">
            <DockPanel>
              <Button DockPanel.Dock="Bottom" Classes="keyitem" Focusable="False" Click="OnEscKeyClick">
                <TextBlock><Run Text="Esc" FontWeight="Bold" /><Run Text=": Back / close" /></TextBlock>
              </Button>
              <ItemsControl Name="KeyBarList" ItemsSource="{Binding KeyBar}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyBarItem">
                    <Button Classes="keyitem" Focusable="False" IsEnabled="{Binding IsOn}" Click="OnKeyBarClick">
                      <TextBlock TextWrapping="Wrap"><Run Text="{Binding Keys, Mode=OneWay}" FontWeight="Bold" /><Run Text=": " /><Run Text="{Binding Label, Mode=OneWay}" /></TextBlock>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
          <TransitioningContentControl Name="PageHost" Classes="pages" Content="{Binding CurrentPage}" />
        </DockPanel>
      </Panel>
    </DockPanel>

    <!-- Short messages in the bottom-right corner ("Saved …", "PDF saved to …"); they fade after a few seconds -->
    <ItemsControl Name="ToastList" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,76">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:ToastItem">
          <Border Classes="toast" Classes.leaving="{Binding IsLeaving}" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,0" BoxShadow="0 6 20 0 #26000000" MaxWidth="460">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="M5,12.5 L10,17.5 L19,7" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource OkBrush}" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
              <Button Grid.Column="2" Classes="link" Margin="10,0,0,0" FontWeight="SemiBold" Content="{Binding ActionText}" IsVisible="{Binding HasAction}"
                      Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).ToastActionCommand}" CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The hidden XO game (Ctrl+Alt+Shift+X); Esc or ✕ closes it -->
    <Border Name="XoPanel" Background="#59000000" IsVisible="{Binding XoGame, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card" DataContext="{Binding XoGame}" x:DataType="vm:XoGameViewModel" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="20,16,20,20" BoxShadow="0 18 50 0 #4D000000" Background="{DynamicResource PopupBrush}" CornerRadius="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="XO" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Name="XoCloseButton" Grid.Column="1" Classes="round" Content="✕" ToolTip.Tip="Close (Esc)"
                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseXoCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding YouWins}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ActionBrush}" />
              <TextBlock Text="You (X)" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Draws}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="Draw" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ComputerWins}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E8590C" />
              <TextBlock Text="Computer (O)" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <ItemsControl Name="XoBoard" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3" Rows="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:XoCell">
                <Button Classes="xo" Classes.win="{Binding IsWin}" Height="96" Margin="4" HorizontalAlignment="Stretch" CornerRadius="10"
                        Background="{DynamicResource SubtleFillBrush}" BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].((vm:XoGameViewModel)DataContext).PlayCommand}" CommandParameter="{Binding}">
                  <Panel>
                    <TextBlock Text="X" IsVisible="{Binding IsX}" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource ActionBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="O" IsVisible="{Binding IsO}" FontSize="46" FontWeight="Bold" Foreground="#E8590C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Name="XoStatus" Text="{Binding Status}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button ctl:ButtonIcon.Kind="play" Classes="primary" Content="New game" Command="{Binding NewGameCommand}" />
            <Button ctl:ButtonIcon.Kind="restore" Content="Reset score" Command="{Binding ResetScoreCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Greetings (administrator switch): a card in the middle for a moment; it never blocks a click -->
    <Border Name="GreetingPanel" Background="#33000000" IsVisible="{Binding Greeting, Converter={x:Static ObjectConverters.IsNotNull}}" IsHitTestVisible="False">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,24" MinWidth="320" BoxShadow="0 18 50 0 #40000000"
              Background="{DynamicResource PopupBrush}" CornerRadius="18">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Name="GreetingArabic" Text="{Binding Greeting.Arabic, FallbackValue=''}" FlowDirection="RightToLeft" HorizontalAlignment="Center"
                     FontFamily="Segoe UI, Noto Naskh Arabic, Arial, sans-serif" FontSize="30" Foreground="{DynamicResource OkBrush}" />
          <TextBlock Name="GreetingEnglish" Text="{Binding Greeting.English, FallbackValue=''}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{Binding Greeting.Line, FallbackValue=''}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </Border>
    </Border>


    <!-- F1: every keyboard shortcut on one card (Esc or F1 closes it) -->
    <Border Name="ShortcutsPanel" Background="#59141C2D" IsVisible="{Binding ShowShortcuts}">
      <Border Classes="question" Width="1060" Padding="24,20">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="qicon" Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0">
              <Path Classes="qsym" Data="M2.5,6 L21.5,6 L21.5,18 L2.5,18 Z M6,10 L6.01,10 M9.5,10 L9.51,10 M13,10 L13.01,10 M16.5,10 L16.51,10 M6,14 L6.01,14 M18,14 L18.01,14 M9,14 L15,14" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Keyboard shortcuts" FontSize="19" FontWeight="Bold" />
              <TextBlock Text="Press F1 any time · Esc closes this" />
            </StackPanel>
            <Button Grid.Column="2" Name="CloseShortcutsButton" Classes="round" Command="{Binding ToggleShortcutsCommand}" ToolTip.Tip="Close (Esc)">
              <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,24,*,24,*"><StackPanel Grid.Column="0" Spacing="2"><TextBlock Classes="kshead" Text="Anywhere" /><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="F1" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="This list of shortcuts" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="F" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Search quotations" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Alt" /></Border><Border Classes="keycap"><TextBlock Text="←" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="Alt" /></Border><Border Classes="keycap"><TextBlock Text="→" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Back / forward" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Esc" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Go back, or close" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="F5" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Refresh the page" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="F9" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Sync changes with Tally" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><TextBlock Classes="kshead" Text="Lists: Today's, History, Drafts" /><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="↓" /></Border><TextBlock Classes="kssep" Text="then" /><Border Classes="keycap"><TextBlock Text="Enter" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Open a quotation" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="P" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Print the chosen quotation" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid></StackPanel><StackPanel Grid.Column="2" Spacing="2"><TextBlock Classes="kshead" Text="Quotation screen" /><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Alt" /></Border><Border Classes="keycap"><TextBlock Text="C" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="Insert" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Customer box" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Alt" /></Border><Border Classes="keycap"><TextBlock Text="I" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Add an item (Product box)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Enter" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Save the line" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="D" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Copy the line below" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="↑" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="↓" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Move the line up / down" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Alt" /></Border><Border Classes="keycap"><TextBlock Text="P" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="P&amp;F box" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="S" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Save" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="Enter" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Approve" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="N" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="Delete" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Clear (approved quotation)" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="PgUp" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="PgDn" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Previous / next quotation of the list" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="Shift" /></Border><Border Classes="keycap"><TextBlock Text="S" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Save as PDF" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="O" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Open PDF" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="W" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="WhatsApp" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="F11" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Preview" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="P" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Print" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid></StackPanel><StackPanel Grid.Column="4" Spacing="2"><TextBlock Classes="kshead" Text="Formater" /><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="G" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Next red problem line" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="E" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="Enter" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Approve" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Alt" /></Border><Border Classes="keycap"><TextBlock Text="P" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="P&amp;F box" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="F11" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Preview" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="P" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Print" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><TextBlock Classes="kshead" Text="Tally Connection" /><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Ctrl" /></Border><Border Classes="keycap"><TextBlock Text="T" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Test connection" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><TextBlock Classes="kshead" Text="Questions" /><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Enter" /></Border><TextBlock Classes="kssep" Text="/" /><Border Classes="keycap"><TextBlock Text="Y" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Yes / Save" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="N" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Don't save" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid><Grid ColumnDefinitions="150,*" Classes="ksrow"><WrapPanel VerticalAlignment="Center"><Border Classes="keycap"><TextBlock Text="Esc" /></Border></WrapPanel><TextBlock Grid.Column="1" Text="Cancel" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid></StackPanel></Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Unsaved changes: Save / Don't Save / Cancel (modern question box: round corners, a symbol, wide buttons) -->
    <Border Name="PromptPanel" Background="#59141C2D" IsVisible="{Binding PendingPrompt, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="question" Width="420">
        <StackPanel Spacing="12">
          <Border Classes="qicon">
            <Path Data="M6,3 L14,3 L19,8 L19,21 L6,21 Z M14,3 L14,8 L19,8 M9,13 L16,13 M9,17 L13,17" Classes="qsym" />
          </Border>
          <TextBlock Classes="qtitle" Text="{Binding PendingPrompt.Heading, FallbackValue='Unsaved changes'}" />
          <TextBlock Classes="qtext" Text="{Binding PendingPrompt.Message, FallbackValue=''}" />
          <Grid ColumnDefinitions="*,8,*,8,*" Margin="0,8,0,0">
            <Button Name="PromptDontSave" Classes="wide" Content="Don't Save" ToolTip.Tip="N" Command="{Binding AnswerPromptCommand}" CommandParameter="{x:Static svc:LeaveChoice.DontSave}" />
            <Button Grid.Column="2" Name="PromptCancel" Classes="wide" Content="Cancel" ToolTip.Tip="Esc: stay on this page" Command="{Binding AnswerPromptCommand}" CommandParameter="{x:Static svc:LeaveChoice.Cancel}" />
            <Button Grid.Column="4" Name="PromptSave" Classes="primary wide" Content="Save" ToolTip.Tip="Enter" Command="{Binding AnswerPromptCommand}" CommandParameter="{x:Static svc:LeaveChoice.Save}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Yes/No questions and inputs (delete, restore, seal PIN, log out …) -->
    <Border Name="DialogPanel" Background="#59141C2D" IsVisible="{Binding PendingDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="question" Width="420">
        <StackPanel Spacing="12">
          <Border Classes="qicon" Classes.stamp="{Binding PendingDialog.IsStamp, FallbackValue=False}">
            <Panel>
              <Path Data="M12,3 A9,9 0 1 1 11.99,3 Z M9.5,9.5 A2.5,2.5 0 1 1 13,11.8 C12.3,12.2 12,12.7 12,13.5 M12,17 L12,17.1" Classes="qsym"
                    IsVisible="{Binding !PendingDialog.IsStamp, FallbackValue=True}" />
              <!-- The seal PIN: a rubber stamp pressing its red mark -->
              <Ellipse Fill="{DynamicResource StampCircleBrush}" IsVisible="{Binding PendingDialog.IsStamp, FallbackValue=False}" />
              <Viewbox Name="SealStampIcon" Width="46" Height="46" IsVisible="{Binding PendingDialog.IsStamp, FallbackValue=False}">
                <Canvas Width="64" Height="64">
                  <Path Data="M32,6 A7.5,7.5 0 1 1 31.99,6 Z" Fill="#7A5536" />
                  <Path Data="M28,19 L36,19 L37.5,32 L26.5,32 Z" Fill="#7A5536" />
                  <Path Data="M15,32 L49,32 Q51,32 51,34 L51,40 L13,40 L13,34 Q13,32 15,32 Z" Fill="#3B3F46" />
                  <Path Data="M15,40 L49,40 L49,44 L15,44 Z" Fill="#C62828" />
                  <Path Data="M12,52 L52,52 M18,57 L46,57" Stroke="#C62828" StrokeThickness="3" StrokeLineCap="Round" />
                </Canvas>
              </Viewbox>
            </Panel>
          </Border>
          <TextBlock Classes="qtitle" Text="{Binding PendingDialog.Title, FallbackValue=''}" />
          <TextBlock Classes="qtext" Text="{Binding PendingDialog.Message, FallbackValue=''}"
                     IsVisible="{Binding PendingDialog.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
          <StackPanel Spacing="4" IsVisible="{Binding PendingDialog.HasInput, FallbackValue=False}">
            <TextBlock Classes="label" Text="{Binding PendingDialog.InputLabel, FallbackValue=''}" />
            <TextBox Name="DialogInput" Text="{Binding PendingDialog.Input, FallbackValue=''}" PasswordChar="{Binding PendingDialog.SecretChar}" MaxLength="40" />
          </StackPanel>
          <Grid ColumnDefinitions="*,10,*" Margin="0,8,0,0">
            <Button Name="DialogSecondary" Classes="wide" Content="{Binding PendingDialog.SecondaryText, FallbackValue=''}" Command="{Binding AnswerDialogCommand}">
              <Button.CommandParameter><x:Boolean>False</x:Boolean></Button.CommandParameter>
            </Button>
            <Button Grid.Column="2" Name="DialogPrimary" Classes="primary wide" Content="{Binding PendingDialog.PrimaryText, FallbackValue=''}" Command="{Binding AnswerDialogCommand}">
              <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
            </Button>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
