<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,14,18,8">
      <TextBlock Classes="h1" Text="Products" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="round" Command="{Binding MoreCommand}"><TextBlock Text="{Binding Initial}" FontWeight="Bold" /></Button>
    </Grid>
    <TextBox DockPanel.Dock="Top" Name="SearchBox" Text="{Binding Search}" Watermark="Name, part number, brand…" Margin="16,0,16,8">
      <TextBox.InnerLeftContent>
        <Path Classes="icon" Data="{x:Static m:PhoneIcons.Search}" Stroke="{DynamicResource MutedBrush}" Margin="14,0,0,0" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" Margin="18,0" />
    <Panel>
      <ScrollViewer>
        <StackPanel Margin="16,4,16,20" Spacing="10">
          <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ItemsControl Name="ProductList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProductRow">
                <Button Classes="cardbtn" Classes.open="{Binding IsOpen}"
                        Command="{Binding $parent[ItemsControl].((vm:ProductsViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding}">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Sub}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding RateText}" FontWeight="Bold" VerticalAlignment="Bottom" Margin="10,0,0,0" />
                    </Grid>
                    <Grid ColumnDefinitions="110,*" Margin="0,10,0,0" IsVisible="{Binding IsOpen}">
                      <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Info}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:InfoRow">
                            <Grid ColumnDefinitions="110,*" Margin="0,3">
                              <TextBlock Classes="label" Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding NothingTyped}">
        <Path Data="{x:Static m:PhoneIcons.Box}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeJoin="Round" Width="40" Height="40"
              Stretch="Uniform" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Type to find a product" HorizontalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="muted" Text="Nothing found" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
    </Panel>
  </DockPanel>
</UserControl>
