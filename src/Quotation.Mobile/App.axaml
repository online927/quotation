          <SolidColorBrush x:Key="CalendarViewOutOfScopeBackground">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBackground">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="CalendarViewCalendarItemRevealBorderBrush">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="CalendarViewBorderBrush">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="CalendarViewOutOfScopeForeground">#A8B0BD</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchFillOff">#CFD6E0</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver">#C3CBD7</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchFillOffPressed">#B8C1CE</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff">Transparent</SolidColorBrush>
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver">Transparent</SolidColorBrush>
