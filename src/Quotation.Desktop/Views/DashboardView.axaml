<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Styles>
    <Style Selector="Border.healthwarn">
      <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="40" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="24,16,24,24" Spacing="18" MaxWidth="1200" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <ctl:PageTitle Text="Dashboard" Icon="dashboard" />
          <TextBlock Classes="muted" Text="Today at a glance" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding LoadCommand}" HotKey="F5" ToolTip.Tip="Refresh (F5)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M20,11 A8,8 0 1 0 17.7,16.6 M20,4 L20,11 L13,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />

      <!-- Administrators: things to fix before they become a problem -->
      <ItemsControl Name="HealthWarnings" ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="c:HealthWarningDto">
            <Border Classes="healthwarn" Classes.bad="{Binding IsBad}" Padding="14,9" CornerRadius="{DynamicResource ButtonRadius}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Data="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,17 L12,17.2" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.9"
                      StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <UniformGrid Columns="4">
        <Button Classes="tile" HorizontalContentAlignment="Stretch" Margin="0,0,14,0" Command="{Binding GoCommand}" CommandParameter="today">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="TODAY'S QUOTATIONS" VerticalAlignment="Center" />
              <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SubtleFillBrush}">
                <Path Data="{x:Static vm:NavIcons.Today}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <TextBlock Classes="big" Foreground="{DynamicResource AccentBrush}" Text="{Binding Data.TodaysQuotations, FallbackValue='–'}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" HorizontalContentAlignment="Stretch" Margin="0,0,14,0" Command="{Binding GoCommand}" CommandParameter="drafts">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="DRAFTS" VerticalAlignment="Center" />
              <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SubtleFillBrush}">
                <Path Data="{x:Static vm:NavIcons.Drafts}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <TextBlock Classes="big" Text="{Binding Data.Drafts, FallbackValue='–'}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" HorizontalContentAlignment="Stretch" Margin="0,0,14,0" Command="{Binding GoCommand}" CommandParameter="drafts">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="PENDING REVIEW" VerticalAlignment="Center" />
              <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SubtleFillBrush}">
                <Path Data="{x:Static vm:NavIcons.History}" Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <TextBlock Classes="big" Foreground="{DynamicResource OrangeBrush}" Text="{Binding Data.PendingReview, FallbackValue='–'}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" HorizontalContentAlignment="Stretch" Command="{Binding GoCommand}" CommandParameter="inbox">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="eyebrow" Text="AI INBOX — NEEDS ATTENTION" VerticalAlignment="Center" />
              <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SubtleFillBrush}">
                <Path Data="{x:Static vm:NavIcons.Inbox}" Stroke="{DynamicResource PurpleBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <TextBlock Classes="big" Foreground="{DynamicResource PurpleBrush}" Text="{Binding Data.InboxNeedsAttention, FallbackValue='–'}" />
          </StackPanel>
        </Button>
      </UniformGrid>

      <Button Classes="tile" Name="FollowUpTile" HorizontalContentAlignment="Stretch" Command="{Binding GoCommand}" CommandParameter="followup"
              IsVisible="{Binding ShowFollowUp}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="eyebrow" Text="TO FOLLOW UP" />
            <TextBlock Classes="muted" FontSize="12" Text="Approved quotations whose follow-up date has come — call the customer, then mark Won or Lost." />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="big" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource TealBrush}"
                     Text="{Binding Data.FollowUpDue, FallbackValue='–'}" />
        </Grid>
      </Button>

      <Border Classes="card">
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Margin" Value="0,5" />
            </Style>
          </Grid.Styles>
          <TextBlock Classes="h2" Grid.ColumnSpan="2" Text="Connections" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Classes="label" Text="Tally" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TallyText}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="2" Classes="label" Text="Tally company" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Data.Status.TallyCompany, FallbackValue='–', TargetNullValue='–'}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Active financial year" />
          <TextBlock Grid.Row="3" Grid.Column="1">
            <Run Text="{Binding Data.Status.ActiveFinancialYear, FallbackValue='–', Mode=OneWay}" />
            <Run Text="  (source: " Foreground="{DynamicResource MutedBrush}" />
            <Run Text="{Binding Data.Status.ActiveFinancialYearSource, FallbackValue='', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
            <Run Text=")" Foreground="{DynamicResource MutedBrush}" />
          </TextBlock>
          <TextBlock Grid.Row="4" Classes="label" Text="Last sync" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastSyncText}" />
          <TextBlock Grid.Row="5" Classes="label" Text="Products / Customers" />
          <TextBlock Grid.Row="5" Grid.Column="1">
            <Run Text="{Binding Data.Status.ProductCount, FallbackValue='–', Mode=OneWay}" />
            <Run Text=" / " />
            <Run Text="{Binding Data.Status.CustomerCount, FallbackValue='–', Mode=OneWay}" />
          </TextBlock>
          <TextBlock Grid.Row="6" Classes="label" Text="Gmail" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GmailText}" />
          <TextBlock Grid.Row="7" Classes="label" Text="Claude AI" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AiText}" />
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
