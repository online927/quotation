<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="pagehead" Padding="18,14,18,6">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel>
        <TextBlock Classes="h1" Text="Dashboard" />
        <TextBlock Classes="muted" Text="Today at a glance" />
      </StackPanel>
      <Button Grid.Column="1" Classes="round" Margin="0,0,8,0" Command="{Binding RefreshCommand}">
        <Path Classes="icon" Data="{x:Static m:PhoneIcons.Refresh}" Width="16" Height="16" />
      </Button>
      <Button Grid.Column="2" Classes="round" Command="{Binding MoreCommand}"><TextBlock Text="{Binding Initial}" FontWeight="Bold" /></Button>
    </Grid>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" Margin="18,0" />
    <ScrollViewer>
      <StackPanel Margin="16,8,16,20" Spacing="12">
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto">
          <Button Name="TodayTile" Classes="cardbtn tile" Command="{Binding GoCommand}" CommandParameter="today">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="eyebrow" Text="TODAY'S" VerticalAlignment="Center" />
                <Path Grid.Column="1" Classes="icon" Data="{x:Static m:PhoneIcons.Clock}" Stroke="{DynamicResource AccentBrush}" />
              </Grid>
              <TextBlock Classes="big" Foreground="{DynamicResource AccentBrush}" Text="{Binding Data.TodaysQuotations, FallbackValue='–'}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Name="DraftsTile" Classes="cardbtn tile" Command="{Binding GoCommand}" CommandParameter="drafts">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="eyebrow" Text="DRAFTS" VerticalAlignment="Center" />
                <Path Grid.Column="1" Classes="icon" Data="{x:Static m:PhoneIcons.File}" Stroke="{DynamicResource TextBrush}" />
              </Grid>
              <TextBlock Classes="big" Text="{Binding Data.Drafts, FallbackValue='–'}" />
            </StackPanel>
          </Button>
          <Button Grid.Row="2" Classes="cardbtn tile" Command="{Binding GoCommand}" CommandParameter="drafts">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="eyebrow" Text="PENDING REVIEW" VerticalAlignment="Center" />
                <Path Grid.Column="1" Classes="icon" Data="{x:Static m:PhoneIcons.Clock}" Stroke="{DynamicResource OrangeBrush}" />
              </Grid>
              <TextBlock Classes="big" Foreground="{DynamicResource OrangeBrush}" Text="{Binding Data.PendingReview, FallbackValue='–'}" />
            </StackPanel>
          </Button>
          <Border Grid.Row="2" Grid.Column="2" Classes="card tile">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="eyebrow" Text="AI INBOX" VerticalAlignment="Center" />
                <Path Grid.Column="1" Classes="icon" Data="{x:Static m:PhoneIcons.Sparkle}" Stroke="{DynamicResource PurpleBrush}" />
              </Grid>
              <TextBlock Classes="big" Foreground="{DynamicResource PurpleBrush}" Text="{Binding Data.InboxNeedsAttention, FallbackValue='–'}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="h2" Grid.ColumnSpan="2" Text="Connections" />
            <TextBlock Grid.Row="1" Classes="label" Text="Tally" VerticalAlignment="Center" />
            <Border Grid.Row="1" Grid.Column="1" Name="TallyChip" Classes="chip" Classes.ok="{Binding TallyOk}" Classes.bad="{Binding !TallyOk}">
              <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding TallyText}" /></StackPanel>
            </Border>
            <TextBlock Grid.Row="2" Classes="label" Text="Last sync" />
            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding LastSync}" />
            <TextBlock Grid.Row="3" Classes="label" Text="Gmail" VerticalAlignment="Center" />
            <Border Grid.Row="3" Grid.Column="1" Name="GmailChip" Classes="chip" Classes.ok="{Binding GmailOk}" Classes.bad="{Binding !GmailOk}">
              <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding GmailText}" /></StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Latest" Margin="0,0,0,6" />
            <ItemsControl Name="LatestList" ItemsSource="{Binding Latest}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuotationRow">
                  <Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,6" MinHeight="36"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " />
                        <Run Text="{Binding Customer, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding ShortTotal}" Margin="10,0,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
