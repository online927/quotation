<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:c="using:Quotation.Contracts"
             x:Class="Quotation.Desktop.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <DockPanel Margin="24,12,24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ctl:PageTitle Text="Diagnostics" Icon="diagnostics" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Backup database now" Command="{Binding BackupCommand}" />
        <Button Name="ExportButton" Content="Export everything" Command="{Binding ExportCommand}"
                ToolTip.Tip="One file (.tsq) with the database, PDFs, seal and logo, saved in Documents. Use it to move the server to another PC." />
        <Button Name="RestoreButton" Content="Restore from backup file…" Click="OnRestoreClick"
                ToolTip.Tip="Replace the server's data with a .tsq export or a .db backup (the current data is backed up first)." />
        <Button HotKey="F5" Command="{Binding LoadCommand}" ToolTip.Tip="Refresh (F5)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M20,11 A8,8 0 1 0 17.7,16.6 M20,4 L20,11 L13,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <ctl:ErrorBanner DockPanel.Dock="Top" Text="{Binding ErrorMessage}" />
    <TabControl>
      <TabItem Header="System">
        <Border Classes="card" Margin="0,8" VerticalAlignment="Top">
          <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Classes="label" Text="Server version" />
            <TextBlock Grid.Column="1" Text="{Binding Info.ServerVersion, FallbackValue=''}" />
            <TextBlock Grid.Row="1" Classes="label" Text="Server runtime / OS" />
            <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap">
              <Run Text="{Binding Info.Runtime, FallbackValue='', Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Info.OperatingSystem, FallbackValue='', Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{Binding Info.MachineName, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="2" Classes="label" Text="This PC" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClientInfo}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="label" Text="Data directory" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Info.DataDirectory, FallbackValue=''}" />
            <TextBlock Grid.Row="4" Classes="label" Text="Database size" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DatabaseSize}" />
            <TextBlock Grid.Row="5" Classes="label" Text="Products / customers" />
            <TextBlock Grid.Row="5" Grid.Column="1">
              <Run Text="{Binding Info.Products, FallbackValue='', Mode=OneWay}" />
              <Run Text=" / " />
              <Run Text="{Binding Info.Customers, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="6" Classes="label" Text="Quotations / PDFs" />
            <TextBlock Grid.Row="6" Grid.Column="1">
              <Run Text="{Binding Info.Quotations, FallbackValue='', Mode=OneWay}" />
              <Run Text=" / " />
              <Run Text="{Binding Info.PdfFiles, FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="7" Classes="label" Text="Tally" />
            <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap">
              <Run Text="{Binding Info.Status.TallyConnected, StringFormat='Connected: {0}', FallbackValue='', Mode=OneWay}" />
              <Run Text="  " />
              <Run Text="{Binding Info.Status.TallyError, FallbackValue='', Mode=OneWay}" Foreground="{DynamicResource BadBrush}" />
            </TextBlock>
            <TextBlock Grid.Row="8" Classes="label" Text="Gmail / Claude AI" />
            <TextBlock Grid.Row="8" Grid.Column="1">
              <Run Text="{Binding Info.Status.GmailConnected, StringFormat='Gmail connected: {0}', FallbackValue='', Mode=OneWay}" />
              <Run Text="   " />
              <Run Text="{Binding Info.Status.AiConfigured, StringFormat='AI configured: {0}', FallbackValue='', Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="9" Classes="label" Text="Log files" VerticalAlignment="Top" />
            <ItemsControl Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Info.LogFiles, FallbackValue={x:Null}}" />
          </Grid>
        </Border>
      </TabItem>
      <TabItem Header="Audit log">
        <DockPanel Margin="0,8">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,6">
            <TextBox Text="{Binding AuditFilter}" Watermark="Filter by action, user or details" />
            <Button Grid.Column="2" Content="Apply" Command="{Binding LoadAuditCommand}" />
          </Grid>
          <ListBox ItemsSource="{Binding Audit}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="c:AuditEntryDto">
                <Grid ColumnDefinitions="150,170,110,120,*">
                  <TextBlock Text="{Binding AtUtc, StringFormat='{}{0:dd-MMM-yyyy HH:mm:ss}'}" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding User}" FontSize="11" />
                  <TextBlock Grid.Column="3" Text="{Binding Machine}" FontSize="11" />
                  <TextBlock Grid.Column="4" FontSize="11" TextWrapping="Wrap">
                    <Run Text="{Binding EntityType, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding EntityId, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding Details, Mode=OneWay}" />
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Slow requests">
        <DockPanel Margin="0,8">
          <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                     Text="Requests that took longer than 1 second (last 500). Total = on the user's PC, from click to answer; Server = the server's own time. Total slow but Server quick means the network or finding the server PC; Server slow means the server PC was busy." />
          <Border DockPanel.Dock="Top" Classes="tablehead">
            <Grid ColumnDefinitions="120,170,150,70,70,150,*">
              <TextBlock Text="When" />
              <TextBlock Grid.Column="1" Text="PC / User" />
              <TextBlock Grid.Column="2" Text="What" />
              <TextBlock Grid.Column="3" Text="Total" />
              <TextBlock Grid.Column="4" Text="Server" />
              <TextBlock Grid.Column="5" Text="Server busy with" />
              <TextBlock Grid.Column="6" Text="Likely cause" />
            </Grid>
          </Border>
          <ListBox Classes="table" ItemsSource="{Binding SlowRequests}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SlowRequestRow">
                <Grid ColumnDefinitions="120,170,150,70,70,150,*">
                  <TextBlock Text="{Binding When}" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding Who}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding What}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding Total}" FontSize="11" />
                  <TextBlock Grid.Column="4" Text="{Binding Server}" FontSize="11" />
                  <TextBlock Grid.Column="5" Text="{Binding Busy}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="6" Text="{Binding Cause}" FontSize="11" Foreground="{DynamicResource WarnBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Server log">
        <TextBox Margin="0,8" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="NoWrap" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
