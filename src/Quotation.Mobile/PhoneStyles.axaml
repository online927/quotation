<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The phone's look: big touch targets, white rounded cards, soft filled boxes, one accent colour (from the theme). -->

  <Style Selector=":is(TopLevel)">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
  </Style>
  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.info">
    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>

  <!-- Buttons: soft filled, rounded, at least 44 high for a thumb -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.whatsapp">
    <Setter Property="Background" Value="#25D366" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.whatsapp:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1EBE5A" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <!-- A whole card that can be tapped (a quotation, a product, a customer) -->
  <Style Selector="Button.cardbtn">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.cardbtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>
  <Style Selector="Button.cardbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
  </Style>
  <Style Selector="Button.cardbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
  </Style>
  <Style Selector="Button.cardbtn.open">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.cardbtn.open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <!-- Round icon buttons (back, user) -->
  <Style Selector="Button.round">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
  </Style>

  <!-- Typing boxes: soft filled, rounded, accent edge while typing -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="TextBox.message">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Border.chip Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Margin" Value="0,0,5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.ok"><Setter Property="Background" Value="{DynamicResource PillOkBrush}" /></Style>
  <Style Selector="Border.chip.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}" /></Style>
  <Style Selector="Border.chip.ok Ellipse"><Setter Property="Fill" Value="{DynamicResource GreenBrush}" /></Style>
  <Style Selector="Border.chip.bad"><Setter Property="Background" Value="{DynamicResource PillBadBrush}" /></Style>
  <Style Selector="Border.chip.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource BadBrush}" /></Style>
  <Style Selector="Border.chip.bad Ellipse"><Setter Property="Fill" Value="{DynamicResource BadBrush}" /></Style>
  <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{DynamicResource PillPendingBrush}" /></Style>
  <Style Selector="Border.chip.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource OrangeBrush}" /></Style>
  <Style Selector="Border.chip.warn Ellipse"><Setter Property="Fill" Value="{DynamicResource OrangeBrush}" /></Style>

  <!-- Pill tabs (Today / History / Drafts) -->
  <Style Selector="Border.pillbar">
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="RadioButton.seg">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="seg" Background="Transparent" CornerRadius="10" Padding="8,9">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#seg">
    <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
    <Setter Property="BoxShadow" Value="0 1 4 0 #24000000" />
  </Style>

  <!-- Bottom menu -->
  <Style Selector="Border.bottomnav">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="4,6,4,8" />
  </Style>
  <Style Selector="RadioButton.nav">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="0,4">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.nav Path">
    <Setter Property="Stroke" Value="{Binding $parent[RadioButton].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="RadioButton.nav TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- Line symbols in buttons and cards -->
  <Style Selector="Path.icon">
    <Setter Property="StrokeThickness" Value="1.9" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{Binding $parent[ContentControl].Foreground}" />
  </Style>

  <!-- The badge with the company letters -->
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A thin line between rows of a card -->
  <Style Selector="Border.sep">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Margin" Value="0,8" />
  </Style>
  <!-- Yes / No question box -->
  <Style Selector="Border.question">
    <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="BoxShadow" Value="0 18 44 0 #470F172A" />
  </Style>
  <Style Selector="TextBlock.qtitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ===== The Tally theme (MainView has the class "tally"): like TallyPrime — square boxes with thin lines, dark
       blue-green heading bars, the chosen tab and list in a yellow bar ===== -->
  <Style Selector=".tally Border.pagehead">
    <Setter Property="Background" Value="{DynamicResource TopBarBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector=".tally Border.pagehead TextBlock"><Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}" /></Style>
  <Style Selector=".tally Border.pagehead TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TopBarMutedBrush}" /></Style>
  <Style Selector=".tally Border.pagehead Button.round">
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector=".tally Border.pagehead Button.round.primary">
    <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
  </Style>
  <Style Selector=".tally Border.card">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".tally Button"><Setter Property="CornerRadius" Value="2" /></Style>
  <Style Selector=".tally Button.round"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector=".tally Button.cardbtn">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=".tally Button.cardbtn.open"><Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" /></Style>
  <Style Selector=".tally Button.cardbtn.open:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
  </Style>
  <Style Selector=".tally TextBox"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector=".tally Border.chip"><Setter Property="CornerRadius" Value="2" /></Style>
  <Style Selector=".tally Border.badge"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector=".tally Border.pillbar"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector=".tally RadioButton.seg /template/ Border#seg"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector=".tally RadioButton.seg:checked"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector=".tally RadioButton.seg:checked /template/ Border#seg">
    <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector=".tally Border.bottomnav">
    <Setter Property="Background" Value="{DynamicResource KeyBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
  </Style>
  <Style Selector=".tally RadioButton.nav:checked">
    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
  </Style>
  <!-- Dashboard number boxes: a dark heading strip -->
  <Style Selector=".tally Button.tile"><Setter Property="Padding" Value="0" /></Style>
  <Style Selector=".tally Border.tile"><Setter Property="Padding" Value="0" /></Style>
  <Style Selector=".tally .tile Path.icon"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector=".tally .tile TextBlock.eyebrow">
    <Setter Property="Background" Value="{DynamicResource TallyHeadBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector=".tally .tile TextBlock.big"><Setter Property="Padding" Value="10,0,10,6" /></Style>
  <Style Selector=".tally Border.question">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="{DynamicResource TopBarBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
