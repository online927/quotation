<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.QuotationListView"
             x:DataType="vm:QuotationListViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.won"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}" /></Style>
    <Style Selector="TextBlock.lost"><Setter Property="Foreground" Value="{DynamicResource BadBrush}" /></Style>
  </UserControl.Styles>
  <DockPanel Margin="24,12,24,20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ctl:PageTitle Text="{Binding Title}" Icon="{Binding IconKey}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button HotKey="F5" Command="{Binding LoadCommand}" ToolTip.Tip="Refresh (F5)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M20,11 A8,8 0 1 0 17.7,16.6 M20,4 L20,11 L13,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <Button Name="NewDocButton" Classes="primary" Command="{Binding NewCommand}" IsVisible="{Binding ShowNew}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="{Binding NewButtonText}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto,8,200">
        <TextBox Name="SearchBox" Text="{Binding Query}" Watermark="Search quotation number, customer, GSTIN, product, reference…" />
        <ComboBox Grid.Column="1" Name="OutcomeFilterBox" Margin="8,0,0,0" Width="150" IsVisible="{Binding ShowOutcomeFilter}"
                  ItemsSource="{x:Static vm:QuotationListViewModel.OutcomeFilters}" SelectedItem="{Binding OutcomeFilter}" />
        <ComboBox Grid.Column="3" Name="TypeFilterBox" IsVisible="{Binding ShowTypeFilter}" ItemsSource="{x:Static vm:QuotationListViewModel.TypeFilters}" SelectedItem="{Binding TypeFilter}" HorizontalAlignment="Stretch" />
      </Grid>
      <TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" />
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Classes="tablehead">
      <Grid ColumnDefinitions="120,80,100,*,*,110,100,90,70,90,Auto">
        <TextBlock FontWeight="SemiBold" Text="Number" />
        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Type" />
        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Date" />
        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Customer" />
        <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Item" />
        <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Total" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Status" Margin="10,0,0,0" />
        <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="Outcome" IsVisible="{Binding TrackOutcomes}" />
        <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="Source" />
        <TextBlock Grid.Column="9" FontWeight="SemiBold" Text="By" />
        <Panel Grid.Column="10" Width="{Binding ActionsWidth}" />
      </Grid>
    </Border>
    <Panel>
    <!-- While the list loads the first time: grey placeholder rows (U7) -->
    <ItemsControl Name="Skeleton" ItemsSource="{Binding SkeletonRows}" IsVisible="{Binding ShowSkeleton}" Margin="0,6,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="120,80,100,*,*,110" Margin="12,9">
            <Border Classes="skeleton" Width="80" />
            <Border Grid.Column="1" Classes="skeleton" Width="50" />
            <Border Grid.Column="2" Classes="skeleton" Width="70" />
            <Border Grid.Column="3" Classes="skeleton" Width="160" />
            <Border Grid.Column="4" Classes="skeleton" Width="120" />
            <Border Grid.Column="5" Classes="skeleton" Width="70" HorizontalAlignment="Right" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- Nothing to show: a friendly note (U5) -->
    <StackPanel Name="EmptyNote" IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,-40,0,0">
      <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
        <Path Data="{Binding EmptyIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
              Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Classes="muted" Text="{Binding EmptyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
    </StackPanel>
    <ListBox Classes="table" Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsVisible="{Binding ShowList}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:QuotationRow">
          <Grid ColumnDefinitions="120,80,100,*,*,110,100,90,70,90,Auto" Background="Transparent">
            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="doctype" Classes.proforma="{Binding IsProforma}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Date}" />
            <TextBlock Grid.Column="3" Text="{Binding Customer}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding Item}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
            <TextBlock Grid.Column="5" Text="{Binding Total}" HorizontalAlignment="Right" />
            <Border Grid.Column="6" Classes="pill" Classes.ok="{Binding IsFinal}" Classes.pending="{Binding IsPending}" Classes.bad="{Binding IsCancelled}"
                    Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <TextBlock Grid.Column="7" Text="{Binding Outcome}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" Classes.won="{Binding IsWon}" Classes.lost="{Binding IsLost}"
                       IsVisible="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).TrackOutcomes}" />
            <TextBlock Grid.Column="8" Text="{Binding Source}" />
            <TextBlock Grid.Column="9" Text="{Binding CreatedBy}" />
            <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                        Width="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).ActionsWidth}">
              <Button Classes="small" Name="FollowUpWhatsAppButton" ToolTip.Tip="Follow up on WhatsApp: copies the PDF and opens the customer's chat with the follow-up message (then Ctrl+V, Enter)"
                      IsVisible="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).ShowFollowUpWhatsApp}"
                      Command="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).FollowUpWhatsAppCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Data="M3,21 L4.6,16.4 A9,9 0 1 1 7.7,19.4 Z M9,8.5 C9,8 9.4,7.6 9.9,7.6 L10.6,7.6 L11.6,10 L10.8,11 C11.4,12.3 12.4,13.3 13.7,13.9 L14.7,13.1 L17,14.1 L17,14.8 C17,15.3 16.6,15.7 16.1,15.7 C12.2,15.7 9,12.5 9,8.5 Z"
                        Stroke="#1FA855" StrokeThickness="1.6" StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Content="Open" Classes="small"
                      Command="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
              <Button Content="Duplicate" Classes="small" IsVisible="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).MakesDocuments}"
                      Command="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).DuplicateCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
