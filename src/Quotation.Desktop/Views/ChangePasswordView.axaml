<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">
  <Border Classes="card" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
    <StackPanel Spacing="10">
      <TextBlock Classes="h2" Text="{Binding Heading}" TextWrapping="Wrap" />
      <TextBlock Classes="label" Text="Current password" />
      <TextBox Text="{Binding CurrentPassword}" PasswordChar="●" />
      <TextBlock Classes="label" Text="New password (min. 6 characters)" />
      <TextBox Text="{Binding NewPassword}" PasswordChar="●" />
      <TextBlock Classes="label" Text="Confirm new password" />
      <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding !Forced}" />
        <Button Classes="primary" Content="Save password" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
