<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="40" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="24,16,24,24" Spacing="18" MaxWidth="1200" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="h1" Text="Dashboard" />
          <TextBlock Classes="muted" Text="Today at a glance" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Refresh (F5)" Command="{Binding LoadCommand}" HotKey="F5" />
          <Button Content="New Proforma Invoice" Command="{Binding GoCommand}" CommandParameter="newproforma" />
          <Button Classes="primary" Content="New Quotation (Ctrl+N)" Command="{Binding GoCommand}" CommandParameter="new" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <UniformGrid Columns="4">
        <Button Classes="tile" Margin="0,0,14,0" Command="{Binding GoCommand}" CommandParameter="today">
          <StackPanel>
            <TextBlock Classes="eyebrow" Text="TODAY'S QUOTATIONS" />
            <TextBlock Classes="big" Text="{Binding Data.TodaysQuotations, FallbackValue='–'}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Margin="0,0,14,0" Command="{Binding GoCommand}" CommandParameter="drafts">
          <StackPanel>
            <TextBlock Classes="eyebrow" Text="DRAFTS" />
            <TextBlock Classes="big" Text="{Binding Data.Drafts, FallbackValue='–'}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Margin="0,0,14,0" Command="{Binding GoCommand}" CommandParameter="drafts">
          <StackPanel>
            <TextBlock Classes="eyebrow" Text="PENDING REVIEW" />
            <TextBlock Classes="big" Text="{Binding Data.PendingReview, FallbackValue='–'}" />
          </StackPanel>
        </Button>
        <Button Classes="tile" Command="{Binding GoCommand}" CommandParameter="inbox">
          <StackPanel>
            <TextBlock Classes="eyebrow" Text="AI INBOX — NEEDS ATTENTION" />
            <TextBlock Classes="big" Foreground="{StaticResource AccentBrush}" Text="{Binding Data.InboxNeedsAttention, FallbackValue='–'}" />
          </StackPanel>
        </Button>
      </UniformGrid>

      <Border Classes="card">
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Margin" Value="0,5" />
            </Style>
          </Grid.Styles>
          <TextBlock Classes="h2" Grid.ColumnSpan="2" Text="Connections" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Classes="label" Text="Tally" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TallyText}" FontWeight="SemiBold" />
          <TextBlock Grid.Row="2" Classes="label" Text="Tally company" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Data.Status.TallyCompany, FallbackValue='–', TargetNullValue='–'}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Active financial year" />
          <TextBlock Grid.Row="3" Grid.Column="1">
            <Run Text="{Binding Data.Status.ActiveFinancialYear, FallbackValue='–', Mode=OneWay}" />
            <Run Text="  (source: " Foreground="{StaticResource MutedBrush}" />
            <Run Text="{Binding Data.Status.ActiveFinancialYearSource, FallbackValue='', Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
            <Run Text=")" Foreground="{StaticResource MutedBrush}" />
          </TextBlock>
          <TextBlock Grid.Row="4" Classes="label" Text="Last sync" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastSyncText}" />
          <TextBlock Grid.Row="5" Classes="label" Text="Products / Customers" />
          <TextBlock Grid.Row="5" Grid.Column="1">
            <Run Text="{Binding Data.Status.ProductCount, FallbackValue='–', Mode=OneWay}" />
            <Run Text=" / " />
            <Run Text="{Binding Data.Status.CustomerCount, FallbackValue='–', Mode=OneWay}" />
          </TextBlock>
          <TextBlock Grid.Row="6" Classes="label" Text="Gmail" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GmailText}" />
          <TextBlock Grid.Row="7" Classes="label" Text="Claude AI" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding AiText}" />
        </Grid>
      </Border>

      <WrapPanel>
        <Button Margin="0,0,8,8" Content="AI Inbox" Command="{Binding GoCommand}" CommandParameter="inbox" />
        <Button Margin="0,0,8,8" Content="Draft Quotations" Command="{Binding GoCommand}" CommandParameter="drafts" />
        <Button Margin="0,0,8,8" Content="Quotation History" Command="{Binding GoCommand}" CommandParameter="history" />
        <Button Margin="0,0,8,8" Content="Proforma Invoices" Command="{Binding GoCommand}" CommandParameter="proforma" />
        <Button Margin="0,0,8,8" Content="Tally Connection" Command="{Binding GoCommand}" CommandParameter="tally" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
