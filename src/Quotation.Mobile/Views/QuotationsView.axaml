<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.QuotationsView"
             x:DataType="vm:QuotationsViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="18,14,18,8">
      <TextBlock Classes="h1" Text="Quotations" VerticalAlignment="Center" />
      <Button Grid.Column="1" Name="NewFromMessageButton" Classes="round primary" Margin="0,0,8,0" Command="{Binding NewFromMessageCommand}"
              IsVisible="{Binding MakesDocuments}">
        <Path Classes="icon" Data="{x:Static m:PhoneIcons.Plus}" Width="16" Height="16" />
      </Button>
      <Button Grid.Column="2" Classes="round" Command="{Binding MoreCommand}"><TextBlock Text="{Binding Initial}" FontWeight="Bold" /></Button>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Margin="16,0,16,8" Spacing="10">
      <TextBox Name="SearchBox" Text="{Binding Search}" Watermark="Number, customer, GSTIN, item…">
        <TextBox.InnerLeftContent>
          <Path Classes="icon" Data="{x:Static m:PhoneIcons.Search}" Stroke="{DynamicResource MutedBrush}" Margin="14,0,0,0" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Border Classes="pillbar">
        <UniformGrid Columns="3">
          <RadioButton Name="TodayTab" Classes="seg" GroupName="qlist" Content="Today" IsChecked="{Binding IsToday}" />
          <RadioButton Name="HistoryTab" Classes="seg" GroupName="qlist" Content="History" IsChecked="{Binding IsHistory}" />
          <RadioButton Name="DraftsTab" Classes="seg" GroupName="qlist" Content="Drafts" IsChecked="{Binding IsDrafts}" />
        </UniformGrid>
      </Border>
    </StackPanel>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" Margin="18,0" />
    <Panel>
      <ScrollViewer>
        <StackPanel Margin="16,4,16,20" Spacing="10">
          <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ItemsControl Name="QuotationList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QuotationRow">
                <Button Classes="cardbtn" Command="{Binding $parent[ItemsControl].((vm:QuotationsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15" />
                    <Border Grid.Column="1" Classes="chip" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}">
                      <TextBlock Text="{Binding StatusText}" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Customer}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Total}" FontWeight="Bold" Margin="10,3,0,0" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="2" Classes="muted" FontSize="12" Text="{Binding When}" Margin="0,2,0,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Name="EmptyText" Classes="muted" Text="No quotations here" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding IsEmpty}" />
    </Panel>
  </DockPanel>
</UserControl>
