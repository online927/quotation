<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Modern look: control themes that change the shape of a control (not only its colours).
    Kept in the app resources so they replace the standard ones.
  -->

  <!-- Drop-down list rows: rounded, a soft tint under the mouse, the chosen one light blue with a tick -->
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Row" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Path Grid.Column="1" Name="PART_Tick" Data="M5,12 L10,17 L19,7" Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="10" Stretch="Uniform"
                  Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{TemplateBinding IsSelected}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource ListHoverBrush}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <!-- Number boxes: a small − on the left and + on the right (instead of ^ v arrows); typing still works -->
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
    <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource InputMinHeight}" />
    <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <RepeatButton Name="PART_DecreaseButton" Classes="spin" IsVisible="{TemplateBinding ShowButtonSpinner}"
                            IsTabStop="False" ToolTip.Tip="Less">
                <Path Data="M5,12 L19,12" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeLineCap="Round"
                      Width="10" Height="2" Stretch="Fill" />
              </RepeatButton>
              <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <RepeatButton Grid.Column="2" Name="PART_IncreaseButton" Classes="spin" IsVisible="{TemplateBinding ShowButtonSpinner}"
                            IsTabStop="False" ToolTip.Tip="More">
                <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeLineCap="Round"
                      Width="10" Height="10" Stretch="Fill" />
              </RepeatButton>
            </Grid>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#border">
      <Setter Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
