<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.QuotationListView"
             x:DataType="vm:QuotationListViewModel">
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Refresh (F5)" HotKey="F5" Command="{Binding LoadCommand}" />
        <Button Classes="primary" Content="New Quotation" Command="{Binding NewCommand}" />
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBox Name="SearchBox" Text="{Binding Query}" Watermark="Search quotation number, customer, GSTIN, product, reference…" />
      <TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Background="#E4E9F0" Padding="8,5">
      <Grid ColumnDefinitions="130,100,*,*,110,110,80,90,150">
        <TextBlock FontWeight="SemiBold" Text="Number" />
        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Date" />
        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Customer" />
        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Item" />
        <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Total" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Status" Margin="10,0,0,0" />
        <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Source" />
        <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="By" />
      </Grid>
    </Border>
    <ListBox Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:QuotationRow">
          <Grid ColumnDefinitions="130,100,*,*,110,110,80,90,150" Background="Transparent">
            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Date}" />
            <TextBlock Grid.Column="2" Text="{Binding Customer}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding Item}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
            <TextBlock Grid.Column="4" Text="{Binding Total}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Text="{Binding Status}" Margin="10,0,0,0" />
            <TextBlock Grid.Column="6" Text="{Binding Source}" />
            <TextBlock Grid.Column="7" Text="{Binding CreatedBy}" />
            <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
              <Button Content="Open" Padding="6,1" FontSize="11"
                      Command="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
              <Button Content="Duplicate" Padding="6,1" FontSize="11"
                      Command="{Binding $parent[UserControl].((vm:QuotationListViewModel)DataContext).DuplicateCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
