<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             x:Class="Quotation.Desktop.Views.TallyView"
             x:DataType="vm:TallyViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,12,24,24" Spacing="14" MaxWidth="980" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto">
        <ctl:PageTitle Text="Tally Connection" Icon="tally" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding LoadCommand}" HotKey="F5" ToolTip.Tip="Refresh (F5)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="M20,11 A8,8 0 1 0 17.7,16.6 M20,4 L20,11 L13,11" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
          <Button ctl:ButtonIcon.Kind="plug" Classes="primary" Content="Test connection (Ctrl+T)" Command="{Binding TestConnectionCommand}" HotKey="Ctrl+T" />
        </StackPanel>
      </Grid>
      <ctl:ErrorBanner Text="{Binding ErrorMessage}" />

      <Border Classes="card">
        <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Margin" Value="0,3" />
            </Style>
          </Grid.Styles>
          <TextBlock Classes="label" Text="Tally address" />
          <TextBlock Grid.Column="1" Text="{Binding TallyUrl}" />
          <TextBlock Grid.Row="1" Classes="label" Text="Tally connection" />
          <Border Grid.Row="1" Grid.Column="1" Name="TallyChip" Classes="chip" Classes.ok="{Binding IsConnected}" Classes.bad="{Binding !IsConnected}">
            <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding ConnectionText}" /></StackPanel>
          </Border>
          <TextBlock Grid.Row="2" Classes="label" Text="Company" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.TallyCompany, FallbackValue='–', TargetNullValue='–'}" />
          <TextBlock Grid.Row="3" Classes="label" Text="Active financial year" />
          <TextBlock Grid.Row="3" Grid.Column="1">
            <Run Text="{Binding Status.ActiveFinancialYear, FallbackValue='–', Mode=OneWay}" />
            <Run Text="{Binding Status.ActiveFinancialYearSource, StringFormat='  (source: {0})', FallbackValue='', Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
          </TextBlock>
          <TextBlock Grid.Row="4" Classes="label" Text="Last checked" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastCheckedText}" />
          <TextBlock Grid.Row="5" Classes="label" Text="Last synchronized" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastSyncText}" />
          <TextBlock Grid.Row="6" Classes="label" Text="Products" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Status.ProductCount, StringFormat='{}{0:N0}', FallbackValue='–'}" />
          <TextBlock Grid.Row="7" Classes="label" Text="Customers" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Status.CustomerCount, StringFormat='{}{0:N0}', FallbackValue='–'}" />
          <TextBlock Grid.Row="8" Classes="label" Text="Tally load" />
          <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Status.TallyLoadText, FallbackValue='–', TargetNullValue='–'}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="9" Classes="label" Text="Last error" VerticalAlignment="Top" />
          <TextBlock Grid.Row="9" Grid.Column="1" Classes="error" Text="{Binding Status.TallyError, FallbackValue=''}" />
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding TestResult, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="Connection test" />
          <TextBlock Text="{Binding TestResult.Message, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding TestResult.ActiveFinancialYear, StringFormat='Active financial year (from Tally period): {0}', FallbackValue=''}" />
          <TextBlock Classes="muted" Text="{Binding TestResult.PeriodFrom, StringFormat='Current period from: {0:dd-MMM-yyyy}', FallbackValue=''}" />
          <TextBlock Classes="muted" Text="Companies open in Tally:" />
          <ItemsControl ItemsSource="{Binding TestResult.LoadedCompanies, FallbackValue={x:Null}}" Margin="12,0,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Synchronization" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button ctl:ButtonIcon.Kind="sync" Content="Sync changes (F9)" HotKey="F9" Command="{Binding IncrementalSyncCommand}" IsEnabled="{Binding !SyncRunning}" />
              <Button ctl:ButtonIcon.Kind="db" Content="Full sync" Command="{Binding FullSyncCommand}" IsEnabled="{Binding !SyncRunning}" />
              <Button ctl:ButtonIcon.Kind="tag" Content="Read last rates" Command="{Binding ReadLastRatesCommand}" IsEnabled="{Binding !SyncRunning}" />
              <Button ctl:ButtonIcon.Kind="stop" Content="Stop" Command="{Binding StopLastRatesCommand}" IsVisible="{Binding SyncRunning}" />
            </StackPanel>
          </Grid>
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Name="AutoSyncLine" Text="{Binding AutoSyncText}" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Use 'Sync changes' (F9) right after editing items, prices or customers in Tally: it reads only what changed (Tally is only read, never changed). Anyone can use it."><Path Classes="infoicon" /></Border></StackPanel>
          <StackPanel Classes="help" Orientation="Horizontal" Spacing="6" ><TextBlock Text="Read last rates: only when &#x27;Also read last rates from Tally&#x27; is switched on in Settings → …" TextWrapping="Wrap" MaxWidth="640" VerticalAlignment="Center" /><Border Classes="info" ToolTip.Tip="Read last rates: only when 'Also read last rates from Tally' is switched on in Settings → Tally (off by default; the app then remembers the rates of its own approved quotations). It reads the rate each item was last quoted or sold at from Tally's Sales and Quotation vouchers (read-only). Started here it takes a few minutes and TallyPrime may respond a little slower meanwhile; Stop ends it at once."><Path Classes="infoicon" /></Border></StackPanel>
          <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          <!-- Round 39 (RD-1): the last syncs as a small table with a result chip -->
          <Border Classes="tablehead" Margin="0,4,0,0">
            <Grid ColumnDefinitions="150,90,90,*">
              <TextBlock Text="When" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Kind" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Result" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="Read" FontWeight="SemiBold" />
            </Grid>
          </Border>
          <ItemsControl Name="SyncRunsTable" ItemsSource="{Binding Runs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SyncRunRow">
                <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                  <Grid ColumnDefinitions="150,90,90,*">
                    <TextBlock Text="{Binding Started}" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12.5" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Classes="chip" Classes.ok="{Binding IsOk}" Classes.bad="{Binding IsFailed}" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal"><Ellipse /><TextBlock Text="{Binding Status}" /></StackPanel>
                    </Border>
                    <StackPanel Grid.Column="3">
                      <TextBlock Text="{Binding Changes}" FontSize="12.5" />
                      <TextBlock Text="{Binding Message}" FontSize="{DynamicResource FontSmall}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>



      <!-- Round 39 (RD-1): a checklist checked with every refresh -->
      <Border Classes="card" Name="DisconnectedChecklist">
        <StackPanel Spacing="2">
          <TextBlock Classes="h2" Text="🩺 If Tally is disconnected" />
          <Grid ColumnDefinitions="30,*" Margin="0,6,0,0">
            <Border Classes="chip" Classes.ok="{Binding TallyOpenOk}" Classes.bad="{Binding !TallyOpenOk}" Width="22" Height="22" Padding="0" CornerRadius="11"><TextBlock Text="{Binding TallyOpenMark}" HorizontalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="TallyPrime is running with the company open" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Text="On the PC set in Settings → Tally." /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="30,*" Margin="0,8,0,0">
            <Border Classes="chip" Classes.ok="{Binding PortOk}" Classes.bad="{Binding !PortOk}" Width="22" Height="22" Padding="0" CornerRadius="11"><TextBlock Text="{Binding PortMark}" HorizontalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Tally answers on port 9000" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap" Text="TallyPrime: F1 (Help) › Settings › Connectivity › Client/Server: 'TallyPrime acts as' = Both, Port = 9000." /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="30,*" Margin="0,8,0,0">
            <Border Classes="chip" Classes.ok="{Binding FirewallOk}" Classes.warn="{Binding !FirewallOk}" Width="22" Height="22" Padding="0" CornerRadius="11"><TextBlock Text="{Binding FirewallMark}" HorizontalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="Windows Firewall lets this server reach port 9000" /><TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap" Text="On the Tally PC allow inbound TCP 9000." /></StackPanel>
          </Grid>
          <TextBlock Classes="muted" FontSize="{DynamicResource FontSmall}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Meanwhile you can still search the data synced last time." />
        </StackPanel>
      </Border>

      <!-- Round 39 (RD-1): the raw Tally data tool stays, folded at the bottom -->
      <Border Classes="card" Name="RawDataCard" IsVisible="{Binding IsAdmin}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="🔬 Raw Tally data (for checking)" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Name="RawDataToggle" Classes="round" IsChecked="{Binding RawDataOpen}" Width="28" Height="28" Padding="0"
                          ToolTip.Tip="Open / fold">
              <Path Data="M6,9 L12,15 L18,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" Width="11" Stretch="Uniform"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ToggleButton>
          </Grid>
          <StackPanel Spacing="8" IsVisible="{Binding RawDataOpen}">
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Which fields Tally returns for one master (e.g. if HSN, GST or rates appear empty)." />
            <Grid ColumnDefinitions="140,8,*,8,Auto">
              <ComboBox ItemsSource="{Binding SampleTypes}" SelectedItem="{Binding SampleType}" HorizontalAlignment="Stretch" />
              <TextBox Grid.Column="2" Text="{Binding SampleName}" Watermark="Exact name as in Tally" />
              <Button ctl:ButtonIcon.Kind="download" Grid.Column="4" Content="Fetch" Command="{Binding LoadSampleCommand}" />
            </Grid>
            <TextBox Text="{Binding SampleXml}" IsReadOnly="True" FontFamily="Consolas,Menlo,monospace" FontSize="{DynamicResource FontSmall}" Height="220" AcceptsReturn="True"
                     IsVisible="{Binding SampleXml, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
