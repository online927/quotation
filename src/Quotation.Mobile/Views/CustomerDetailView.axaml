<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Mobile.ViewModels"
             xmlns:views="using:Quotation.Mobile.Views"
             xmlns:m="using:Quotation.Mobile"
             x:Class="Quotation.Mobile.Views.CustomerDetailView"
             x:DataType="vm:CustomerDetailViewModel">
  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,10" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Button.action TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Button.action Path">
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="12,12,18,8">
      <Button Name="BackButton" Classes="round" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).BackCommand}">
        <Path Classes="icon" Data="{x:Static m:PhoneIcons.Back}" />
      </Button>
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
        <TextBlock Name="CustomerTitle" Classes="h1" FontSize="21" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" />
      </StackPanel>
    </Grid>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" MinHeight="2" Margin="18,0" />
    <ScrollViewer>
      <StackPanel Margin="16,6,16,20" Spacing="12">
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Grid ColumnDefinitions="*,10,*,10,*">
          <Button Name="CallButton" Classes="action" Command="{Binding CallCommand}" IsEnabled="{Binding HasPhone}">
            <StackPanel><Path Data="{x:Static m:PhoneIcons.Phone}" Stroke="{DynamicResource AccentBrush}" /><TextBlock Text="Call" /></StackPanel>
          </Button>
          <Button Grid.Column="2" Name="ChatButton" Classes="action" Command="{Binding WhatsAppCommand}" IsEnabled="{Binding HasPhone}">
            <StackPanel><Path Data="{x:Static m:PhoneIcons.Chat}" Stroke="#25D366" /><TextBlock Text="WhatsApp" /></StackPanel>
          </Button>
          <Button Grid.Column="4" Name="MailButton" Classes="action" Command="{Binding EmailCommand}" IsEnabled="{Binding HasEmail}">
            <StackPanel><Path Data="{x:Static m:PhoneIcons.Mail}" Stroke="{DynamicResource AccentBrush}" /><TextBlock Text="E-mail" /></StackPanel>
          </Button>
        </Grid>

        <Border Classes="card">
          <ItemsControl Name="InfoList" ItemsSource="{Binding Info}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InfoRow">
                <Grid ColumnDefinitions="90,*" Margin="0,4">
                  <TextBlock Classes="label" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Classes="value" Text="{Binding Value}" IsVisible="{Binding IsText}" />
                  <Button Grid.Column="1" Classes="link" Content="{Binding Value}" IsVisible="{Binding IsLink}" FontWeight="SemiBold"
                          Command="{Binding $parent[ItemsControl].((vm:CustomerDetailViewModel)DataContext).TapCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Border Classes="card" IsVisible="{Binding HasQuotations}">
          <StackPanel>
            <TextBlock Classes="h2" Text="Quotations to this customer" Margin="0,0,0,6" />
            <ItemsControl Name="CustomerQuotations" ItemsSource="{Binding Quotations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuotationRow">
                  <Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,6" MinHeight="36"
                          Command="{Binding $parent[ItemsControl].((vm:CustomerDetailViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " />
                        <Run Text="{Binding DateText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Total}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
