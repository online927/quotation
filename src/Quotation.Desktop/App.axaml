<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Quotation.Desktop"
             x:Class="Quotation.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <!--
    Clean, light look in the spirit of apple.com: light grey page, white rounded cards with soft shadows,
    one blue accent, pill-shaped buttons, quiet hairlines instead of heavy borders.
  -->
  <Application.Resources>
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Inter, Helvetica Neue, Arial</FontFamily>

    <SolidColorBrush x:Key="PageBrush">#F5F5F7</SolidColorBrush>
    <SolidColorBrush x:Key="CardBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#1D1D1F</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#6E6E73</SolidColorBrush>
    <SolidColorBrush x:Key="HairlineBrush">#E5E5EA</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBorderBrush">#D2D2D7</SolidColorBrush>
    <SolidColorBrush x:Key="FillBrush">#EDEDF0</SolidColorBrush>
    <SolidColorBrush x:Key="SubtleFillBrush">#FAFAFC</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#0071E3</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoftBrush">#E8F1FD</SolidColorBrush>
    <SolidColorBrush x:Key="OkBrush">#248A3D</SolidColorBrush>
    <SolidColorBrush x:Key="WarnBrush">#B25000</SolidColorBrush>
    <SolidColorBrush x:Key="WarnSoftBrush">#FFF6E5</SolidColorBrush>
    <SolidColorBrush x:Key="WarnBorderBrush">#F5C26B</SolidColorBrush>
    <SolidColorBrush x:Key="BadBrush">#D70015</SolidColorBrush>
    <SolidColorBrush x:Key="EditingRowBrush">#FFF8E1</SolidColorBrush>
    <SolidColorBrush x:Key="GreenBrush">#248A3D</SolidColorBrush>
    <SolidColorBrush x:Key="PurpleBrush">#8944AB</SolidColorBrush>
    <SolidColorBrush x:Key="TealBrush">#0A8A8A</SolidColorBrush>
    <SolidColorBrush x:Key="OrangeBrush">#C93400</SolidColorBrush>

    <!-- Sidebar: dark navy (A). The light-blue variant (B) replaces these brushes. -->
    <SolidColorBrush x:Key="SidebarBrush">#1E2A3A</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarTextBrush">#E8EDF3</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarMutedBrush">#8D9BAD</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarHoverBrush">#2C3B4F</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarSelectedBrush">#0A84FF</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarSelectedTextBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBorderBrush">#1E2A3A</SolidColorBrush>

    <!-- Older names kept for screens that still use them. -->
    <SolidColorBrush x:Key="HeaderBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="NavBrush">#FBFBFD</SolidColorBrush>

    <!-- Fluent theme overrides -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <SolidColorBrush x:Key="ButtonBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#F2F2F5</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackgroundPressed">#E6E6EB</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled">#F2F2F4</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForeground">#1D1D1F</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver">#1D1D1F</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForegroundPressed">#1D1D1F</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonForegroundDisabled">#AEAEB2</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush">#C7C7CC</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver">#AEAEB2</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed">#AEAEB2</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled">#E5E5EA</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled">#F5F5F7</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrush">#D2D2D7</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#AEAEB2</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#0071E3</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled">#E5E5EA</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground">#8E8E93</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrush">#D2D2D7</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver">#AEAEB2</SolidColorBrush>
    <SolidColorBrush x:Key="CalendarDatePickerBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="CalendarDatePickerBorderBrush">#D2D2D7</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0071E3" RegionColor="#F5F5F7" BaseHigh="#1D1D1F" ErrorText="#D70015" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="Background" Value="{StaticResource PageBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- Typography -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000" />
    </Style>
    <Style Selector="Border.tablehead">
      <Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,1" />
      <Setter Property="CornerRadius" Value="12,12,0,0" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.tablehead TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{StaticResource FillBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Lists -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ListBox.table">
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,12,12" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="#F0F0F3" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F5F5F7" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DCEAFC" />
    </Style>

    <!-- Editor action bar: a thin line between button groups; grey shortcut keys inside buttons -->
    <Style Selector="Border.groupline">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#D1D1D6" />
    </Style>
    <Style Selector="Button TextBlock.key">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons: pill shaped; one blue primary action per screen -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="14,5" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="18,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0077ED" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0062C4" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A9CDF5" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Save / PDF: green -->
    <Style Selector="Button.save">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.save /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource GreenBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.save:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F7A35" />
      <Setter Property="BorderBrush" Value="#1F7A35" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.save:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A8D5B3" />
      <Setter Property="BorderBrush" Value="#A8D5B3" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- Proforma invoices: purple outline -->
    <Style Selector="Button.proforma /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PurpleBrush}" />
    </Style>
    <Style Selector="Button.proforma:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F6EEFA" />
      <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PurpleBrush}" />
    </Style>
    <!-- Delete / cancel: light red -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FDECEC" />
      <Setter Property="BorderBrush" Value="#F5B5B5" />
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FAD9D9" />
      <Setter Property="BorderBrush" Value="#EE9A9A" />
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FDF5F5" />
      <Setter Property="BorderBrush" Value="#F8DADA" />
      <Setter Property="Foreground" Value="#E8A3AA" />
    </Style>
    <!-- Text-only button (links, breadcrumbs) -->
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#0062C4" />
    </Style>
    <!-- Round chevron button (Back / Forward) -->
    <Style Selector="Button.round">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.round /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FillBrush}" />
    </Style>
    <Style Selector="Button.round:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Clickable stat tile (dashboard) -->
    <Style Selector="Button.tile">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="#B9D5F7" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="9,2" />
    </Style>

    <!-- Sidebar -->
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
    </Style>
    <Style Selector="Button.nav Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource SidebarMutedBrush}" />
    </Style>
    <Style Selector="Button.nav.selected Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource SidebarSelectedTextBrush}" />
    </Style>
    <Style Selector="Button.nav TextBlock.shortcut">
      <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
    </Style>
    <Style Selector="Button.nav.selected TextBlock.shortcut">
      <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.sidehead">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
    </Style>

    <!-- Status badges -->
    <Style Selector="Border.pill.ok">
      <Setter Property="Background" Value="#E3F4E8" />
    </Style>
    <Style Selector="Border.pill.ok TextBlock">
      <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
    </Style>
    <Style Selector="Border.pill.pending">
      <Setter Property="Background" Value="#FFF0E0" />
    </Style>
    <Style Selector="Border.pill.pending TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OrangeBrush}" />
    </Style>
    <Style Selector="Border.pill.bad">
      <Setter Property="Background" Value="#FDECEC" />
    </Style>
    <Style Selector="Border.pill.bad TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>

    <!-- Section headings with a coloured edge -->
    <Style Selector="Border.headbar">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.headbar.blue"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Style>
    <Style Selector="Border.headbar.teal"><Setter Property="BorderBrush" Value="{StaticResource TealBrush}" /></Style>
    <Style Selector="Border.headbar.purple"><Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" /></Style>
    <Style Selector="Border.headbar.green"><Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" /></Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Tabs: quieter, accent underline -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
  </Application.Styles>
</Application>
