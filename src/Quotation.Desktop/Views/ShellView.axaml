<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Quotation.Desktop.ViewModels"
             xmlns:svc="using:Quotation.Desktop.Services"
             xmlns:ctl="using:Quotation.Desktop.Controls"
             x:Class="Quotation.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="Button.xo.win"><Setter Property="Background" Value="#3322A447" /></Style>
    <Style Selector="Button.xo.win /template/ ContentPresenter"><Setter Property="Background" Value="#3322A447" /></Style>
    <!-- Rows of the number list under the top search box -->
    <Style Selector="Button.numbermatch">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.numbermatch /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.numbermatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.numbermatch.hi /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.numbermatch Border.badge">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    </Style>
    <Style Selector="Button.numbermatch Border.badge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.numbermatch.hi Border.badge">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.numbermatch.hi Border.badge TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.key">
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
    </Style>
    <Style Selector="Border.key TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <DockPanel>
      <!-- Top bar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,9">
        <Grid ColumnDefinitions="246,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
              <TextBlock Text="TS" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Quotations" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="{Binding Status.TallyCompany, FallbackValue=''}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="160" />
            </StackPanel>
          </StackPanel>
          <TextBox Grid.Column="1" Name="GlobalSearchBox" Text="{Binding GlobalSearch}" MaxWidth="520" HorizontalAlignment="Stretch" Margin="16,0"
                   CornerRadius="999" Padding="16,6" Background="{DynamicResource FillBrush}" BorderThickness="0"
                   Watermark="Search quotations"
                   ToolTip.Tip="Search quotations by number, customer, GSTIN, product, reference or date (Ctrl+F)">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <!-- Typing a quotation number: its quotation(s) below the box; Enter opens the highlighted one -->
          <Popup Name="NumberPopup" PlacementTarget="{Binding #GlobalSearchBox}" Placement="BottomEdgeAlignedLeft" VerticalOffset="6"
                 IsOpen="{Binding ShowNumberMatches, Mode=OneWay}" IsLightDismissEnabled="False"
                 Width="{Binding #GlobalSearchBox.Bounds.Width}">
            <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="8" BoxShadow="0 10 30 0 #33000000">
              <StackPanel Spacing="2">
                <TextBlock Text="OPEN" Classes="muted" FontSize="11" Margin="10,2,0,4" />
                <ItemsControl Name="NumberMatchList" ItemsSource="{Binding NumberMatches}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NumberMatchViewModel">
                      <Button Classes="numbermatch" Classes.hi="{Binding IsHighlighted}" Focusable="False" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" Padding="10,8"
                              Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).OpenNumberMatchCommand}" CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="badge" Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding YearNote}" Classes="muted" FontSize="11" IsVisible="{Binding HasYearNote}" VerticalAlignment="Center" />
                              <Border Classes="pill status" Classes.ok="{Binding IsFinal}" Classes.pending="{Binding IsPending}" Classes.bad="{Binding IsCancelled}"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="key" IsVisible="{Binding IsHighlighted}" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Enter" FontSize="11" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,4" />
                <Button Name="SearchAllButton" Classes="numbermatch" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="10,8" Command="{Binding SearchAllCommand}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="⌕" FontSize="20" Classes="muted" Margin="2,-4,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SearchAllText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="customer, GSTIN, part no. …" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
          </Popup>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- Status: green / orange / red dot; details when pointing at it or clicking -->
            <Button Name="StatusChip" Classes="link" Padding="8,4" Margin="0,0,4,0" ToolTip.Tip="{Binding HealthDetails}">
              <Border Background="{DynamicResource FillBrush}" CornerRadius="999" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="9" Height="9" Fill="{DynamicResource OkBrush}" IsVisible="{Binding HealthOk}" VerticalAlignment="Center" />
                  <Ellipse Width="9" Height="9" Fill="{DynamicResource WarnBrush}" IsVisible="{Binding HealthWarn}" VerticalAlignment="Center" />
                  <Ellipse Classes="pulse" Width="9" Height="9" Fill="{DynamicResource BadBrush}" IsVisible="{Binding HealthBad}" VerticalAlignment="Center" />
                  <TextBlock Name="StatusLabel" Text="{Binding HealthLabel}" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <TextBlock Name="StatusDetails" Text="{Binding HealthDetails}" FontSize="12" LineHeight="20" />
                </Flyout>
              </Button.Flyout>
            </Button>
            <!-- Light / dark mode for this user -->
            <Button Name="ThemeButton" Classes="round" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTip}">
              <Path Data="{Binding ThemeIcon}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"
                    StrokeLineCap="Round" StrokeJoin="Round" />
            </Button>
            <!-- Click the name: change my password, my settings, log out -->
            <Button Name="UserMenuButton" Classes="link" Padding="4,2" ToolTip.Tip="My account">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource FillBrush}">
                  <TextBlock Text="{Binding UserInitials}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding UserDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="{Binding UserRole, StringFormat='{}{0}  ▾'}" FontSize="11" Classes="muted" />
                </StackPanel>
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="Change my password" Command="{Binding ChangeMyPasswordCommand}" />
                  <MenuItem Header="My Settings" Command="{Binding NavigateCommand}" CommandParameter="mysettings" />
                  <Separator />
                  <MenuItem Header="Log out" Command="{Binding LogoutCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="link" Content="Log out" Command="{Binding LogoutCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Warning strip: only while something is wrong (server unreachable, Tally disconnected, old data, Tally busy) -->
      <Border DockPanel.Dock="Top" Name="WarningStrip" Classes="warnstrip" Padding="20,6" BorderThickness="0,0,0,1"
              Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}"
              IsVisible="{Binding VisibleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Data="M12,3 L22,20 L2,20 Z M12,9 L12,14 M12,17 L12,17.5" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" Text="{Binding VisibleWarning}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" Name="CloseWarningButton" Classes="link" Padding="6,2" Margin="12,0,0,0" Command="{Binding CloseWarningCommand}"
                  ToolTip.Tip="Close (the dot at the top stays red or orange until it is fixed)">
            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineCap="Round"
                  Width="11" Height="11" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <Border Name="Sidebar" Classes="sidebar" Classes.collapsed="{Binding SidebarCollapsed}" DockPanel.Dock="Left" ZIndex="10"
              Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
        <Panel>
        <!-- Pines at the foot of the menu (Parchment and Forest & Gold themes only) -->
        <Path Name="SidebarArt" Classes="sideart" Data="{x:Static ctl:ThemeArt.SidebarPines}" Fill="{DynamicResource SidebarArtBrush}"
              Stretch="Fill" Height="110" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <Path Classes="sideart" Data="{x:Static ctl:ThemeArt.SidebarCity}" Fill="{DynamicResource SidebarCityBrush}"
              Stretch="Fill" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <!-- Ocean, Midnight Stars: their small scene at the foot of the menu -->
        <Path Name="SideScene" Classes="sideart" Data="{DynamicResource SideArt}" Fill="{DynamicResource SideArtBrush}"
              Stretch="Fill" Height="120" VerticalAlignment="Bottom" IsHitTestVisible="False" />
        <DockPanel>
        <Button Name="SidebarToggle" DockPanel.Dock="Bottom" Classes="nav" Command="{Binding ToggleSidebarCommand}" Margin="10,4,10,10"
                ToolTip.Tip="{Binding SidebarToggleTip}">
          <Panel>
            <Grid Classes="navgrid" ColumnDefinitions="32,*">
              <Path Classes="icon" Data="{Binding SidebarToggleIcon}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding SidebarToggleText}" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Classes="navmini">
              <Path Classes="icon" Data="{Binding SidebarToggleIcon}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" />
            </StackPanel>
          </Panel>
        </Button>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding NavItems}" Margin="10,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel>
                  <Panel IsVisible="{Binding HasSection}">
                    <TextBlock Classes="sidehead" Text="{Binding Section}" Margin="12,14,0,4" />
                    <Border Classes="sidegap" Height="12" />
                  </Panel>
                  <Button Classes="nav" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).NavigateCommand}"
                          CommandParameter="{Binding Key}" ToolTip.Tip="{Binding Title}">
                    <Panel>
                    <StackPanel Classes="navmini">
                      <Path Classes="icon" Data="{Binding Icon}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform"
                            StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Grid Classes="navgrid" ColumnDefinitions="32,*,Auto" Width="216">
                      <Path Classes="icon" Data="{Binding Icon}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform"
                            StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" />
                    </Grid>
                    </Panel>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>

      <!-- The page area: your own background picture (My Settings, this PC), or the theme's drawn scenery -->
      <Panel>
        <Image Name="BackgroundPicture" Source="{Binding BackgroundPicture}" Stretch="UniformToFill" IsVisible="{Binding HasBackgroundPicture}"
               IsHitTestVisible="False" />
        <Border Background="{DynamicResource PictureScrimBrush}" IsVisible="{Binding HasBackgroundPicture}" IsHitTestVisible="False" />
        <Path Name="HeroRays" Data="{x:Static ctl:ThemeArt.LightRays}" Fill="{DynamicResource RaysBrush}" Stretch="Fill"
              IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False" />
        <Panel Name="HeroCity" Height="230" VerticalAlignment="Bottom" IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False">
          <Path Data="{x:Static ctl:ThemeArt.CityFar}" Fill="{DynamicResource CityFarBrush}" Stretch="Fill" />
          <Path Data="{x:Static ctl:ThemeArt.CityNear}" Fill="{DynamicResource CityNearBrush}" Stretch="Fill" Height="150" VerticalAlignment="Bottom" />
        </Panel>
        <!-- Ocean, Midnight Stars: sky, sun / moon, and two layers at the foot -->
        <Panel Name="ThemeScene" IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False">
          <Path Data="{DynamicResource SkyArt}" Fill="{DynamicResource SkyArtBrush}" Stretch="Fill" Height="600" VerticalAlignment="Top" />
          <Path Data="{DynamicResource SunArt}" Fill="{DynamicResource SunArtBrush}" Stretch="Uniform" Width="120" Height="120"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,170,0" />
          <Panel Height="200" VerticalAlignment="Bottom">
            <Path Data="{DynamicResource FarArt}" Fill="{DynamicResource FarArtBrush}" Stretch="Fill" />
            <Path Data="{DynamicResource NearArt}" Fill="{DynamicResource NearArtBrush}" Stretch="Fill" />
          </Panel>
        </Panel>
        <Panel Name="PageArt" Height="200" VerticalAlignment="Bottom" IsVisible="{Binding !HasBackgroundPicture}" IsHitTestVisible="False">
          <Path Data="{x:Static ctl:ThemeArt.FarMountains}" Fill="{DynamicResource PageArtFarBrush}" Stretch="Fill" />
          <Path Data="{x:Static ctl:ThemeArt.PineRidge}" Fill="{DynamicResource PageArtNearBrush}" Stretch="Fill" />
        </Panel>
        <DockPanel>
          <!-- Back / Forward and where you are -->
          <Border DockPanel.Dock="Top" Padding="20,10,20,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Name="BackButton" Classes="round" Content="‹" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{Binding BackToolTip}" />
              <Button Name="ForwardButton" Classes="round" Content="›" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}"
                      ToolTip.Tip="{Binding ForwardToolTip}" />
              <Button Name="HomeButton" Classes="link" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Dashboard"
                      Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                <Path Data="M3,11 L12,3 L21,11 M5,9.5 L5,20 L10,20 L10,14 L14,14 L14,20 L19,20 L19,9.5" Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
              </Button>
              <TextBlock Text="›" Classes="muted" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center" Margin="2,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:Crumb">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding IsCurrent}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TransitioningContentControl Classes="pages" Content="{Binding CurrentPage}" />
        </DockPanel>
      </Panel>
    </DockPanel>

    <!-- Short messages in the bottom-right corner ("Saved …", "PDF saved to …"); they fade after a few seconds -->
    <ItemsControl Name="ToastList" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,76">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="svc:ToastItem">
          <Border Classes="toast" Classes.leaving="{Binding IsLeaving}" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                  BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,0" BoxShadow="0 6 20 0 #26000000" MaxWidth="460">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="M5,12.5 L10,17.5 L19,7" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource OkBrush}" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
              </StackPanel>
              <Button Grid.Column="2" Classes="link" Margin="10,0,0,0" FontWeight="SemiBold" Content="{Binding ActionText}" IsVisible="{Binding HasAction}"
                      Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).ToastActionCommand}" CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The hidden XO game (Ctrl+Alt+Shift+X); Esc or ✕ closes it -->
    <Border Name="XoPanel" Background="#59000000" IsVisible="{Binding XoGame, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card" DataContext="{Binding XoGame}" x:DataType="vm:XoGameViewModel" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="20,16,20,20" BoxShadow="0 18 50 0 #4D000000" Background="{DynamicResource PopupBrush}" CornerRadius="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="XO" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Name="XoCloseButton" Grid.Column="1" Classes="round" Content="✕" ToolTip.Tip="Close (Esc)"
                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).CloseXoCommand}" />
          </Grid>
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding YouWins}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource ActionBrush}" />
              <TextBlock Text="You (X)" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Draws}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="Draw" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
              <TextBlock Text="{Binding ComputerWins}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E8590C" />
              <TextBlock Text="Computer (O)" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <ItemsControl Name="XoBoard" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3" Rows="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:XoCell">
                <Button Classes="xo" Classes.win="{Binding IsWin}" Height="96" Margin="4" HorizontalAlignment="Stretch" CornerRadius="10"
                        Background="{DynamicResource SubtleFillBrush}" BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].((vm:XoGameViewModel)DataContext).PlayCommand}" CommandParameter="{Binding}">
                  <Panel>
                    <TextBlock Text="X" IsVisible="{Binding IsX}" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource ActionBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="O" IsVisible="{Binding IsO}" FontSize="46" FontWeight="Bold" Foreground="#E8590C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Name="XoStatus" Text="{Binding Status}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="primary" Content="New game" Command="{Binding NewGameCommand}" />
            <Button Content="Reset score" Command="{Binding ResetScoreCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Greetings (administrator switch): a card in the middle for a moment; it never blocks a click -->
    <Border Name="GreetingPanel" Background="#33000000" IsVisible="{Binding Greeting, Converter={x:Static ObjectConverters.IsNotNull}}" IsHitTestVisible="False">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,24" MinWidth="320" BoxShadow="0 18 50 0 #40000000"
              Background="{DynamicResource PopupBrush}" CornerRadius="18">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Name="GreetingArabic" Text="{Binding Greeting.Arabic, FallbackValue=''}" FlowDirection="RightToLeft" HorizontalAlignment="Center"
                     FontFamily="Segoe UI, Noto Naskh Arabic, Arial, sans-serif" FontSize="30" Foreground="{DynamicResource OkBrush}" />
          <TextBlock Name="GreetingEnglish" Text="{Binding Greeting.English, FallbackValue=''}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="{Binding Greeting.Line, FallbackValue=''}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Unsaved changes: Save / Don't Save / Cancel -->
    <Border Name="PromptPanel" Background="#40000000" IsVisible="{Binding PendingPrompt, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" BoxShadow="0 12 40 0 #33000000"
              Background="{DynamicResource PopupBrush}">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding PendingPrompt.Heading, FallbackValue='Unsaved changes'}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PendingPrompt.Message, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Enter = Save · N = Don't Save · Esc = Cancel (stay on this page)" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
            <Button Name="PromptDontSave" Content="Don't Save" Command="{Binding AnswerPromptCommand}" CommandParameter="{x:Static svc:LeaveChoice.DontSave}" />
            <Button Grid.Column="2" Name="PromptCancel" Content="Cancel" Margin="0,0,8,0" Command="{Binding AnswerPromptCommand}" CommandParameter="{x:Static svc:LeaveChoice.Cancel}" />
            <Button Grid.Column="3" Name="PromptSave" Classes="primary" Content="Save" Command="{Binding AnswerPromptCommand}" CommandParameter="{x:Static svc:LeaveChoice.Save}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Yes/No questions and inputs (delete, restore, seal PIN …) -->
    <Border Name="DialogPanel" Background="#40000000" IsVisible="{Binding PendingDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" BoxShadow="0 12 40 0 #33000000"
              Background="{DynamicResource PopupBrush}">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding PendingDialog.Title, FallbackValue=''}" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PendingDialog.Message, FallbackValue=''}" TextWrapping="Wrap"
                     IsVisible="{Binding PendingDialog.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
          <StackPanel Spacing="4" IsVisible="{Binding PendingDialog.HasInput, FallbackValue=False}">
            <TextBlock Classes="label" Text="{Binding PendingDialog.InputLabel, FallbackValue=''}" />
            <TextBox Name="DialogInput" Text="{Binding PendingDialog.Input, FallbackValue=''}" PasswordChar="{Binding PendingDialog.SecretChar}" MaxLength="40" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Name="DialogSecondary" Content="{Binding PendingDialog.SecondaryText, FallbackValue=''}" Command="{Binding AnswerDialogCommand}">
              <Button.CommandParameter><x:Boolean>False</x:Boolean></Button.CommandParameter>
            </Button>
            <Button Name="DialogPrimary" Classes="primary" Content="{Binding PendingDialog.PrimaryText, FallbackValue=''}" Command="{Binding AnswerDialogCommand}">
              <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
