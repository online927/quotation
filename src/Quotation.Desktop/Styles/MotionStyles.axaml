<!--
  Animations (N1-N8). Short (0.15-0.25 s) and only when something changes. Removed as a whole when a user switches on
  "Reduce animations" in My Settings > Appearance.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Quotation.Desktop.Styles.MotionStyles">

  <!-- N1: the new page fades in -->
  <Style Selector="TransitioningContentControl.pages">
    <Setter Property="PageTransition">
      <CrossFade Duration="0:0:0.18" />
    </Setter>
  </Style>

  <!-- N2: corner messages slide in from the right and fade out -->
  <Style Selector="Border.toast">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.X" Value="36" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.X" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- N3: the warning strip slides down -->
  <Style Selector="Border.warnstrip[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- N4: buttons press in a little (not the sidebar options). Highlights (hover, selected) are not faded: a fade starts
       from see-through white and flashed before the real colour, so they simply appear. -->
  <Style Selector="Button:not(.nav)">
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:not(.nav):pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <!-- N5: folded sections open and close with a short slide -->
  <Style Selector="Border.fold[IsVisible=True], Grid.fold[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-6" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- N6: dropdowns, the calendar and pop-up menus fade in -->
  <Style Selector="Border.calcard, Border.dropdown, FlyoutPresenter, MenuFlyoutPresenter">
    <Style.Animations>
      <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-4" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- N7: the red "Disconnected" dot pulses gently -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- U7: loading placeholders shimmer gently -->
  <Style Selector="Border.skeleton">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- N8: a new item line fades in -->
  <Style Selector="Border.row">
    <Style.Animations>
      <Animation Duration="0:0:0.18" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
